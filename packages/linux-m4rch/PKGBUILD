# Sources are the locally built kernel and modules; see ../tools/prepare.py.
pkgname=linux-m4rch
pkgver=7.3.0
pkgrel=9
pkgdesc='Linux kernel for Apple Silicon'
arch=('aarch64')
url='https://github.com/aurora-silicon/linux'
license=('GPL-2.0-only')
depends=('coreutils' 'kmod' 'mkinitcpio')
provides=('linux')
conflicts=('linux-aurora-m4rch')
options=('!strip' '!debug' '!lto')
source=('Image' 'modules.tar.gz' 'linux-m4rch.preset' 'apple-j614s.dtb' 'kernel.config' 'kernel.patch' 'gpu-diagnostics.patch' 'aurora-vrr.patch' 'force-vrr.patch' 'wake-hpd.patch' 'wake-reapply.patch' 'external-display.patch' 'GPL-2.0')
# prepare.py appends checksums to the generated build directory.
package() {
  local modules=("$srcdir"/lib/modules/*)
  [[ ${#modules[@]} == 1 && ${modules[0]##*/} == 7.3.0-m4rch-vrr-ext ]]
  grep -aq 'Linux version 7.3.0-m4rch-vrr-ext ' "$srcdir/Image"
  install -d "$pkgdir/usr"
  cp -a --no-preserve=ownership "$srcdir/lib" "$pkgdir/usr/"
  rm -f "$pkgdir/usr/lib/modules/7.3.0-m4rch-vrr-ext/build"
  install -Dm644 "$srcdir/Image" "$pkgdir/usr/lib/modules/7.3.0-m4rch-vrr-ext/vmlinuz"
  echo "$pkgname" > "$pkgdir/usr/lib/modules/7.3.0-m4rch-vrr-ext/pkgbase"
  install -Dm644 "$srcdir/linux-m4rch.preset" "$pkgdir/etc/mkinitcpio.d/linux-m4rch.preset"
  install -Dm644 "$srcdir/apple-j614s.dtb" "$pkgdir/usr/lib/asahi-boot/apple-j614s.dtb"
  install -Dm644 "$srcdir/kernel.config" "$pkgdir/usr/share/doc/$pkgname/config"
  install -Dm644 "$srcdir/kernel.patch" "$pkgdir/usr/share/doc/$pkgname/kernel.patch"
  install -Dm644 "$srcdir/gpu-diagnostics.patch" "$pkgdir/usr/share/doc/$pkgname/gpu-diagnostics.patch"
  for patch in aurora-vrr.patch force-vrr.patch wake-hpd.patch wake-reapply.patch external-display.patch; do
    install -Dm644 "$srcdir/$patch" "$pkgdir/usr/share/doc/$pkgname/$patch"
  done
  install -Dm644 "$srcdir/GPL-2.0" "$pkgdir/usr/share/licenses/$pkgname/GPL-2.0"
}
