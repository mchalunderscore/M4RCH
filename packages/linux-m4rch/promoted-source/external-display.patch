+void dcp_fabric_hybrid_kick(struct apple_dcp *dcp, unsigned int delay_ms)
+{
+	if (dcp->fw_compat != DCP_FIRMWARE_V_26_6_DESKTOP)
+		return;
+	mod_delayed_work(system_freezable_wq, &dcp->hybrid_wq, msecs_to_jiffies(delay_ms));
