  * and held by the GPU (resident), held kernel objects, the limits that admit
  * user objects (0: none) and the number of refused creations.
  */
+/* Diagnostic-only: cumulative shrinker scan outcomes, in host pages. */
+static atomic64_t diag_scan_calls = ATOMIC64_INIT(0);
+static atomic64_t diag_scan_target = ATOMIC64_INIT(0);
+static atomic64_t diag_scan_released = ATOMIC64_INIT(0);
+
+void asahi_diag_record_reclaim(u64 target, u64 released)
+{
+	atomic64_inc(&diag_scan_calls);
+	atomic64_add(target, &diag_scan_target);
+	atomic64_add(released, &diag_scan_released);
+}
