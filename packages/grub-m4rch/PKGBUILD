# Derived from Arch Linux ARM core/grub at the revision in source.json.
# Maintainers of that recipe: Christian Hesse, Tobias Powalowski,
# Kevin Mihelich and Vasily Khoruzhick. See README.md for the local changes.
pkgname=grub-m4rch
epoch=2
pkgver=2.16
pkgrel=1.1
pkgdesc='GNU GRand Unified Bootloader (upstream ARM64 high-memory fix)'
arch=('aarch64')
url='https://gnu-grub.freedesktop.org/'
license=('GPL-3.0-or-later')
backup=('etc/default/grub' 'etc/grub.d/40_custom')
install=grub.install
conflicts=('grub' 'grub-common' 'grub-emu' 'grub-legacy')
replaces=('grub' 'grub-common' 'grub-emu')
provides=("grub=${epoch}:${pkgver}-${pkgrel}" 'grub-common' 'grub-emu')
depends=('device-mapper' 'gettext' 'sh' 'xz')
makedepends=('autogen' 'device-mapper' 'freetype2' 'fuse3' 'gettext' 'git'
             'help2man' 'libusb' 'python' 'rsync' 'sdl' 'texinfo' 'ttf-dejavu'
             'wget' 'xz')
optdepends=(
  'dosfstools: For grub-mkrescue FAT FS and EFI support'
  'efibootmgr: For grub-install EFI support'
  'freetype2: For grub-mkfont usage'
  'fuse3: For grub-mount usage'
  'libisoburn: Provides xorriso for generating grub rescue iso using grub-mkrescue'
  'libusb: For grub-emu USB support'
  'lzop: For grub-mkrescue LZO support'
  'mtools: For grub-mkrescue FAT FS support'
  'os-prober: To detect other OSes when generating grub.cfg in BIOS systems'
  'sdl: For grub-emu SDL support'
)
options=('!debug' '!lto')
_unifont_ver=17.0.05
source=(
  "https://gitlab.freedesktop.org/api/v4/projects/26558/packages/generic/source-assets/grub-${pkgver}/grub-${pkgver}.tar.xz"
  "https://ftp.gnu.org/gnu/unifont/unifont-${_unifont_ver}/unifont-${_unifont_ver}.bdf.gz"
  '0001-00_header-add-GRUB_COLOR_-variables.patch'
  '0002-10_linux-detect-archlinux-initramfs.patch'
  '0003-support-dropins-for-default-configuration.patch'
  '0004-10_linux-add-archlinuxarm-s-default-kernel-path.patch'
  '0005-arm64-restore-high-memory.patch'
  'grub.default'
  'grub.install'
  'sbat.csv'
  'source.json'
)
