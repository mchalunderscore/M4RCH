prepare() {
  cd "${srcdir}/grub-${pkgver}"
  local patchfile
  for patchfile in \
    0001-00_header-add-GRUB_COLOR_-variables.patch \
    0002-10_linux-detect-archlinux-initramfs.patch \
    0003-support-dropins-for-default-configuration.patch \
    0004-10_linux-add-archlinuxarm-s-default-kernel-path.patch; do
    # The older ALARM distribution hunks use patch's standard context fuzz.
    patch --batch --forward --fuzz=2 -Np1 -i "${srcdir}/${patchfile}"
  done
  patch --batch --forward --fuzz=0 -Np1 \
    -i "${srcdir}/0005-arm64-restore-high-memory.patch"
  grep -Fxq '#define GRUB_EFI_MAX_USABLE_ADDRESS 0xffffffffffffULL' \
    include/grub/arm64/efi/memory.h

  # The release archive includes generated configure and gnulib. Patch the
  # generated font search instead of bootstrapping from a mutable checkout.
  sed -i 's|/usr/share/fonts/dejavu |/usr/share/fonts/dejavu /usr/share/fonts/TTF |g' configure
  sed -i 's| ro | rw |g' util/grub.d/10_linux.in
  sed -i 's|GNU/Linux|Linux|' util/grub.d/10_linux.in
  gzip -cd "${srcdir}/unifont-${_unifont_ver}.bdf.gz" > unifont.bdf
  sed -i '1i /^PO-Revision-Date:/ d' po/*.sed
}

build() {
  cd "${srcdir}/grub-${pkgver}"
  # Match the ALARM recipe's native AArch64 build and configuration flags.
  unset CFLAGS
  ./configure PACKAGE_VERSION="${pkgname}-${pkgver}" \
    --prefix=/usr --bindir=/usr/bin --sbindir=/usr/bin \
    --mandir=/usr/share/man --infodir=/usr/share/info \
    --datarootdir=/usr/share --sysconfdir=/etc --program-prefix= \
    --with-bootdir=boot --with-grubdir=grub \
    --enable-boot-time --enable-cache-stats \
    --with-platform=efi --target=aarch64
  # ALARM builds translations/docs only for its x86_64 variant.
  sed -i 's#po docs##' Makefile
  make
}

check() {
  cd "${srcdir}/grub-${pkgver}"
  grep -Fxq '#define GRUB_EFI_MAX_USABLE_ADDRESS 0xffffffffffffULL' \
    include/grub/arm64/efi/memory.h
  ./grub-mkstandalone --version
  ./grub-mkimage -O arm64-efi -d grub-core -p /boot/grub \
    -o "${srcdir}/grub-aarch64-check.efi" normal
  test -s "${srcdir}/grub-aarch64-check.efi"
}

package() {
  cd "${srcdir}/grub-${pkgver}"
  make DESTDIR="${pkgdir}/" \
    bashcompletiondir=/usr/share/bash-completion/completions install
  # Retain kernel.exec so the builder can audit the compiled address ceiling.
  rm -f "${pkgdir}/usr/lib/grub/arm64-efi/"{*.module,*.image,gdb_grub,gmodule.pl}
  install -Dm644 "${srcdir}/grub.default" "${pkgdir}/etc/default/grub"
  sed "s/%PKGVER%/${epoch}:${pkgver}-${pkgrel}/" "${srcdir}/sbat.csv" \
    > "${pkgdir}/usr/share/grub/sbat.csv"
  install -Dm644 "${srcdir}/source.json" \
    "${pkgdir}/usr/share/doc/grub-m4rch/build-source.json"
  install -Dm644 "${srcdir}/0005-arm64-restore-high-memory.patch" \
    "${pkgdir}/usr/share/doc/grub-m4rch/0005-arm64-restore-high-memory.patch"
}
