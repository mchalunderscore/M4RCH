+/* Capture one rejected native command stream per process. No GPU memory is read. */
+static bool
+agx_write_failure_data(int fd, const void *data, size_t size)
+{
+   const uint8_t *bytes = data;
+   while (size) {
+      ssize_t n = write(fd, bytes, size);
+      if (n < 0 && errno == EINTR)
+         continue;
+      if (n <= 0)
+         return false;
+      bytes += n;
+      size -= n;
+   }
+   return true;
+}
+
+static void
+agx_capture_submit_failure(struct agx_device *dev,
+                           const struct drm_asahi_submit *submit, int error)
+{
+   static int captured;
+   if (p_atomic_cmpxchg(&captured, 0, 1) != 0)
+      return;
+
+   fprintf(stderr, "asahi: rejected native submit pid=%ld fd=%d queue=%u "
+           "errno=%d flags=0x%x bytes=%u syncs=%u/%u\n",
+           (long)getpid(), dev->fd, submit->queue_id, error, submit->flags,
+           submit->cmdbuf_size, submit->in_sync_count, submit->out_sync_count);
+   /* Bound disk usage and command walking even for an invalid request. */
+   if (!submit->cmdbuf_size || submit->cmdbuf_size > 1024 * 1024)
+      return;
+
+   const uint8_t *bytes = (const void *)(uintptr_t)submit->cmdbuf;
+   size_t offset = 0;
+   for (unsigned i = 0; i < 64 && submit->cmdbuf_size - offset >=
+        sizeof(struct drm_asahi_cmd_header); ++i) {
+      struct drm_asahi_cmd_header command;
+      memcpy(&command, bytes + offset, sizeof(command));
+      fprintf(stderr, "asahi: rejected stream command=%u offset=%zu type=%u "
+              "size=%u barriers=%u/%u\n", i, offset, command.cmd_type,
+              command.size, command.vdm_barrier, command.cdm_barrier);
+      if (command.size > submit->cmdbuf_size - offset - sizeof(command))
+         break;
+      offset += sizeof(command) + command.size;
+   }
+
+   char directory[PATH_MAX], path[PATH_MAX];
+   const char *state = getenv("XDG_STATE_HOME");
+   int length;
+   if (state && state[0] == '/') {
+      length = snprintf(directory, sizeof(directory), "%s", state);
+   } else {
+      const char *home = getenv("HOME");
+      if (!home || home[0] != '/')
+         return;
+      length = snprintf(directory, sizeof(directory), "%s/.local/state", home);
+   }
+   if (length < 0 || (size_t)length >= sizeof(directory))
+      return;
+   if (mkdir(directory, 0700) && errno != EEXIST)
+      return;
+   /* PIDs are reused across desktop sessions and reboots. Preserve existing
+    * captures and retry a bounded set of names on collision. */
+   int fd = -1;
+   for (unsigned attempt = 0; attempt < 10000; ++attempt) {
+      length = snprintf(path, sizeof(path), "%s/asahi-submit-%ld-fd%d-q%u-%u.bin",
+                        directory, (long)getpid(), dev->fd, submit->queue_id, attempt);
+      if (length < 0 || (size_t)length >= sizeof(path))
+         return;
+      fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+      if (fd >= 0 || errno != EEXIST)
+         break;
+   }
+   if (fd < 0) {
+      fprintf(stderr, "asahi: submit capture could not create %s: %s\n",
+              path, strerror(errno));
+      return;
+   }
+   /* Little-endian u32 header, followed by the exact command-stream bytes.
+    * magic=AGXF, version, header bytes, pid, fd, queue, errno, flags,
+    * command bytes, input sync count, output sync count, reserved.
+    */
+   uint32_t header[12] = {0x46584741, 1, sizeof(header), (uint32_t)getpid(),
+      (uint32_t)dev->fd, submit->queue_id, error, submit->flags,
+      submit->cmdbuf_size, submit->in_sync_count, submit->out_sync_count, 0};
+   bool ok = agx_write_failure_data(fd, header, sizeof(header)) &&
+             agx_write_failure_data(fd, bytes, submit->cmdbuf_size);
+   if (ok)
+      ok = fsync(fd) == 0;
+   if (close(fd))
+      ok = false;
+   if (!ok) {
+      unlink(path);
+      fprintf(stderr, "asahi: submit capture failed\n");
+   } else {
+      fprintf(stderr, "asahi: rejected submit captured at %s\n", path);
+   }
+}
+
 static int
 agx_submit(struct agx_device *dev, struct drm_asahi_submit *submit,
            struct agx_submit_virt *virt)
 {
-   return drmIoctl(dev->fd, DRM_IOCTL_ASAHI_SUBMIT, submit);
+   int ret = drmIoctl(dev->fd, DRM_IOCTL_ASAHI_SUBMIT, submit);
+   int saved_errno = errno;
+   if (ret && saved_errno == EINVAL)
+      agx_capture_submit_failure(dev, submit, saved_errno);
+   errno = saved_errno;
+   return ret;
 }
 
