+/* GET_PARAMS contains a userspace pointer; never forward it as a flat ioctl.
+ * Group 0/queue limits are output-only. VM status also carries a VM id in.
+ */
+static int
+agx_virtio_query_params(struct agx_device *dev, struct drm_asahi_get_params *params)
+{
+   if (params->param_group && dev->vdrm->caps.wire_format_version < 3)
+      return -EOPNOTSUPP;
+
+   size_t input_size = 0;
+   switch (params->param_group) {
+   case 0:
+      if (params->size > sizeof(struct drm_asahi_params_global))
+         return -EINVAL;
+      break;
+   case DRM_ASAHI_PARAM_GROUP_QUEUE_LIMITS:
+      if (params->size != sizeof(struct drm_asahi_queue_limits))
+         return -EINVAL;
+      break;
+   case DRM_ASAHI_PARAM_GROUP_VM_STATUS:
+      if (params->size != sizeof(struct drm_asahi_vm_status))
+         return -EINVAL;
+      input_size = params->size;
+      break;
+   default:
+      return -EOPNOTSUPP;
+   }
+
+   size_t len = sizeof(struct asahi_ccmd_get_params_req) + input_size;
+   uint8_t buf[len];
+   memset(buf, 0, len);
+   struct asahi_ccmd_get_params_req *req = (void *)buf;
+   req->hdr = ASAHI_CCMD(GET_PARAMS, len);
+   req->params = *params;
+   req->params.pointer = 0;
+   if (input_size)
+      memcpy(buf + sizeof(*req), (void *)(uintptr_t)params->pointer, input_size);
+   struct asahi_ccmd_get_params_rsp *rsp = vdrm_alloc_rsp(
+      dev->vdrm, &req->hdr, sizeof(*rsp) + params->size);
+   int ret = vdrm_send_req(dev->vdrm, &req->hdr, true);
+   if (ret || rsp->ret)
+      return ret ? ret : rsp->ret;
+   memcpy((void *)(uintptr_t)params->pointer, rsp->payload, params->size);
+   return 0;
+}
 
