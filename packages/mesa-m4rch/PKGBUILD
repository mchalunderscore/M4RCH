pkgname=mesa-m4rch
pkgver=26.3.0.r20261026.f2c9dc3
pkgrel=1
epoch=1
pkgdesc='Mesa graphics drivers for Apple Silicon'
arch=('aarch64')
url='https://github.com/aurora-silicon/mesa'
license=('MIT' 'BSD-3-Clause' 'SGI-B-2.0')
depends=('glibc' 'libdrm' 'libglvnd' 'libelf' 'libx11' 'libxcb' 'libxext' 'libxshmfence' 'libxxf86vm' 'llvm-libs' 'libLLVM.so' 'expat' 'zlib' 'zstd' 'wayland' 'systemd-libs' 'vulkan-icd-loader' 'xcb-util-keysyms')
makedepends=('base-devel' 'meson' 'ninja' 'python-mako' 'python-yaml' 'python-packaging' 'python-ply' 'python-jinja' 'llvm' 'clang' 'libclc' 'spirv-tools' 'spirv-llvm-translator' 'vulkan-headers' 'wayland-protocols' 'glslang')
provides=("mesa=1:${pkgver}" "mesa-libgl=1:${pkgver}" 'opengl-driver' 'vulkan-driver' 'vulkan-asahi')
conflicts=('mesa' 'vulkan-asahi' 'mesa-aurora-m4rch')
options=('!lto' '!debug')
source=('mesa-source.tar.gz::https://codeload.github.com/aurora-silicon/mesa/tar.gz/f2c9dc3fb59c81fdaf51f19884175c856e3d1889')
sha256sums=('fc377579824a6f0e97947492009ba16f8173898a6966b83f906b5e5781e8e7c2')
build() {
  cd "$srcdir/mesa-f2c9dc3fb59c81fdaf51f19884175c856e3d1889"
  meson setup --reconfigure build --prefix=/usr --libdir=lib --sysconfdir=/etc --buildtype=release \
    -Dgallium-drivers=asahi,zink,llvmpipe,softpipe -Dvulkan-drivers=asahi \
    -Dplatforms=x11,wayland -Dglx=dri -Dglvnd=enabled -Degl=enabled -Dgbm=enabled \
    -Dllvm=enabled -Dshared-llvm=enabled -Dvideo-codecs=[] -Dgallium-va=disabled \
    -Dfreedreno-kmds=[] -Dtools=[]
  ninja -C build -j8
}
package() {
  cd "$srcdir/mesa-f2c9dc3fb59c81fdaf51f19884175c856e3d1889"
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 docs/license.rst "$pkgdir/usr/share/licenses/$pkgname/license.rst"
}
