pkgname=dozor-sudo-m4rch
pkgver=20261101
pkgrel=1
pkgdesc='Dozor-inspired sudo to polkit bridge for Noctalia'
arch=('aarch64')
license=('GPL-3.0-or-later')
depends=('polkit' 'sudo' 'coreutils')
source=('dozor-sudo.c' 'ru.toxblh.dozor.policy' 'LICENSE')
sha256sums=('1fd4c17e50bf80be0538c04ec84efd087c03efeeffc97afac064d404a5fc15c2'
            'e36af2424d266d2c5db72de2455db4b3e338e707dbb4762f2bcd24553c94e7c5'
            '3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986')

build() {
  gcc -static -O2 -Wall -Wextra -Werror -o dozor-sudo dozor-sudo.c
}

package() {
  install -Dm755 dozor-sudo "$pkgdir/usr/libexec/dozor-sudo-m4rch"
  install -Dm644 ru.toxblh.dozor.policy "$pkgdir/usr/share/polkit-1/actions/ru.toxblh.dozor.policy"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
