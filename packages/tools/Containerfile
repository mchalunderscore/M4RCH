FROM debian:trixie-slim AS fetch
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ca-certificates curl gnupg
COPY archlinuxarm-builder.asc /tmp/builder.asc
RUN curl --fail --location --retry 3 https://ca.us.mirror.archlinuxarm.org/os/multi/ArchLinuxARM-2026.08-aarch64-rootfs.tar.gz -o /tmp/rootfs.tar.gz && \
    curl --fail --location --retry 3 https://ca.us.mirror.archlinuxarm.org/os/multi/ArchLinuxARM-2026.08-aarch64-rootfs.tar.gz.sig -o /tmp/rootfs.sig && \
    echo '42a4eeaa038994ffd31fa173256ef2f0ef511358eeb41b9ea1f8626391b9b319  /tmp/rootfs.tar.gz' | sha256sum -c - && \
    echo '0157d8cd6261c85205931c766b754d6d56112b28800666fb64add1de192ebe11  /tmp/rootfs.sig' | sha256sum -c - && \
    gpg --batch --import /tmp/builder.asc && gpg --batch --verify /tmp/rootfs.sig /tmp/rootfs.tar.gz && \
    mkdir /archroot && tar -xpf /tmp/rootfs.tar.gz -C /archroot
FROM scratch
COPY --from=fetch /archroot/ /
CMD ["/usr/bin/sleep", "infinity"]
