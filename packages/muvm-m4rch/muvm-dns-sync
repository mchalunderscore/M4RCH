#!/bin/sh
# Executed as guest root before network configuration. A single background
# worker keeps the bind-mounted resolver and any /run-based link in step with
# the host, even if NetworkManager replaces /etc/resolv.conf after VM boot.
(
    flock -n 9 || exit 0
    proxy_pid=
    trap '[ -z "$proxy_pid" ] || kill "$proxy_pid" 2>/dev/null; rm -f /run/muvm-dns-proxy.ready; exit 0' HUP INT TERM
    while :; do
        if [ -n "${MUVM_DNS_HOST_UID:-}" ] && { [ -z "$proxy_pid" ] || ! kill -0 "$proxy_pid" 2>/dev/null; }; then
            rm -f /run/muvm-dns-proxy.ready
            /usr/bin/python3 /usr/lib/muvm/muvm-dns-proxy.py 9>&- &
            proxy_pid=$!
        fi
        host=/run/muvm-host
        link=$(readlink "$host/etc/resolv.conf" 2>/dev/null || :)
        case "$link" in
            /*) source="$host$link" ;;
            '') source="$host/etc/resolv.conf" ;;
            *) source="$host/etc/$link" ;;
        esac
        # NetworkManager's no-stub file supplies real upstreams when the host
        # uses a loopback stub, which is not reachable at guest loopback.
        if grep -Eq '^[[:space:]]*nameserver[[:space:]]+(127\.|::1([[:space:]]|$))' "$source" 2>/dev/null; then
            [ ! -r "$host/run/NetworkManager/no-stub-resolv.conf" ] || source="$host/run/NetworkManager/no-stub-resolv.conf"
        fi
        tmp=/run/muvm-dns-sync.tmp
        if [ -r "$source" ]; then
            # Host interface-scoped IPv6 addresses and loopback addresses have
            # no meaning in the guest. Keep search/options and usable servers.
            awk '$1 != "nameserver" || ($2 !~ /^127\./ && $2 != "::1" && $2 !~ /%/)' "$source" > "$tmp"
        else
            : > "$tmp"
        fi
        if [ -n "$proxy_pid" ] && kill -0 "$proxy_pid" 2>/dev/null && [ -f /run/muvm-dns-proxy.ready ]; then
            awk '$1 != "nameserver"' "$tmp" > "$tmp.proxy"
            printf 'nameserver 127.0.0.1\n' >> "$tmp.proxy"
            cat "$tmp.proxy" > "$tmp"
        fi
        if ! cmp -s "$tmp" /run/resolv.conf; then
            # Do not rename: existing Steam containers bind this inode.
            cat "$tmp" > /run/resolv.conf
        fi
        # Host replacement of /etc/resolv.conf can expose an absolute /run
        # symlink in the guest after the original bind mount was established.
        # Only create files below the guest's private /run filesystem.
        guestlink=$(readlink /etc/resolv.conf 2>/dev/null || :)
        case "$guestlink" in
            /run/*)
                case "$guestlink" in *..*) ;; *)
                    mkdir -p "${guestlink%/*}"
                    if [ "$guestlink" != /run/resolv.conf ] && ! cmp -s "$tmp" "$guestlink"; then
                        cat "$tmp" > "$guestlink"
                    fi
                ;; esac
                ;;
        esac
        sleep 2 9>&-
    done
) 9>/run/muvm-dns-sync.lock </dev/null >/dev/null 2>&1 &
exit 0
