pkgname=muvm-m4rch
pkgver=0.7.0
pkgrel=7
pkgdesc='Run programs from the host system in a microVM'
arch=('aarch64')
url='https://github.com/AsahiLinux/muvm'
license=('MIT')
depends=('glibc' 'gcc-libs' 'libkrun' 'virglrenderer-m4rch>=1.3.0-3' 'libkrunfw' 'passt' 'socat' 'systemd' 'libxkbcommon' 'coreutils' 'diffutils' 'gawk' 'grep' 'util-linux' 'python')
makedepends=('rust' 'cargo' 'clang' 'pkgconf')
provides=('muvm')
conflicts=('muvm')
options=('!lto' '!debug')
source=('muvm-source.tar.gz' 'muvm-wrapper' 'muvm-dns-sync' 'muvm-dns-forward.py' 'muvm-dns-proxy.py' 'muvm-dns-forward.service')
build() {
  cd "$srcdir/muvm"
  cargo build --release --locked -j3
}
package() {
  cd "$srcdir/muvm"
  install -Dm755 target/release/muvm "$pkgdir/usr/lib/muvm/muvm-real"
  install -Dm755 "$srcdir/muvm-wrapper" "$pkgdir/usr/bin/muvm"
  install -Dm755 "$srcdir/muvm-dns-sync" "$pkgdir/usr/lib/muvm/muvm-dns-sync"
  install -Dm755 "$srcdir/muvm-dns-forward.py" "$pkgdir/usr/lib/muvm/muvm-dns-forward.py"
  install -Dm755 "$srcdir/muvm-dns-proxy.py" "$pkgdir/usr/lib/muvm/muvm-dns-proxy.py"
  install -Dm644 "$srcdir/muvm-dns-forward.service" "$pkgdir/usr/lib/systemd/user/muvm-dns-forward.service"
  install -Dm755 target/release/muvm-guest "$pkgdir/usr/bin/muvm-guest"
  install -Dm644 share/wireplumber/wireplumber.conf.d/50-muvm-access.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-muvm-access.conf"
  install -Dm644 share/wireplumber/scripts/client/access-muvm.lua \
    "$pkgdir/usr/share/wireplumber/scripts/client/access-muvm.lua"
}
