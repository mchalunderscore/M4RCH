--- a/drivers/soc/apple/display-gate.c
+++ b/drivers/soc/apple/display-gate.c
@@ -2638,11 +2638,24 @@
 	staged_info("routes enabled, waiting for the PMP\n");
 }
 
+/* Diagnostic opt-out for the unqualified J614s external-display path. */
+static bool gate_j614s_internal_only __initdata;
+
+static int __init gate_j614s_internal_only_setup(char *arg)
+{
+	return kstrtobool(arg, &gate_j614s_internal_only);
+}
+early_param("apple_t6041_display.j614s_internal_only", gate_j614s_internal_only_setup);
+
 static void __init gate_t6041_run(void)
 {
 	if (IS_ENABLED(CONFIG_VIDEO) && video_firmware_drivers_only())
 		return;
 	gate_t6041_internal();
+	if (gate_j614s_internal_only && of_machine_is_compatible("apple,j614s")) {
+		gate_info("J614s diagnostic: external display staging disabled\n");
+		return;
+	}
 	gate_t6041_staged();
 }
 
