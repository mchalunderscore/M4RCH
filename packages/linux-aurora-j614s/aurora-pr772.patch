From 3fa56dc04b8b31a63b210fc7dc4320f4ace53ba8 Mon Sep 17 00:00:00 2001
From: Eryk Wieliczko <eryk@wieliczko.ninja>
Date: Sun, 25 Oct 2026 16:33:14 +0100
Subject: [PATCH 1/4] drm/gpuvm: initialize BO unmap result

Return success when a VM BO has no mappings instead of returning an
uninitialized stack value. Deferred-close cleanup can reach this case;
a garbage error return marks cleanup failed and blocks the VM.

Signed-off-by: Eryk Wieliczko <eryk@wieliczko.ninja>
(cherry picked from commit 2151a3442ee9e60f096ee1c6b7770fcd5ba1e879)
Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
---
 drivers/gpu/drm/drm_gpuvm.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/drm_gpuvm.c b/drivers/gpu/drm/drm_gpuvm.c
index b6aa52428a4e64..3b4f9c5e502210 100644
--- a/drivers/gpu/drm/drm_gpuvm.c
+++ b/drivers/gpu/drm/drm_gpuvm.c
@@ -3258,7 +3258,7 @@ drm_gpuvm_bo_unmap(struct drm_gpuvm_bo *vm_bo, void *priv)
 {
 	struct drm_gpuva_ops *ops;
 	struct drm_gpuva_op *op;
-	int ret;
+	int ret = 0;
 
 	if (unlikely(!vm_bo->vm))
 		return -EINVAL;

From 6b00531a31e719ed7db1d63871fc8a3f47ee3b00 Mon Sep 17 00:00:00 2001
From: Eryk Wieliczko <eryk@wieliczko.ninja>
Date: Sun, 25 Oct 2026 14:49:13 +0100
Subject: [PATCH 2/4] rust: drm: gpuvm: add filtered object unmap

Allow immediate-mode drivers to remove selected mappings of one GEM
without allocating an operation list.

Signed-off-by: Eryk Wieliczko <eryk@wieliczko.ninja>
(cherry picked from commit a8f459d96480e49bc2ae3ee0f9a78e18d9f6389c)
Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
---
 rust/kernel/drm/gpuvm/mod.rs | 26 ++++++++++++++++++++++----
 1 file changed, 22 insertions(+), 4 deletions(-)

diff --git a/rust/kernel/drm/gpuvm/mod.rs b/rust/kernel/drm/gpuvm/mod.rs
index 146f3c9ed8362e..6c4d24e759b5a0 100644
--- a/rust/kernel/drm/gpuvm/mod.rs
+++ b/rust/kernel/drm/gpuvm/mod.rs
@@ -688,24 +688,38 @@ impl<T: DriverGpuVm> GpuVmInnerGuard<'_, T> {
     /// node or operation list is allocated. Call [`GpuVm::deferred_cleanup`] after releasing this
     /// guard, including when a callback failed after earlier mappings were removed.
     pub fn unmap_all(&mut self, unmap: impl FnMut(&mut T, &GpuVa<T>) -> Result) -> Result {
-        self.unmap_matching(None, unmap)
+        self.unmap_matching(None, |_| true, unmap)
     }
 
     /// Allocation-free whole-node removal for one GEM object in an immediate-mode VM.
     ///
     /// Uses the same translation-removal and deferred-put contract as [`Self::unmap_all`]. This
-    /// scans the VM list and is intended as a low-memory cleanup fallback.
+    /// scans the VM list and can be used when the per-object operation list is unavailable.
     pub fn unmap_object(
         &mut self,
         object: &T::Object,
         unmap: impl FnMut(&mut T, &GpuVa<T>) -> Result,
     ) -> Result {
-        self.unmap_matching(Some(object), unmap)
+        self.unmap_object_where(object, |_| true, unmap)
+    }
+
+    /// Remove only mappings of an object selected by `matches`, without allocating.
+    ///
+    /// This scans the whole VM and uses the same translation-removal and deferred-put contract as
+    /// [`Self::unmap_all`]. If a callback fails, mappings already visited remain removed.
+    pub fn unmap_object_where(
+        &mut self,
+        object: &T::Object,
+        matches: impl FnMut(&GpuVa<T>) -> bool,
+        unmap: impl FnMut(&mut T, &GpuVa<T>) -> Result,
+    ) -> Result {
+        self.unmap_matching(Some(object), matches, unmap)
     }
 
     fn unmap_matching(
         &mut self,
         object: Option<&T::Object>,
+        mut matches: impl FnMut(&GpuVa<T>) -> bool,
         mut unmap: impl FnMut(&mut T, &GpuVa<T>) -> Result,
     ) -> Result {
         let vm = self.gpuvm.as_raw();
@@ -729,7 +743,11 @@ impl<T: DriverGpuVm> GpuVmInnerGuard<'_, T> {
                 if object.is_some_and(|object| (*va).gem.obj != object.as_raw()) {
                     continue;
                 }
-                unmap(&mut *self.gpuvm.data.get(), GpuVa::<T>::from_raw(va))?;
+                let typed_va = GpuVa::<T>::from_raw(va);
+                if !matches(typed_va) {
+                    continue;
+                }
+                unmap(&mut *self.gpuvm.data.get(), typed_va)?;
                 // Remove it as `OpUnmap::remove()` does.
                 let op = bindings::drm_gpuva_op_unmap { va, keep: false };
                 bindings::drm_gpuva_unmap(&op);

From bbe1524be50115e6842668b9f704d1841b7e7efa Mon Sep 17 00:00:00 2001
From: Eryk Wieliczko <eryk@wieliczko.ninja>
Date: Sun, 25 Oct 2026 16:33:14 +0100
Subject: [PATCH 3/4] drm/asahi: keep new bindings after deferred GEM close

A dma-buf reimport can return the same GEM while cleanup for a closed
handle is queued. Stamp each binding and remove only mappings covered by
the close-time sequence, preserving later maps instead of unmapping them.

Keep the indexed BO path when no newer binding exists. A map step that
takes its sequence after the close snapshot survives deferred cleanup.

[ryan: the VmBoData initialisers follow our SG lease and
prepare_sgt_segments() setup; drop_mappings_before() gains the SAFETY
comment its exec_lock() call carries elsewhere]

Signed-off-by: Eryk Wieliczko <eryk@wieliczko.ninja>
(cherry picked from commit 13c3371ce23dceabad0fffd1d16ee121adb93dff)
Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
