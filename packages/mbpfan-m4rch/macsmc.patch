+static t_sensors *macsmc_sensors(void)
+{
+    t_sensors *head = NULL;
+    for (int i = 1; i < NUM_TEMP_INPUTS; i++) {
+        char *label_path = smprintf("%s/temp%d_label", applesmc_path, i);
+        char label[64] = {0};
+        FILE *f = fopen(label_path, "r");
+        free(label_path);
+        if (!f) continue;
+        bool cpu = fgets(label, sizeof(label), f) &&
+            (!strncmp(label, "CPU", 3) || !strncmp(label, "GPU", 3) || !strncmp(label, "SoC", 3));
+        fclose(f);
+        if (!cpu) continue;
+        char *path = smprintf("%s/temp%d_input", applesmc_path, i);
+        f = fopen(path, "r");
+        if (!f) { free(path); continue; }
+        t_sensors *sensor = calloc(1, sizeof(*sensor));
+        if (!sensor) exit(EXIT_FAILURE);
+        sensor->path = path;
+        sensor->file = f;
+        sensor->next = head;
+        head = sensor;
+    }
+    if (!head) {
+        mbp_log(LOG_CRIT, "No macsmc CPU/GPU die-temperature sensor; refusing manual fan control");
+        exit(EXIT_FAILURE);
+    }
+    return head;
+}
