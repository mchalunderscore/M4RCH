+static bool detect_macsmc(const char *root)
+{
+    DIR *hwmons = opendir(root);
+    if (hwmons) {
+        struct dirent *entry;
+        while ((entry = readdir(hwmons))) {
+            if (strncmp(entry->d_name, "hwmon", 5)) continue;
+            char *name_path = smprintf("%s/%s/name", root, entry->d_name);
+            char name[64] = {0};
+            FILE *f = fopen(name_path, "r");
+            free(name_path);
+            if (!f) continue;
+            bool match = fgets(name, sizeof(name), f) &&
+                (strcspn(name, "\r\n") == strlen("macsmc_hwmon") &&
+                 !strncmp(name, "macsmc_hwmon", strlen("macsmc_hwmon")));
+            fclose(f);
+            if (!match) continue;
+            snprintf(applesmc_path, sizeof(applesmc_path), "%s/%s", root, entry->d_name);
+            snprintf(applesmc_fan_path, sizeof(applesmc_fan_path), "%s/%s/fan", root, entry->d_name);
+            macsmc = true;
+            mbp_log(LOG_INFO, "Using macsmc temperature and fan controller at %s", applesmc_path);
+            closedir(hwmons);
+            return true;
+        }
+        closedir(hwmons);
+    }
+
+    return false;
+}
