pkgname=mbpfan-m4rch
pkgver=2.4.0
pkgrel=2
pkgdesc='MacBook fan controller with Apple Silicon macsmc hwmon support'
arch=('aarch64')
url='https://github.com/linux-on-mac/mbpfan'
license=('GPL-3.0-or-later')
depends=('glibc')
provides=("mbpfan=$pkgver")
conflicts=('mbpfan')
backup=('etc/mbpfan.conf')
# Upstream afb8bbb83dd8de85856e297e267581dab4f3f201, plus macsmc sysfs support.
source=('mbpfan-source.tar.gz' 'macsmc.patch' 'mbpfan.service' 'mbpfan.conf')
prepare() { patch -d mbpfan -Np1 < "$srcdir/macsmc.patch"; }
build() { make -C mbpfan bin/mbpfan; }
package() {
  install -Dm755 mbpfan/bin/mbpfan "$pkgdir/usr/bin/mbpfan"
  install -Dm644 mbpfan.conf "$pkgdir/etc/mbpfan.conf"
  install -Dm644 mbpfan.service "$pkgdir/usr/lib/systemd/system/mbpfan.service"
  install -Dm644 macsmc.patch "$pkgdir/usr/share/doc/$pkgname/macsmc.patch"
}
