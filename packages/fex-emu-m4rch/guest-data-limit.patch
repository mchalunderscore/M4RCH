new file mode 100644
--- /dev/null
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/GuestDataLimit.cpp
@@ -0,0 +1,223 @@
+// SPDX-License-Identifier: MIT
+#include "LinuxSyscalls/Syscalls.h"
+#include <FEXCore/Utils/MathUtils.h>
+#include <dirent.h>
+#include <charconv>
+#include <cstdlib>
+#include <sys/file.h>
+#include <sys/uio.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace FEX::HLE {
+namespace {
+void Require(bool Condition, const char* Message) { if (!Condition) { LogMan::Msg::EFmt("Guest data limit: {}", Message); std::abort(); } }
+constexpr uint64_t Magic = 0x3141544144584546ULL; // FEXDATA1
+struct State { uint64_t MagicNumber; struct rlimit Limit; };
+struct FileLock {
+  int FD;
+  explicit FileLock(int FD) : FD {FD} { int Result; do { Result = flock(FD, LOCK_EX); } while (Result && errno == EINTR); Require(Result == 0, "Cannot lock guest data limit"); }
+  ~FileLock() { flock(FD, LOCK_UN); }
+};
+State Read(int FD) {
+  State S {};
+  Require(pread(FD, &S, sizeof(S), 0) == sizeof(S) && S.MagicNumber == Magic, "Invalid guest data limit state");
+  return S;
+}
+void Write(int FD, State S) {
+  Require(pwrite(FD, &S, sizeof(S), 0) == sizeof(S), "Cannot save guest data limit");
+}
+int FindState(pid_t PID) {
+  auto ExePath = fextl::fmt::format("/proc/{}/exe", PID);
+  char Exe[4096]; auto ExeSize = readlink(ExePath.c_str(), Exe, sizeof(Exe));
+  if (ExeSize < 0 && (errno == EACCES || errno == EPERM)) return -2;
+  if (ExeSize == sizeof(Exe)) { errno = EAGAIN; return -2; }
+  bool IsFEX = ExeSize > 0 && (std::string_view(Exe, ExeSize).ends_with("/FEX") || std::string_view(Exe, ExeSize).ends_with("/FEX (deleted)"));
+  auto StatusPath = fextl::fmt::format("/proc/{}/status", PID);
+  int StatusFD = open(StatusPath.c_str(), O_RDONLY | O_CLOEXEC);
+  char Status[8192] {};
+  auto StatusSize = StatusFD == -1 ? -1 : read(StatusFD, Status, sizeof(Status) - 1);
+  if (StatusFD != -1) close(StatusFD);
+  if (StatusSize < 0) return IsFEX ? -2 : -1;
+  pid_t InnerPID = PID;
+  if (const char* Field = strstr(Status, "\nNStgid:")) {
+    Field += strlen("\nNStgid:");
+    while (*Field && *Field != '\n') {
+      while (*Field == ' ' || *Field == '\t') ++Field;
+      if (*Field == '\n') break;
+      auto [End, Error] = std::from_chars(Field, Status + StatusSize, InnerPID);
+      if (Error != std::errc()) break;
+      Field = End;
+    }
+  }
+  auto Expected = fextl::fmt::format("/memfd:FEX-guest-data-limit.{} (deleted)", InnerPID);
+  auto Folder = fextl::fmt::format("/proc/{}/fd", PID);
+  // A fork child must publish its own state before a remote prlimit can use it.
+  // Never modify the parent's inherited record during this short startup window.
+  for (unsigned Retry = 0; Retry < 100; ++Retry) {
+    DIR* Dir = opendir(Folder.c_str());
+    if (!Dir) return IsFEX ? -2 : -1;
+    int Result = -1;
+    bool PendingChild = IsFEX;
+    while (auto Entry = readdir(Dir)) {
+      auto Path = Folder + "/" + Entry->d_name;
+      char Name[128];
+      auto Size = readlink(Path.c_str(), Name, sizeof(Name));
+      if (Size < 0) continue;
+      std::string_view Target {Name, static_cast<size_t>(Size)};
+      bool Legacy = Target == "/memfd:FEX-guest-data-limit (deleted)";
+      if (Target != Expected && !Legacy) {
+        PendingChild |= Target.starts_with("/memfd:FEX-guest-data-limit.");
+        continue;
+      }
+      Result = open(Path.c_str(), O_RDWR | O_CLOEXEC);
+      if (Result != -1) {
+        State Probe {};
+        if (pread(Result, &Probe, sizeof(Probe), 0) == sizeof(Probe) && Probe.MagicNumber == Magic) break;
+        close(Result); Result = -1; PendingChild = true;
+      }
+    }
+    closedir(Dir);
+    if (Result != -1) return Result;
+    if (!PendingChild) return -1;
+    usleep(1000);
+  }
+  errno = EAGAIN;
+  return -2;
+}
+}
+
+bool CopyResourceMemory(void* Destination, const void* Source, size_t Size, bool ToUser) {
+  iovec Local {ToUser ? const_cast<void*>(Source) : Destination, Size};
+  iovec Remote {ToUser ? Destination : const_cast<void*>(Source), Size};
+  return (ToUser ? process_vm_writev(getpid(), &Local, 1, &Remote, 1, 0) : process_vm_readv(getpid(), &Local, 1, &Remote, 1, 0)) == Size;
+}
+
+void SyscallHandler::InitializeDataLimit(int InheritedFD, const struct rlimit* InitialLimit) {
+  const char* Value = getenv("FEX_DATA_LIMIT_FD");
+  if (InheritedFD == -1 && Value) {
+    auto End = Value + strlen(Value);
+    auto [Parsed, Error] = std::from_chars(Value, End, InheritedFD);
+    Require(Error == std::errc() && Parsed == End && InheritedFD >= 0, "Invalid inherited data limit FD");
+    unsetenv("FEX_DATA_LIMIT_FD");
+  }
+  State Initial {Magic, {}};
+  if (InheritedFD != -1) {
+    Initial = Read(InheritedFD);
+    DataLimitFD = InheritedFD;
+    Require(fcntl(DataLimitFD, F_SETFD, FD_CLOEXEC) == 0, "Cannot protect inherited data limit");
+    FM.SetProtectedDataLimitFD(DataLimitFD);
+    return;
+  } else {
+    if (InitialLimit) Initial.Limit = *InitialLimit;
+    else Require(getrlimit(RLIMIT_DATA, &Initial.Limit) == 0, "Cannot read host data limit");
+  }
+  auto Name = fextl::fmt::format("FEX-guest-data-limit.{}", getpid());
+  DataLimitFD = memfd_create(Name.c_str(), MFD_CLOEXEC | MFD_ALLOW_SEALING);
+  Require(DataLimitFD != -1 && ftruncate(DataLimitFD, sizeof(State)) == 0, "Cannot create guest data limit state");
+  // Publish the magic last so remote readers cannot accept an incomplete record.
+  Initial.MagicNumber = 0;
+  Write(DataLimitFD, Initial);
+  Require(pwrite(DataLimitFD, &Magic, sizeof(Magic), 0) == sizeof(Magic), "Cannot publish guest data limit");
+  Require(fcntl(DataLimitFD, F_ADD_SEALS, F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL) == 0, "Cannot seal data limit state size");
+  FM.SetProtectedDataLimitFD(DataLimitFD);
+}
+
+void SyscallHandler::LockDataLimitForFork() {
+  int Result;
+  do { Result = flock(DataLimitFD, LOCK_EX); } while (Result && errno == EINTR);
+  Require(Result == 0, "Cannot lock data limit for fork");
+  ForkDataLimitSnapshot = Read(DataLimitFD).Limit;
+}
+
+void SyscallHandler::UnlockDataLimitForFork() {
+  Require(flock(DataLimitFD, LOCK_UN) == 0, "Cannot unlock data limit after fork");
+}
+
+void SyscallHandler::ForkDataLimit() {
+  State Initial {Magic, ForkDataLimitSnapshot};
+  close(DataLimitFD);
+  DataLimitFD = -1;
+  InitializeDataLimit(-1, &Initial.Limit);
+}
+
+struct rlimit SyscallHandler::ReadDataLimit() {
+  FileLock Lock {DataLimitFD};
+  return Read(DataLimitFD).Limit;
+}
+
+int SyscallHandler::SerializeDataLimit(FEXCore::Core::InternalThreadState* Thread) {
+  auto Guard = FEXCore::GuardSignalDeferringSection(VMATracking.Mutex, Thread);
+  // The fresh descriptor is only exposed to the next interpreter at exec time.
+  // The persistent state descriptor stays CLOEXEC and is hidden from guest close.
+  return dup(DataLimitFD);
+}
+
+int SyscallHandler::GuestDup(FEXCore::Core::InternalThreadState* Thread, int Source, int Target, int Flags, bool Dup3) {
+  auto Guard = FEXCore::GuardSignalDeferringSection(VMATracking.Mutex, Thread);
+  if (IsDataLimitFD(Source)) { errno = EBADF; return -1; }
+  if (!Dup3 && Source == Target) return dup2(Source, Target);
+  if (Dup3 && (Flags & ~O_CLOEXEC || Source == Target)) { errno = EINVAL; return -1; }
+  bool Relocated = false;
+  if (IsDataLimitFD(Target)) {
+    if (fcntl(Source, F_GETFD) == -1) return -1;
+    int Replacement = fcntl(DataLimitFD, F_DUPFD_CLOEXEC, 0);
+    if (Replacement == -1) return -1;
+    DataLimitFD = Replacement;
+    FM.SetProtectedDataLimitFD(DataLimitFD);
+    Relocated = true;
+  }
+  int Result = Dup3 ? dup3(Source, Target, Flags) : dup2(Source, Target);
+  if (Result == -1 && Relocated) { int Error = errno; close(Target); errno = Error; }
+  return Result;
+}
+
+int SyscallHandler::GuestPrlimit(FEXCore::Core::InternalThreadState* Thread, pid_t PID, int Resource,
+                                const struct rlimit* Next, struct rlimit* Previous) {
+  if (Resource != RLIMIT_DATA) return prlimit(PID, static_cast<__rlimit_resource>(Resource), Next, Previous);
+  if (PID < 0) { errno = EINVAL; return -1; }
+  // Use the kernel's PID lookup and credential checks, even though data_vm is emulated.
+  if (prlimit(PID, RLIMIT_DATA, nullptr, nullptr)) return -1;
+  auto Guard = FEXCore::GuardSignalDeferringSectionWithFallback(VMATracking.Mutex, Thread);
+  bool Own = PID == 0 || PID == getpid() || PID == gettid();
+  int FD = Own ? DataLimitFD : FindState(PID);
+  if (FD == -2) return -1;
+  if (FD == -1) return prlimit(PID, RLIMIT_DATA, Next, Previous); // Native target.
+  int Result = 0;
+  {
+    FileLock Lock {FD};
+    State Old = Read(FD);
+    if (Next && Next->rlim_cur > Next->rlim_max) { errno = EINVAL; Result = -1; }
+    // FEX is an unprivileged emulator: never silently grant a hard-limit increase.
+    else if (Next && Next->rlim_max > Old.Limit.rlim_max) { errno = EPERM; Result = -1; }
+    else {
+      if (Next) Write(FD, State {Magic, *Next});
+      if (Previous) *Previous = Old.Limit;
+    }
+  }
+  int Error = errno;
+  if (!Own) close(FD);
+  errno = Error;
+  return Result;
+}
+
+uint64_t SyscallHandler::DataUsage(uint64_t Start, uint64_t Length) const {
+  uint64_t End = Length > ~0ULL - Start ? ~0ULL : Start + Length;
+  uint64_t Bytes = 0;
+  for (auto& [Base, VMA] : VMATracking.VMAs) {
+    if (Base >= End) break;
+    if (!VMA.Prot.Writable || VMA.Flags.Shared || VMA.Flags.GrowsDown || Base + VMA.Length <= Start) continue;
+    Bytes += std::min(End, Base + VMA.Length) - std::max(Start, Base);
+  }
+  return Bytes;
+}
+
+bool SyscallHandler::DataLimitAllows(uint64_t Added, uint64_t Removed) {
+  if (Added <= Removed) return true; // Shrinks/replacements remain possible after lowering a limit.
+  auto Values = ReadDataLimit();
+  auto Limit = Values.rlim_cur == 0 ? Values.rlim_max : Values.rlim_cur;
+  uint64_t Used = DataUsage();
+  return Used <= Limit && Added - Removed <= Limit - Used;
+}
+} // namespace FEX::HLE
