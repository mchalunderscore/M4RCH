pkgname=mesa-flatpak-m4rch
pkgver=26.3.0.r20261026.f2c9dc3
pkgrel=1
pkgdesc='Apple Silicon Mesa GL.host drivers for Freedesktop 25.08 and 26.08'
arch=('aarch64')
url='https://github.com/aurora-silicon/mesa'
license=('MIT' 'BSD-3-Clause' 'SGI-B-2.0' 'Apache-2.0 WITH LLVM-exception')
depends=('flatpak')
options=('!strip' '!debug')
source=('flatpak-extensions.tar.gz')
package() {
  install -d "$pkgdir/var/lib/flatpak/extension"
  cp -a "$srcdir/extension/." "$pkgdir/var/lib/flatpak/extension/"
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  cp -a "$srcdir/licenses/." "$pkgdir/usr/share/licenses/$pkgname/"
}
