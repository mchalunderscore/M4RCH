pkgname=signal-desktop-m4rch
pkgver=8.32.0
pkgrel=1
pkgdesc='Signal Desktop with the m4rch Electron runtime and corrected libyuv SME code'
arch=('aarch64')
url='https://signal.org'
license=('AGPL-3.0-only')
depends=('alsa-lib' 'libasound.so=2-64' 'at-spi2-core' 'libatk-bridge-2.0.so=0-64' 'cairo' 'libcairo.so=2-64' 'dbus' 'libdbus-1.so=3-64' 'expat' 'libexpat.so=1-64' 'glib2' 'libgio-2.0.so=0-64' 'glibc' 'gtk3' 'hicolor-icon-theme' 'libcups' 'libdrm' 'libgcc' 'libnotify' 'libpulse' 'libstdc++' 'libstdc++.so=6-64' 'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxkbcommon.so=0-64' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango' 'libpango-1.0.so=0-64' 'systemd-libs' 'libudev.so=1-64')
optdepends=('xdg-desktop-portal: Screensharing with Wayland')
provides=("signal-desktop=$pkgver")
conflicts=('signal-desktop')
options=('!strip' '!debug')
install=signal.install
source=('signal-original.pkg.tar.xz' 'electron45-runtime.tar.zst' 'copy-fuses.py')
noextract=('signal-original.pkg.tar.xz' 'electron45-runtime.tar.zst')
sha256sums=('015e13c818193b9f97543870207b593e4418021325c821663c3bb51d4083d0c4'
            '701d26b30b11ab6b8d3f12a32432812f315a1338ee3e9e94f46c0d8fc0193f69'
            'cfd43a6d6a08b0e79269adc04bf43216a66051d8b9c0d8f470ebaf80b740f754')

package() {
  bsdtar --no-same-owner -xf "$srcdir/signal-original.pkg.tar.xz" -C "$pkgdir" usr
  local runtime="$srcdir/runtime"
  mkdir -p "$runtime"
  bsdtar --no-same-owner -xf "$srcdir/electron45-runtime.tar.zst" -C "$runtime"
  python "$srcdir/copy-fuses.py" "$pkgdir/usr/lib/signal-desktop/signal-desktop" "$runtime/vesktop"
  mv "$pkgdir/usr/lib/signal-desktop/resources" "$srcdir/signal-resources"
  rm -rf "$pkgdir/usr/lib/signal-desktop"
  install -d "$pkgdir/usr/lib/signal-desktop"
  cp -a --no-preserve=ownership "$runtime/." "$pkgdir/usr/lib/signal-desktop/"
  mv "$pkgdir/usr/lib/signal-desktop/vesktop" "$pkgdir/usr/lib/signal-desktop/signal-desktop"
  mv "$srcdir/signal-resources" "$pkgdir/usr/lib/signal-desktop/resources"
  chmod 4755 "$pkgdir/usr/lib/signal-desktop/chrome-sandbox"
}
