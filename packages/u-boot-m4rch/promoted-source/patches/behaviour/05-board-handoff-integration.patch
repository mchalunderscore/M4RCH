--- a/arch/arm/mach-apple/aurora-handoff.c
+++ b/arch/arm/mach-apple/aurora-handoff.c
@@ -230,3 +230,34 @@
 #include "ext_phy.c"
 #include "shared-tree.c"
 
+/* Start from m1n1's live tree; retain existing admission and hardware fixups. */
+int aurora_j614s_handoff(const void *live, void *out, int capacity,
+                        struct adt_view adt, u64 boot_mpidr)
+{
+    int n, port, aop_error, isp_error;
+    u32 ready = 0;
+    CHECK(shared_prepare(out, live, capacity, boot_mpidr));
+	/* Speaker topology and codec availability belong to the board tree. */
+	n = fdt_path_offset(live, "/chosen");
+	int prepared_len;
+	const fdt32_t *prepared = fdt_getprop(live, n, "m4rch,dapf-ready", &prepared_len);
+	if (prepared && prepared_len == 4) ready = fdt32_ld(prepared);
+	aop_error = aop_standard_handoff(out, live, ready);
+	isp_error = isp_handoff(out, adt, ready);
+	if (aop_error) CHECK(disable_compatible(out, "apple,t6041-aop"));
+	if (isp_error) CHECK(disable_compatible(out, "apple,t6041-isp"));
+	int phy = ext_phy_handoff(out, adt);
+	if (phy) {
+		printf("J614s: HDMI PHY handoff failed: %d\n", phy);
+		CHECK(ext_refuse(out, "/dcp@3a2e00000"));
+	}
+	for (port = 0; port < 3; port++) {
+		/* A port without this boot's tuning remains disabled. */
+		int ret = usb_handoff(out, adt, port);
+		if (ret)
+			printf("J614s: USB port %d handoff failed: %d\n", port, ret);
+	}
+	if (aop_error || isp_error)
+		printf("J614s: handoff failures AOP=%d ISP=%d\n", aop_error, isp_error);
+	return 0;
+}
