+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Trial: consume the m1n1 tree directly, retaining the existing admission gates. */
+static int shared_prepare(void *out, const void *live, int capacity, u64 boot_mpidr)
+{
+    if (fdt_check_header(live) || fdt_node_check_compatible(live, 0, "apple,j614s")) return BAD;
+    CHECK(fdt_open_into(live, out, capacity));
+    fdt_set_boot_cpuid_phys(out, (u32)boot_mpidr);
+    return 0;
+}
--- /dev/null
+++ b/arch/arm/mach-apple/aurora-handoff.c
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Data-only bootloader J614s board port. No MMIO and no firmware execution.
+ * The same translation unit is compiled against userspace libfdt for tests.
+ */
+#ifdef AURORA_HOST_TEST
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <libfdt.h>
+typedef uint8_t u8;
+typedef uint32_t u32;
+typedef uint64_t u64;
+#else
+#include <linux/types.h>
+#include <linux/string.h>
+#include <linux/libfdt.h>
+#endif
+
+#ifdef AURORA_HOST_TEST
+#define CHECK(x) do { int err_ = (x); if (err_ < 0) { fprintf(stderr, "handoff:%d %s: %d\n", __LINE__, #x, err_); return err_; } } while (0)
+#else
+#define CHECK(x) do { int err_ = (x); if (err_ < 0) { printf("Boot: handoff check line %d (%s) failed: %d\n", __LINE__, #x, err_); return err_; } } while (0)
+#endif
+#define BAD (-FDT_ERR_BADVALUE)
+
+static int find_compatible(const void *dt, const char *compat)
+{
+	return fdt_node_offset_by_compatible(dt, -1, compat);
+}
+
+static int disable_compatible(void *dt, const char *compat)
+{
+	int n = -1;
+	while ((n = fdt_node_offset_by_compatible(dt, n, compat)) >= 0)
+		CHECK(fdt_setprop_string(dt, n, "status", "disabled"));
+	return 0;
+}
+
+/* Keep all boot-stage ANS queue/RTKit DMA allocations reserved, including
+ * buffers allocated while GRUB reads the disk. U-Boot adds its environment
+ * allocation to SYS_MALLOC_LEN: use TOTAL_MALLOC_LEN, as mem_malloc_init does.
+ * Bounds must come from the live RAM map, never donor addresses. */
+static int retain_live_ans_memory(void *out, u64 start, u64 end, u64 expected)
+{
+	const fdt64_t *ram;
+	int len, i, contained = 0;
+	printf("Boot: ANS allocation arena %#llx..%#llx; expected size %#llx\n",
+	       (unsigned long long)start, (unsigned long long)end,
+	       (unsigned long long)expected);
+	if (!start || end <= start || end - start != expected) {
+		printf("Boot: ANS allocation size mismatch\n");
+		return BAD;
+	}
+	ram = fdt_getprop(out, fdt_path_offset(out, "/memory@0"), "reg", &len);
+	if (!ram || len <= 0 || len % 16)
+		return BAD;
+	for (i = 0; i < len / 8; i += 2) {
+		u64 base = fdt64_ld(ram + i), size = fdt64_ld(ram + i + 1);
+		if (base <= start && end - base <= size)
+			contained = 1;
+	}
+	if (!contained) {
+		printf("Boot: ANS allocation arena is outside the live RAM map\n");
+		return BAD;
+	}
+	CHECK(fdt_add_mem_rsv(out, start, end - start));
+	return 0;
+}
+
+#include "shared-tree.c"
+
