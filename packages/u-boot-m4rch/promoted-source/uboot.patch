diff --git a/arch/arm/mach-apple/aop_standard_handoff.c b/arch/arm/mach-apple/aop_standard_handoff.c
new file mode 100644
index 0000000000..23a8f0eb04
--- /dev/null
+++ b/arch/arm/mach-apple/aop_standard_handoff.c
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Consume Aurora m1n1's same-boot DRAM reservations. The kernel's T6040
+ * nCal=0 flow needs external code and the identity OS log, not EDATA. */
+static int aop_standard_handoff(void *out, const void *live, u32 ready)
+{
+    fdt32_t handles[8];
+    u32 device;
+    int source = find_compatible(live, "apple,t6041-aop"), dest;
+    int len, count = 0, code = 0, log = 0;
+    const fdt32_t *refs;
+
+    if (!(ready & 1)) return BAD;
+    CHECK(source);
+    dest = find_compatible(out, "apple,t6041-aop"); CHECK(dest);
+    device = fdt_get_phandle(out, dest);
+    if (!device) {
+        CHECK(fdt_generate_phandle(out, &device));
+        CHECK(fdt_setprop_u32(out, dest, "phandle", device));
+    }
+    refs = fdt_getprop(live, source, "memory-region", &len);
+    if (!refs || len <= 0 || len > sizeof(handles) || len % 4) return BAD;
+    for (int i = 0; i < len / 4; i++) {
+        char path[160];
+        int node = fdt_node_offset_by_phandle(live, fdt32_ld(refs + i)), bytes, target;
+        const fdt32_t *maps;
+        const fdt64_t *reg;
+        u64 phys, size, iova, span;
+        fdt32_t remapped[5];
+        u32 handle;
+        CHECK(node);
+        CHECK(fdt_get_path(live, node, path, sizeof(path)));
+        reg = fdt_getprop(live, node, "reg", &bytes);
+        if (!reg || bytes != 16 || !fdt_getprop(live, node, "no-map", NULL)) return BAD;
+        phys = fdt64_ld(reg); size = fdt64_ld(reg + 1);
+        maps = fdt_getprop(live, node, "iommu-addresses", &bytes);
+        if (!maps || bytes != 20 || fdt32_ld(maps) != fdt_get_phandle(live, source)) return BAD;
+        iova = fdt64_ld((const fdt64_t *)(maps + 1));
+        span = fdt64_ld((const fdt64_t *)(maps + 3));
+        if (!size || size != span || (phys & 0x3fff) || (size & 0x3fff) ||
+            (iova & 0x3fff) || phys > ~0ULL - size || iova > ~0ULL - size) return BAD;
+        target = fdt_path_offset(out, path); CHECK(target);
+        /* Leave unused calibration RAM reserved, without a stale consumer. */
+        if (iova != 0x10000000000ULL && iova != phys) {
+            int r = fdt_delprop(out, target, "iommu-addresses");
+            if (r != -FDT_ERR_NOTFOUND) CHECK(r);
+            continue;
+        }
+        code += iova == 0x10000000000ULL;
+        log += iova == phys;
+        memcpy(remapped, maps, sizeof(remapped)); remapped[0] = cpu_to_fdt32(device);
+        CHECK(fdt_setprop(out, target, "iommu-addresses", remapped, sizeof(remapped)));
+        target = fdt_path_offset(out, path);
+        handle = fdt_get_phandle(out, target);
+        if (!handle) {
+            CHECK(fdt_generate_phandle(out, &handle));
+            CHECK(fdt_setprop_u32(out, target, "phandle", handle));
+        }
+        handles[count++] = cpu_to_fdt32(handle);
+    }
+    if (code != 1 || log != 1 || count != 2) return BAD;
+    dest = find_compatible(out, "apple,t6041-aop"); CHECK(dest);
+    CHECK(fdt_setprop(out, dest, "memory-region", handles, count * sizeof(handles[0])));
+    CHECK(set_enabled(out, "apple,t6041-aop"));
+    dest = find_compatible(out, "apple,t6041-aop");
+    refs = fdt_getprop(out, dest, "iommus", &len);
+    if (!refs || len < 8) return BAD;
+    dest = fdt_node_offset_by_phandle(out, fdt32_ld(refs)); CHECK(dest);
+    printf("AUMI013: Aurora m1n1 AOP code/log reservations transferred\n");
+    return fdt_setprop_string(out, dest, "status", "okay");
+}
diff --git a/arch/arm/mach-apple/archsd.c b/arch/arm/mach-apple/archsd.c
new file mode 100644
index 0000000000..8e37dd4331
--- /dev/null
+++ b/arch/arm/mach-apple/archsd.c
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Fixed J614s UEFI firmware bridge. The SD's EFI application owns OS boot.
+ * Start from a copy of m1n1's live DT: never discard its memory, CPU release
+ * addresses, firmware reservations, framebuffer or calibration fixups.
+ */
+#include <command.h>
+#include <efi_loader.h>
+#include <env.h>
+#include <fs.h>
+#include <init.h>
+#include <nvme.h>
+#include <blk.h>
+#include <part.h>
+#include <asm/global_data.h>
+#include <linux/libfdt.h>
+#include <linux/sizes.h>
+
+#include "aurora-uboot-handoff.h"
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define EFI_LIMIT SZ_64M
+#define DT_LIMIT SZ_2M
+#define EFI_PATH "/EFI/BOOT/BOOTAA64.EFI"
+static char esp_device[32];
+
+/* fs_size/read close their filesystem. Select the same ESP for each call. */
+static int read_esp(const char *path, void *buffer, size_t limit, size_t *size)
+{
+	loff_t length, actual;
+
+	if (fs_set_blk_dev("nvme", esp_device, FS_TYPE_FAT) ||
+	    fs_size(path, &length) || length <= 0 || length > limit ||
+	    fs_set_blk_dev("nvme", esp_device, FS_TYPE_FAT) ||
+	    fs_read(path, (ulong)buffer, 0, length, &actual) || actual != length)
+		return -1;
+	*size = length;
+	return 0;
+}
+
+static int do_archnvme(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	void *image = (void *)env_get_hex("loadaddr", 0);
+	void *dt = (void *)env_get_hex("fdt_addr_r", 0);
+	void *recorded_image;
+	size_t image_size, recorded_size;
+	char command[96];
+
+	if (!image || !dt ||
+	    fdt_node_check_compatible(gd->fdt_blob, 0, "apple,j614s")) {
+		puts("Boot: missing boot buffers or unexpected board\n");
+		return CMD_RET_FAILURE;
+	}
+	if (nvme_scan_namespace()) {
+		puts("Boot: NVMe scan failed\n");
+		return CMD_RET_FAILURE;
+	}
+	/* Choose an EFI partition by its unique GPT UUID, never by slot alone. */
+	struct blk_desc *desc;
+	struct disk_partition part;
+	int found = 0;
+	for (int disk = 0; disk < 8; disk++) {
+		if (blk_get_desc(UCLASS_NVME, disk, &desc))
+			continue;
+		for (int slot = 1; slot <= 16; slot++) {
+			if (part_get_info(desc, slot, &part) ||
+			    strcasecmp(part.uuid, "5fdb35c6-3a66-416d-8358-6555fd99fcc5"))
+				continue;
+			if (strcasecmp(part.type_guid, "c12a7328-f81f-11d2-ba4b-00a0c93ec93b") ||
+			    (u64)part.start * desc->blksz != 362525229056ULL ||
+			    (u64)part.size * desc->blksz != 1073741824ULL || found++) {
+				puts("Boot: ambiguous or unexpected internal ESP\n");
+				return CMD_RET_FAILURE;
+			}
+			snprintf(esp_device, sizeof(esp_device), "%d:%d", disk, slot);
+		}
+	}
+	if (found != 1) {
+		puts("Boot: internal ESP not found\n");
+		return CMD_RET_FAILURE;
+	}
+    int chosen = fdt_path_offset(gd->fdt_blob, "/chosen"), marker_len;
+    const char *marker = chosen < 0 ? NULL :
+        fdt_getprop(gd->fdt_blob, chosen, "m4rch,control-template", &marker_len);
+    if (!marker || marker_len != sizeof("AUBS001") || strcmp(marker, "AUBS001") ||
+        fdt_open_into(gd->fdt_blob, dt, DT_LIMIT) ||
+        fdt_node_check_compatible(dt, 0, "apple,j614s")) {
+        puts("AUBS001: missing Aurora J614s control tree\n");
+        return CMD_RET_FAILURE;
+    }
+	/* GRUB inherits the translated live Aurora tree. */
+	if (read_esp(EFI_PATH, image, EFI_LIMIT, &image_size) ||
+	    efi_check_pe(image, image_size, NULL) != EFI_SUCCESS) {
+		puts("Boot: missing or invalid /EFI/BOOT/BOOTAA64.EFI\n");
+		return CMD_RET_FAILURE;
+	}
+
+    /* Preserve U-Boot's active control tree. Translate only Linux's handoff
+     * after NVMe/EFI discovery, using the live Aurora control tree. */
+    {
+        char mode[32] = {};
+        size_t mode_size;
+        void *translated = memalign(16384, DT_LIMIT);
+        int ret;
+        if (!translated || read_esp("/AURD001/mode", mode, sizeof(mode) - 1, &mode_size) ||
+            (strcmp(mode, "test\n") && strcmp(mode, "framebuffer\n"))) {
+            puts("Boot: missing Aurora test mode or handoff buffer\n");
+            return CMD_RET_FAILURE;
+        }
+        ret = aurora_prepare_fdt(dt, translated, DT_LIMIT, !strcmp(mode, "framebuffer\n"));
+        if (ret) {
+            printf("Boot: Aurora live board handoff failed (%d)\n", ret);
+            return CMD_RET_FAILURE;
+        }
+        dt = translated;
+    }
+	/* fs_read alone does not record an EFI device path. This must be set
+	 * explicitly so GRUB can locate the ESP from its loaded-image handle.
+	 * bootefi addr:size would clear that path and create a memory device. */
+	efi_set_bootdev("nvme", esp_device, EFI_PATH, image, image_size);
+	efi_get_image_parameters(&recorded_image, &recorded_size);
+	if (recorded_image != image || recorded_size != image_size) {
+		puts("Boot: could not establish the NVMe EFI device path\n");
+		return CMD_RET_FAILURE;
+	}
+	if (env_set("bootargs", NULL))
+		return CMD_RET_FAILURE;
+	snprintf(command, sizeof(command), "bootefi %lx %lx", (ulong)image, (ulong)dt);
+	return run_command(command, 0) ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(archnvme, 1, 0, do_archnvme, "boot the internal NVMe's ARM64 EFI application", "");
