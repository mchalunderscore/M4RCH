+		target = fdt_path_offset(out, region_path);
+		if (target < 0 || fdt_node_check_compatible(out, target, "apple,asc-mem"))
+			return -FDT_ERR_BADVALUE;
+		/* copy_tree copied the region's current reg, status and no-map. */
+		const void *copied = fdt_getprop(out, target, "reg", &len);
+		const char *target_status = fdt_getprop(out, target, "status", NULL);
+		if (!copied || len != reglen || memcmp(copied, reg, reglen) ||
+		    !target_status || strcmp(target_status, "okay") ||
+		    !fdt_getprop(out, target, "no-map", NULL))
+			return -FDT_ERR_BADVALUE;
+		ph = fdt_get_phandle(out, target);
+		if (!ph) {
+			if (fdt_generate_phandle(out, &ph) ||
+			    fdt_setprop_u32(out, target, "phandle", ph))
+				return -FDT_ERR_NOSPACE;
+		}
+		refs[i] = cpu_to_fdt32(ph);
+		fdt32_t mapped[5];
+		memcpy(mapped, map, sizeof(mapped));
+		mapped[0] = cpu_to_fdt32(owner);
+		target = fdt_path_offset(out, region_path);
+		if (target < 0 || fdt_setprop(out, target, "iommu-addresses", mapped, sizeof(mapped)))
+			return -FDT_ERR_NOSPACE;
+	}
+	static const char *const props[] = {"apple,firmware-version", "apple,firmware-compat"};
+	for (int i = 0; i < 2; i++) {
+		const void *value = fdt_getprop(live, src, props[i], &len);
+		if (!value || len < 12 || len > 20 || len % 4)
+			return -FDT_ERR_BADVALUE;
+		dst = fdt_path_offset(out, path);
+		if (dst < 0 || fdt_setprop(out, dst, props[i], value, len))
+			return -FDT_ERR_NOSPACE;
+	}
+	dst = fdt_path_offset(out, path);
+	if (dst < 0 || fdt_setprop(out, dst, "memory-region", refs, sizeof(refs)))
+		return -FDT_ERR_NOSPACE;
+	dst = fdt_path_offset(out, path);
+	return fdt_setprop(out, dst, "memory-region-names", names, sizeof(names));
+}
+
+static int ext_bridge_one(void *out, const void *live, const char *path)
+{
+	int capacity = fdt_totalsize(out), ret;
+	void *scratch = malloc(capacity);
+	if (!scratch)
+		return -FDT_ERR_NOSPACE;
+	ret = fdt_open_into(out, scratch, capacity);
+	if (!ret)
+		ret = ext_bridge_apply(scratch, live, path);
+	if (!ret)
+		memcpy(out, scratch, capacity);
+	free(scratch);
+	return ret;
+}
