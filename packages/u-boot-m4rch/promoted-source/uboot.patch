+++ b/arch/arm/mach-apple/aurora-uboot-handoff.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <malloc.h>
+#include <env_internal.h>
+#include <asm/system.h>
+#include "aurora-template.h"
+#include "aurora-handoff.c"
+
+static int aurora_prepare_fdt(const void *live, void *out, int capacity, bool gpu_off)
+{
+    struct adt_view adt = {};
+    int parent = fdt_path_offset(live, "/reserved-memory"), n, ret;
+    if (parent >= 0) {
+        fdt_for_each_subnode(n, live, parent) {
+            int len;
+            const char *label = fdt_getprop(live, n, "label", &len);
+            const fdt64_t *reg;
+            if (!label || len != 4 || memcmp(label, "adt", 4))
+                continue;
+            reg = fdt_getprop(live, n, "reg", &len);
+            if (!reg || len != 16 || !fdt64_ld(reg) ||
+                fdt64_ld(reg + 1) < 8 || fdt64_ld(reg + 1) > 16 * 1024 * 1024)
+                return -FDT_ERR_BADVALUE;
+            adt.data = (const void *)(unsigned long)fdt64_ld(reg);
+            adt.size = fdt64_ld(reg + 1);
+            break;
+        }
+    }
+    ret = aurora_j614s_handoff(live, out, capacity, aurora_template, adt, read_mpidr() & 0xffffff);
+    if (!ret)
+        ret = retain_live_ans_memory(out, mem_malloc_start, mem_malloc_end,
+                                    TOTAL_MALLOC_LEN);
+    if (!ret && gpu_off) {
+        ret = gpu_dependencies(out, 0);
+        if (ret) return ret;
+        ret = disable_compatible(out, "apple,agx-t6040");
+        if (!ret)
+            ret = fdt_setprop_string(out, fdt_path_offset(out, "/power-management@288e80000"),
+                                     "status", "disabled");
+    }
+    return ret;
+}
diff --git a/arch/arm/mach-apple/dcp_merged_handoff.c b/arch/arm/mach-apple/dcp_merged_handoff.c
new file mode 100644
index 0000000000..b0992ad979
--- /dev/null
+++ b/arch/arm/mach-apple/dcp_merged_handoff.c
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Data-only transfer from the live Aurora control tree to the Linux template.
+ * Never copy hardware-graph phandles across trees. Every consumer and retained
+ * memory-region reference is resolved again in the destination tree.
+ */
+
+static int dcp_bridge_line;
+static char dcp_bridge_consumer[40] = "marker";
+static int dcp_bridge_result(int value, int line)
+{
+    if (value < 0)
+        dcp_bridge_line = line;
+    return value;
+}
+#define DCP_CHECK(expr) do { int result = (expr); if (result < 0) return dcp_bridge_result(result, __LINE__); } while (0)
+
+static int dcp_destination(void *out, const char *alias, u32 *phandle)
+{
+	const char *name = fdt_get_alias(out, alias);
+	char path[128];
+	int node;
+
+	if (!name || strlen(name) >= sizeof(path))
+		return dcp_bridge_result(BAD, __LINE__);
+	board_copy(path, name);
+	node = fdt_path_offset(out, path);
+	DCP_CHECK(node);
+	*phandle = fdt_get_phandle(out, node);
+	if (!*phandle) {
+		DCP_CHECK(fdt_generate_phandle(out, phandle));
+		DCP_CHECK(fdt_setprop_u32(out, node, "phandle", *phandle));
+	}
+	return 0;
+}
+
+static int dcp_memory_region(void *out, const void *live, u32 source, u32 *destination)
+{
+	static const char * const aliases[] = {"dcp", "disp0", "disp0_piodma"};
+	char path[160];
+	const fdt32_t *maps;
+	fdt32_t remapped[15];
+	int src = fdt_node_offset_by_phandle(live, source), dst, len;
+	u32 seen = 0;
+
+	DCP_CHECK(src);
+	DCP_CHECK(fdt_get_path(live, src, path, sizeof(path)));
+	if (strncmp(path, "/reserved-memory/", 17) ||
+	    (fdt_node_check_compatible(live, src, "apple,asc-mem") &&
+	     fdt_node_check_compatible(live, src, "framebuffer") &&
+	     !fdt_getprop(live, src, "apple,dcp-os-log", NULL)) ||
+	    !fdt_getprop(live, src, "no-map", NULL))
+		return dcp_bridge_result(BAD, __LINE__);
+	dst = fdt_path_offset(out, path);
+	DCP_CHECK(dst);
+	*destination = fdt_get_phandle(out, dst);
+	if (!*destination) {
+		DCP_CHECK(fdt_generate_phandle(out, destination));
+		DCP_CHECK(fdt_setprop_u32(out, dst, "phandle", *destination));
+	}
+	maps = fdt_getprop(live, src, "iommu-addresses", &len);
+	if (!maps)
+		return fdt_getprop(live, src, "apple,dcp-os-log", NULL) ? 0 : BAD;
+	if (len <= 0 || len > sizeof(remapped) || len % (5 * sizeof(fdt32_t)))
+		return dcp_bridge_result(BAD, __LINE__);
+	for (int i = 0; i < len / sizeof(fdt32_t); i += 5) {
+		int owner = fdt_node_offset_by_phandle(live, fdt32_ld(maps + i));
+		int identity = -1;
+		u32 phandle;
+
+		DCP_CHECK(owner);
+		for (int n = 0; n < sizeof(aliases) / sizeof(aliases[0]); n++) {
+			const char *alias = fdt_get_alias(live, aliases[n]);
+			if (alias && fdt_path_offset(live, alias) == owner)
+				identity = n;
+		}
+		if (identity < 0 || (seen & (1U << identity)))
+			return dcp_bridge_result(BAD, __LINE__);
+		seen |= 1U << identity;
+		DCP_CHECK(dcp_destination(out, aliases[identity], &phandle));
+		remapped[i] = cpu_to_fdt32(phandle);
+		memcpy(remapped + i + 1, maps + i + 1, 4 * sizeof(fdt32_t));
+	}
+	return dcp_bridge_result(fdt_setprop(out, fdt_path_offset(out, path), "iommu-addresses", remapped, len), __LINE__);
+}
+
+static int dcp_handoff_apply(void *out, const void *live)
+{
+	static const char * const aliases[] = {"dcp", "disp0", "disp0_piodma"};
+	static const char * const properties[] = {"apple,firmware-version", "apple,firmware-compat", "apple,firmware-uuid"};
+	int len;
+	for (int n = 0; n < sizeof(aliases) / sizeof(aliases[0]); n++) {
+		snprintf(dcp_bridge_consumer, sizeof(dcp_bridge_consumer), "%s", aliases[n]);
+		const char *from = fdt_get_alias(live, aliases[n]);
+		const char *to = fdt_get_alias(out, aliases[n]);
+		const fdt32_t *regions;
+		fdt32_t references[12];
+		char destination[128];
+		int src, count;
+
+		if (!from || !to || strlen(to) >= sizeof(destination))
+			return dcp_bridge_result(BAD, __LINE__);
+		board_copy(destination, to);
+		src = fdt_path_offset(live, from);
+		DCP_CHECK(src);
+		if (!fdt_getprop(live, src, "apple,t6041-handoff", NULL))
+			return dcp_bridge_result(BAD, __LINE__);
+		regions = fdt_getprop(live, src, "memory-region", &len);
+		if (!regions || len <= 0 || len > sizeof(references) || len % sizeof(fdt32_t))
+			return dcp_bridge_result(BAD, __LINE__);
+		count = len / sizeof(fdt32_t);
+		if (fdt_stringlist_count(live, src, "memory-region-names") != count)
+			return dcp_bridge_result(BAD, __LINE__);
+		for (int i = 0; i < count; i++) {
+			u32 phandle;
+			DCP_CHECK(dcp_memory_region(out, live, fdt32_ld(regions + i), &phandle));
+			references[i] = cpu_to_fdt32(phandle);
+		}
+		DCP_CHECK(fdt_setprop(out, fdt_path_offset(out, destination), "memory-region", references, len));
+		DCP_CHECK(copy_prop(out, destination, live, src, "memory-region-names"));
+		DCP_CHECK(copy_prop(out, destination, live, src, "apple,t6041-handoff"));
+		if (!n)
+			for (int i = 0; i < sizeof(properties) / sizeof(properties[0]); i++)
+				DCP_CHECK(copy_prop(out, destination, live, src, properties[i]));
+	}
+	printf("AUDP010: standard T6041 named memory regions transferred with Linux phandles\n");
+	return 0;
+}
+
+/* Evidence survives the caller removing an invalid admission marker. */
+static int dcp_handoff(void *out, const void *live)
+{
+    dcp_bridge_line = 0;
+    snprintf(dcp_bridge_consumer, sizeof(dcp_bridge_consumer), "marker");
+    int result = dcp_handoff_apply(out, live);
+    int chosen = fdt_path_offset(out, "/chosen");
+    char summary[160];
+    snprintf(summary, sizeof(summary), "result=%d line=%d consumer=%s", result,
+             dcp_bridge_line, dcp_bridge_consumer);
+    if (chosen < 0)
+        return dcp_bridge_result(BAD, __LINE__);
+    DCP_CHECK(fdt_setprop_string(out, chosen, "m4rch,dcp-bridge-summary", summary));
+    printf("AUDP010: Linux bridge %s\n", summary);
+    if (result) {
+        const char *aliases[] = {"dcp", "disp0", "disp0_piodma"};
+        for (unsigned int i = 0; i < sizeof(aliases) / sizeof(aliases[0]); i++) {
+            const char *path = fdt_get_alias(out, aliases[i]);
+            int node = path ? fdt_path_offset(out, path) : -1;
+            if (node >= 0)
+                fdt_delprop(out, node, "apple,t6041-handoff");
+        }
+    }
+    return result;
+}
+#undef DCP_CHECK
diff --git a/arch/arm/mach-apple/gpu_text_handoff.c b/arch/arm/mach-apple/gpu_text_handoff.c
new file mode 100644
index 0000000000..68d41df513
--- /dev/null
+++ b/arch/arm/mach-apple/gpu_text_handoff.c
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Aurora #428 identifies the loaded image through a named fw-text region.
+ * Publish its address from this boot's ADT, never from the donor board. */
+static int gpu_text_handoff(void *dt, struct adt_view adt)
+{
+    int source = adt_named(adt, "gfx-asc"), node, parent;
+    const u8 *raw, *names;
+    u32 len, handle;
+    u64 physical, iova, size;
+    CHECK(source);
+    names = adt_prop(adt, source, "segment-names", &len);
+    if (!names || len < sizeof("__TEXT;") || len > 256 ||
+        memcmp(names, "__TEXT;", sizeof("__TEXT;") - 1)) return BAD;
+    raw = adt_prop(adt, source, "segment-ranges", &len);
+    if (!raw || len < 64 || len > 128 || len % 32) return BAD;
+    CHECK(dram_segment(adt, raw, 1024 * 1024, &physical, &iova, &size));
+    parent = fdt_path_offset(dt, "/reserved-memory"); CHECK(parent);
+    node = fdt_subnode_offset(dt, parent, "gpu-fw-text");
+    if (node == -FDT_ERR_NOTFOUND) node = fdt_add_subnode(dt, parent, "gpu-fw-text");
+    CHECK(node);
+    fdt64_t reg[] = {cpu_to_fdt64(physical), cpu_to_fdt64(size)};
+    CHECK(fdt_setprop(dt, node, "reg", reg, sizeof(reg)));
+    CHECK(fdt_setprop(dt, node, "no-map", NULL, 0));
+    handle = fdt_get_phandle(dt, node);
+    if (!handle) {
+        CHECK(fdt_generate_phandle(dt, &handle));
+        CHECK(fdt_setprop_u32(dt, node, "phandle", handle));
+    }
+    node = find_compatible(dt, "apple,agx-t6040"); CHECK(node);
+    /* The template has the five established regions; add the same-boot TEXT. */
+    if (fdt_stringlist_search(dt, node, "memory-region-names", "fw-text") >= 0) return BAD;
+    CHECK(fdt_appendprop_u32(dt, node, "memory-region", handle));
+    return fdt_appendprop_string(dt, node, "memory-region-names", "fw-text");
+}
diff --git a/arch/arm/mach-apple/j614s-map.h b/arch/arm/mach-apple/j614s-map.h
new file mode 100644
index 0000000000..d28326365d
--- /dev/null
+++ b/arch/arm/mach-apple/j614s-map.h
@@ -0,0 +1,81 @@
+/* Map only the J614s resources used by the internal NVMe bridge. */
+static struct mm_region sd_map[32];
+static int sd_slots;
+static void sd_map_add(u64 base, u64 size)
+{
+    if (!size || base == FDT_ADDR_T_NONE || sd_slots >= 29)
+        panic("Invalid SD loader MMIO map\n");
+    size += base & (SZ_4K - 1);
+    base = ALIGN_DOWN(base, SZ_4K);
+    sd_map[sd_slots++] = (struct mm_region) {
+        .virt = base, .phys = base, .size = ALIGN(size, SZ_4K),
+        .attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+                 PTE_BLOCK_NON_SHARE | PTE_BLOCK_PXN | PTE_BLOCK_UXN,
+    };
+}
+static void nvme_map_power(ofnode node, int depth)
+{
+    struct ofnode_phandle_args spec;
+    ofnode parent;
+    fdt_size_t size;
+    fdt_addr_t addr;
+    if (depth > 12)
+        panic("NVMe power-domain cycle\n");
+    if (ofnode_device_is_compatible(node, "apple,t8103-pmgr-pwrstate")) {
+        parent = ofnode_get_parent(node);
+        addr = ofnode_get_addr_size_index(parent, 0, &size);
+        if ((addr != 0x502280000ULL && addr != 0x502800000ULL) || size > SZ_128K)
+            panic("Unexpected NVMe PMGR aperture\n");
+        /* One mapping per parent. Repeated phandles share the same window. */
+        bool exists = false;
+        for (int i = 0; i < sd_slots; i++)
+            if (sd_map[i].phys == addr)
+                exists = true;
+        if (!exists)
+            sd_map_add(addr, size);
+    }
+    for (int i = 0; !ofnode_parse_phandle_with_args(node, "power-domains",
+                  "#power-domain-cells", 0, i, &spec); i++)
+        nvme_map_power(spec.node, depth + 1);
+}
+static void nvme_map_expected(ofnode node, u64 expected, u64 minimum)
+{
+    fdt_size_t size;
+    fdt_addr_t addr = ofnode_get_addr_size_index(node, 0, &size);
+    if (!ofnode_valid(node) || addr != expected || size < minimum || size > SZ_1M)
+        panic("Unexpected J614s NVMe resource\n");
+    sd_map_add(addr, size);
+}
+static void sd_build_map(void)
+{
+    ofnode node = ofnode_by_compatible(ofnode_null(), "apple,t6041-nvme-ans2");
+    struct ofnode_phandle_args spec;
+    fdt_size_t size;
+    fdt_addr_t addr;
+    u32 phandle;
+    memset(sd_map, 0, sizeof(sd_map));
+    sd_slots = 0;
+    if (!of_machine_is_compatible("apple,j614s"))
+        panic("Internal NVMe loader requires J614s\n");
+    nvme_map_expected(node, 0x44dcc0000ULL, 0x10000);
+    addr = ofnode_get_addr_size_index(node, 2, &size);
+    if (addr != 0x40dcc0000ULL || size != 0x60000)
+        panic("Unexpected NVMMU aperture\n");
+    sd_map_add(addr, size);
+    addr = ofnode_get_addr_size_index(node, 1, &size);
+    if (addr != 0x409600000ULL || size != SZ_16K)
+        panic("Unexpected NVMe ASC aperture\n");
+    sd_map_add(addr, size);
+    if (ofnode_parse_phandle_with_args(node, "mboxes", "#mbox-cells", 0, 0, &spec))
+        panic("Missing NVMe mailbox\n");
+    nvme_map_expected(spec.node, 0x409608000ULL, SZ_16K);
+    if (ofnode_read_u32(node, "apple,sart", &phandle))
+        panic("Missing NVMe SART\n");
+    nvme_map_expected(ofnode_get_by_phandle(phandle), 0x40dc50000ULL, 0xc000);
+    nvme_map_power(node, 0);
+    node = ofnode_by_compatible(ofnode_null(), "apple,t8103-wdt");
+    nvme_map_expected(node, 0x50836c000ULL, SZ_16K);
+    sd_map[sd_slots++].attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_INNER_SHARE;
+    sd_map[sd_slots++].attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL_NC) |
+        PTE_BLOCK_INNER_SHARE | PTE_BLOCK_PXN | PTE_BLOCK_UXN;
+}
