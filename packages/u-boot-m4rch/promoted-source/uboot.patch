+++ b/arch/arm/mach-apple/ext_phy.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* ATC3 fixed HDMI PHY tuning comes from this boot's ADT, as for ATC0..2.
+ * Keep the node disabled: Aurora's PMP-aware gate owns power sequencing. */
+static int ext_phy_apply(void *out, struct adt_view adt)
+{
+	static const struct { const char *source, *dest; u32 bias; } tables[] = {
+		{"tunable_ATC0AXI2AF", "apple,tunable-axi2af", 0},
+		{"tunable_ATC_FABRIC", "apple,tunable-fabric", 0},
+		{"tunable_ATC_COMMON_CFG", "apple,tunable-common-cfg", 0},
+		{"tunable_ATC0AXI2AF_LIOA", "apple,tunable-axi2af-lioa", 0},
+		{"tunable_LN0_RX_CFG_TX_OF_RXCLK", "apple,tunable-lane0", 0xd000},
+		{"tunable_LN1_RX_CFG_TX_OF_RXCLK", "apple,tunable-lane1", 0x1d000},
+		{"tunable_AUS40CMN_SHM", "apple,tunable-aus40cmn-shm", 0xa00},
+		{"tunable_AUSPLL_CORE", "apple,tunable-auspll", 0x3200},
+		{"tunable_CIO4PLL_CORE", "apple,tunable-cio4pll", 0x3a00},
+	};
+	const char *path = "/phy@39aa90000";
+	int node = fdt_path_offset(out, path);
+	int src = adt.data ? adt_named(adt, "atc-phy3") : -1;
+	const char *status = node < 0 ? NULL : fdt_getprop(out, node, "status", NULL);
+	if (src < 0 || !status || strcmp(status, "disabled") ||
+	    fdt_node_check_compatible(out, node, "apple,t6040-atcphy"))
+		return -FDT_ERR_BADVALUE;
+	for (unsigned int i = 0; i < sizeof(tables) / sizeof(tables[0]); i++) {
+		int ret = tunable(out, path, adt, src, tables[i].source, tables[i].dest,
+				  tables[i].bias);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int ext_phy_handoff(void *out, struct adt_view adt)
+{
+	int capacity = fdt_totalsize(out), ret;
+	void *scratch = malloc(capacity);
+	if (!scratch)
+		return -FDT_ERR_NOSPACE;
+	ret = fdt_open_into(out, scratch, capacity);
+	if (!ret)
+		ret = ext_phy_apply(scratch, adt);
+	if (!ret)
+		memcpy(out, scratch, capacity);
+	free(scratch);
+	return ret;
+}
--- /dev/null
+++ b/arch/arm/mach-apple/ext_placeholder.c
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* Only identical disabled external placeholders may collide between the live
+ * control tree and Linux template. All other reservation collisions remain a
+ * hard error, as in the existing bridge. */
+static bool ext_placeholder_valid(const void *tree, int node)
+{
+	int len;
+	const char *status;
+	const fdt64_t *reg;
+	if (node < 0 || fdt_node_check_compatible(tree, node, "apple,asc-mem") ||
+	    !fdt_getprop(tree, node, "no-map", NULL) ||
+	    fdt_getprop(tree, node, "iommu-addresses", NULL))
+		return false;
+	status = fdt_getprop(tree, node, "status", NULL);
+	reg = fdt_getprop(tree, node, "reg", &len);
+	return status && !strcmp(status, "disabled") && reg && len == 16 &&
+	       fdt64_ld(reg) == 0 && fdt64_ld(reg + 1) == 0x4000;
+}
+
+static bool ext_placeholder_collision(const void *out, int dst, const void *live, int src)
+{
+	static const char *const names[] = {"dcpext0-text", "dcpext0-data", "dcpext0-heap",
+	                                    "dcpext1-text", "dcpext1-data", "dcpext1-heap"};
+	const char *name = fdt_get_name(live, src, NULL);
+	const char *dst_name = fdt_get_name(out, dst, NULL);
+	if (!name || !dst_name || strcmp(name, dst_name))
+		return false;
+	for (unsigned int i = 0; i < sizeof(names) / sizeof(names[0]); i++)
+		if (!strcmp(name, names[i]))
+			return ext_placeholder_valid(live, src) && ext_placeholder_valid(out, dst);
+	return false;
+}
