[Unit]
Description=Apple Silicon hardware initialization
After=systemd-udev-trigger.service local-fs.target
Before=display-manager.service
ConditionPathExists=/sys/firmware/devicetree/base

[Service]
Type=oneshot
# DCP must initialize before the GPU and display manager on this kernel.
ExecStart=/usr/bin/modprobe -a apple_pmp apple_soc_cpufreq macsmc_power macsmc_hwmon gpio_macsmc apple_rtkit_helper apple_dockchannel dockchannel_hid phy_apple_t6040_usb2 dwc3_apple sn201202x hci_bcm4377 brcmfmac rtc_macsmc macsmc_reboot pwm_apple leds_pwm aop aop_als aop_las snd_soc_aop snd_soc_cs42l84 snd_soc_apple_mca snd_soc_macaudio apple_isp appledrm asahi
RemainAfterExit=yes
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
