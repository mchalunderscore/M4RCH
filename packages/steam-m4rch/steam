#!/bin/bash
# Valve's launcher manages the client and games in the user's home directory.
set -euo pipefail
if (( EUID == 0 )); then
    echo 'Run Steam as your normal desktop user.' >&2
    exit 1
fi
exec muvm --emu=fex \
    --env=MESA_LOADER_DRIVER_OVERRIDE=zink --env=GALLIUM_DRIVER=zink \
    --env=LIBGL_ALWAYS_SOFTWARE=0 --env=LIBGL_KOPPER_DISABLE=true \
    --env="STEAM_FORCE_CLIENT=${STEAM_FORCE_CLIENT:-steamrt64}" \
    -- dbus-run-session -- FEXBash -c 'exec /bin/bash /usr/lib/steam/bin_steam.sh "$@"' steam "$@"
