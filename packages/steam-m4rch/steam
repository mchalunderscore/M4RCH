#!/bin/bash
set -euo pipefail
if (( EUID == 0 )); then echo 'Run Steam as your normal desktop user.' >&2; exit 1; fi
launcher=/usr/libexec/aurora/userpages
if ! "$launcher" 4k /usr/bin/getconf PAGESIZE 2>/dev/null | grep -qx 4096; then
    echo 'Native ARM64 Steam needs a kernel with 4 KiB user processes enabled (user4k=on).' >&2
    exit 1
fi
root="${AURORA_STEAM_ROOT:-$(readlink -f -- "$HOME/.steam/root")}"
[[ -x "$root/steamrtarm64/steam" ]] || { echo 'ARM64 Steam is not installed.' >&2; exit 1; }
support="$root/arm64-support"
export AURORA_STEAM_ROOT="$root" AURORA_USERPAGES_LAUNCHER="$launcher"
export MESA_LOADER_DRIVER_OVERRIDE="${MESA_LOADER_DRIVER_OVERRIDE:-zink}"
export GALLIUM_DRIVER="${GALLIUM_DRIVER:-zink}"
export LIBGL_KOPPER_DISABLE="${LIBGL_KOPPER_DISABLE:-true}"
export PATH="$support/usr/bin:$root/steamapps/common/SteamLinuxRuntime_4-arm64/pressure-vessel/bin:$PATH"
export LD_LIBRARY_PATH="$support/usr/lib/aarch64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec /usr/lib/steam/steam-native4k-launch-loop.sh -noverifyfiles "$@"
