pkgname=steam-m4rch
pkgver=1.0.0.81
pkgrel=11
pkgdesc='Native ARM64 Steam launcher for 4 KiB userspace on Apple Silicon'
arch=('aarch64')
url='https://store.steampowered.com/'
license=('LicenseRef-Valve-Steam')
depends=('bash' 'coreutils' 'grep' 'python' 'xdg-utils' 'hicolor-icon-theme')
makedepends=('binutils')
provides=("steam=$pkgver")
conflicts=('steam' 'steam-x86' 'steam-arm64.sh' 'steam-fex.sh')
options=('!strip' '!debug')
source=("steam-launcher.deb::https://repo.steampowered.com/steam/archive/stable/steam-launcher_${pkgver}_all.deb" 'steam' 'steam-native4k-launch-loop.sh' 'userpages.c' 'userpages-prctl.h')
build() {
  cd "$srcdir"
  ${CC:-cc} ${CPPFLAGS} ${CFLAGS} -Wall -Wextra -Wl,-z,max-page-size=65536 ${LDFLAGS} userpages.c -o userpages
}
package() {
  cd "$srcdir"
  ar p steam-launcher.deb data.tar.xz | tar --no-same-owner -xJ -C "$pkgdir" ./usr/lib/steam ./usr/share/applications \
    ./usr/share/icons ./usr/share/pixmaps ./usr/share/man ./usr/share/doc ./usr/share/metainfo
  install -Dm755 "$srcdir/steam" "$pkgdir/usr/bin/steam"
  install -Dm755 "$srcdir/userpages" "$pkgdir/usr/libexec/aurora/userpages"
  install -Dm755 "$srcdir/steam-native4k-launch-loop.sh" "$pkgdir/usr/lib/steam/steam-native4k-launch-loop.sh"
  install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
  gzip -dc "$pkgdir/usr/share/doc/steam/steam_subscriber_agreement.txt.gz" \
    > "$pkgdir/usr/share/licenses/$pkgname/steam_subscriber_agreement.txt"
  install -m644 "$pkgdir/usr/share/doc/steam-launcher/copyright" "$pkgdir/usr/share/licenses/$pkgname/copyright"
}
