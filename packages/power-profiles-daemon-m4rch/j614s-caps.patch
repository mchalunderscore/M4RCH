+static gboolean
+is_j614s (void)
+{
+  g_autofree char *path = ppd_utils_get_sysfs_path ("/sys/firmware/devicetree/base/compatible");
+  g_autofree char *contents = NULL;
+  gsize len = 0;
+  const char board[] = "apple,j614s";
+  const char soc[] = "apple,t6040";
+  gboolean found_board = FALSE, found_soc = FALSE;
+
+  if (!g_file_get_contents (path, &contents, &len, NULL))
+    return FALSE;
+  for (gsize i = 0; i < len;) {
+    const char *end = memchr (contents + i, '\0', len - i);
+    gsize n;
+    if (!end)
+      return FALSE;
+    n = end - (contents + i);
+    found_board |= n == sizeof board - 1 && memcmp (contents + i, board, n) == 0;
+    found_soc |= n == sizeof soc - 1 && memcmp (contents + i, soc, n) == 0;
+    i += n + 1;
+  }
+  return found_board && found_soc;
+}
