+/* J614s: retain limits established by another controller and commit profile
+ * changes as a transaction. A concurrent external writer is detected when
+ * possible; sysfs does not provide an atomic compare-and-swap. */
+typedef struct {
+  Policy *policy;
+  guint64 before, baseline, target;
+  gboolean wrote;
+} CapChange;
+
+/* Frequency QoS updates can become visible asynchronously after sysfs
+ * accepts the write. Allow a bounded wait instead of treating the old value
+ * as a competing writer. */
+static gboolean
+wait_for_limit (Policy *policy, guint64 wanted, guint64 previous, guint64 *observed)
+{
+  for (guint i = 0; i < 200; i++) {
+    if (!read_freq (policy->dir, "scaling_max_freq", observed))
+      return FALSE;
+    if (*observed == wanted)
+      return TRUE;
+    if (*observed != previous)
+      return FALSE;
+    g_usleep (10000);
+  }
+  return FALSE;
+}
+
+static gint
+compare_changes (gconstpointer a, gconstpointer b)
+{
+  const CapChange *left = a, *right = b;
+  return g_strcmp0 (left->policy->dir, right->policy->dir);
+}
+
+static gboolean
+apply_j614s_caps (PpdDriverCpufreq *cpufreq, PpdProfile profile, GError **error)
+{
+  g_autoptr(GArray) changes = g_array_new (FALSE, FALSE, sizeof (CapChange));
+  guint percent = profile_to_percent (profile);
+  gboolean ok = FALSE;
+
+  pick_up_new_policies (cpufreq);
+  if (!cpufreq->policies->len) {
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "No cpufreq policies");
+    return FALSE;
+  }
+  for (guint i = 0; i < cpufreq->policies->len; i++) {
+    Policy *p = g_ptr_array_index (cpufreq->policies, i);
+    CapChange c = { .policy = p };
+    if (!read_freq (p->dir, "scaling_max_freq", &c.before)) {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED, "Cannot read limit for %s", p->dir);
+      return FALSE;
+    }
+    c.baseline = p->owns_limit && c.before == p->last_written ? p->baseline_max : c.before;
+    c.target = MIN (policy_cap (p, percent), c.baseline);
+    g_array_append_val (changes, c);
+  }
+  g_array_sort (changes, compare_changes);
+  for (guint i = 0; i < changes->len; i++) {
+    CapChange *c = &g_array_index (changes, CapChange, i);
+    guint64 current;
+    if (!read_freq (c->policy->dir, "scaling_max_freq", &current) || current != c->before) {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_BUSY, "CPU limit changed during profile switch: %s", c->policy->dir);
+      goto rollback;
+    }
+    if (c->target == c->before)
+      continue;
+    if (!write_cap (c->policy, c->target, error))
+      goto rollback;
+    c->wrote = TRUE;
+    if (!wait_for_limit (c->policy, c->target, c->before, &current)) {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED, "CPU limit did not take effect: %s", c->policy->dir);
+      goto rollback;
+    }
+  }
+  for (guint i = 0; i < changes->len; i++) {
+    CapChange *c = &g_array_index (changes, CapChange, i);
+    c->policy->baseline_max = c->baseline;
+    c->policy->last_written = c->target;
+    /* Ownership ends when our limit equals the external baseline. */
+    c->policy->owns_limit = c->target != c->baseline;
+  }
+  return TRUE;
+
+rollback:
+  for (guint i = changes->len; i > 0; i--) {
+    CapChange *c = &g_array_index (changes, CapChange, i - 1);
+    guint64 current;
+    g_autoptr(GError) rollback_error = NULL;
+    if (!c->wrote)
+      continue;
+    if (!read_freq (c->policy->dir, "scaling_max_freq", &current) ||
+        (current != c->target && current != c->before)) {
+      g_warning ("Not rolling back %s: limit changed or disappeared", c->policy->dir);
+      continue;
+    }
+    if (!write_cap (c->policy, c->before, &rollback_error))
+      g_warning ("Could not roll back %s: %s", c->policy->dir, rollback_error->message);
+    else if (!wait_for_limit (c->policy, c->before, c->target, &current))
+      g_warning ("Rollback did not take effect for %s", c->policy->dir);
+  }
+  return ok;
+}
