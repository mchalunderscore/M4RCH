+    def create_j614s_compatible(self):
+        compatible = os.path.join(self.testbed.get_root_dir(),
+                                  "sys/firmware/devicetree/base/compatible")
+        os.makedirs(os.path.dirname(compatible), exist_ok=True)
+        with open(compatible, "wb") as f:
+            f.write(b"apple,j614s\0apple,t6040\0apple,arm-platform\0")
+
+    def test_j614s_preserves_existing_and_external_limits(self):
+        self.create_j614s_compatible()
+        f = self.create_cpufreq_policy("policy0", "apple-cpufreq",
+            "1260000 2352000 2616000 3096000 3300000 3468000 3996000 4512000")
+        self.write_file_contents(f, "3996000\n")
+        self.start_daemon()
+        self.assertEqual(self.read_file_contents(f).strip(), b"3996000")
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("power-saver"))
+        self.assert_file_eventually_contains(f, "3300000")
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("balanced"))
+        self.assert_file_eventually_contains(f, "3996000")
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("power-saver"))
+        self.assert_file_eventually_contains(f, "3300000")
+        self.write_file_contents(f, "3096000\n")
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("balanced"))
+        self.assertEqual(self.read_file_contents(f).strip(), b"3096000")
+        self.stop_daemon()
+        self.assertEqual(self.read_file_contents(f).strip(), b"3096000")
+
