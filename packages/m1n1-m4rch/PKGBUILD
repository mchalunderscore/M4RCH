pkgname=m1n1-m4rch
pkgver=20261031
pkgrel=2
pkgdesc='Apple Silicon bootloader, stage two'
arch=('aarch64')
url='https://github.com/aurora-silicon/m1n1'
# The embedded Asahi bootlogo's separate terms remain unresolved.
license=('MIT' 'BSD-2-Clause' 'BSD-3-Clause' 'Zlib' 'OFL-1.1' 'CC0-1.0' 'Apache-2.0 WITH LLVM-exception' 'LicenseRef-Asahi-bootlogo-unverified')
provides=('m1n1')
conflicts=('m1n1' 'bootloader-aurora-m4rch')
options=('!strip' '!debug')
source=('m1n1.bin' 'upstream-integration.patch' 'source-stack.md' 'LICENSE' 'licenses.tar.gz')
package() {
  install -Dm644 "$srcdir/m1n1.bin" "$pkgdir/usr/lib/asahi-boot/m1n1.bin"
  install -Dm644 "$srcdir/upstream-integration.patch" "$pkgdir/usr/share/doc/$pkgname/upstream-integration.patch"
  install -Dm644 "$srcdir/source-stack.md" "$pkgdir/usr/share/doc/$pkgname/source-stack.md"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  cp -a --no-preserve=ownership "$srcdir/licenses/." "$pkgdir/usr/share/licenses/$pkgname/"
}
