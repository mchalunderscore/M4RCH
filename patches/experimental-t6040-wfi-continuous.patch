+                "All-core continuous saved WFI, requires saved-WFI boot opt-ins");
+static DEFINE_PER_CPU(u64, continuous_attempts);
+static DEFINE_PER_CPU(u64, continuous_completed);
+
+static int continuous_progress_get(char *buffer, const struct kernel_param *kp)
+{
+ unsigned int cpu;
+ int ret = 0;
+ for_each_online_cpu(cpu)
+  ret += scnprintf(buffer + ret, PAGE_SIZE - ret,
+                   "cpu%u attempts=%llu completed=%llu\n", cpu,
+                   READ_ONCE(per_cpu(continuous_attempts, cpu)),
+                   READ_ONCE(per_cpu(continuous_completed, cpu)));
+ return ret;
+}
+static const struct kernel_param_ops continuous_progress_ops = {
+ .get = continuous_progress_get,
+};
+module_param_cb(experimental_t6040_idle_continuous_progress,
+                &continuous_progress_ops, NULL, 0400);
 
