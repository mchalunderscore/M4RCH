From 34925643ca627a95b193b43632fae09e270b175e Mon Sep 17 00:00:00 2001
From: Yureka <yureka@cyberchaos.dev>
Date: Fri, 24 Jul 2026 19:34:08 +0200
Subject: [PATCH] nvme: fix cdw12 value to read 1 block

This is required for newer firmwares (26.x) at least on both M3 and M4.

Signed-off-by: Yureka <yureka@cyberchaos.dev>
---
 src/nvme.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/nvme.c b/src/nvme.c
index c37d54f9c..2ecc73ec7 100644
--- a/src/nvme.c
+++ b/src/nvme.c
@@ -544,7 +544,7 @@ bool nvme_read(u32 nsid, u64 lba, void *buffer)
     cmd.prp1 = (u64)buffer_addr;
     cmd.cdw10 = lba;
     cmd.cdw11 = lba >> 32;
-    cmd.cdw12 = 1; // 4096 bytes
+    cmd.cdw12 = 0; // #blocks, 0-based -> 1 block a 4096 bytes
 
     return nvme_exec_command(&ioq, &cmd, NULL);
 }
