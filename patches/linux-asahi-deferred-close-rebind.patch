+    /// A successful rebind supersedes an older pending handle-close cleanup.
+    /// Preserve the object reference until after the caller drops the VM lock.
+    pub(super) fn supersede_pending_close(&self, gem: &gem::Object) -> Option<ARef<gem::Object>> {
+        let lifetime = self.lifetime.as_ref()?;
+        let mut state = lifetime.state.lock();
+        let index = state.objects.iter().position(|object| core::ptr::eq(&**object, gem))?;
+        Some(state.objects.swap_remove(index))
+    }
