--- a/arch/arm64/kernel/traps.c
+++ b/arch/arm64/kernel/traps.c
@@ -181,6 +181,11 @@
 
 	pr_emerg("Internal error: %s: %016lx [#%d] " S_SMP "\n",
 		 str, err, ++die_counter);
+
+	/* Saved exception frame only: print before notifiers/symbolic dumps. */
+	pr_emerg("M4RCH_FAULT cpu=%u pc=%016llx lr=%016llx sp=%016llx pstate=%016llx esr=%016lx\n",
