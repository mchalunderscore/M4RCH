From: arch-m4 project
Subject: [PATCH] usb: dwc3-apple: defer fixed-host bring-up to cable events

The enrolled experimental DT still contains apple,force-host-mode. Let the
SD overlay's arch-m4,usb-wait-for-cable marker override that early init while
keeping the existing reset and cable role lifecycle. Publish glue drvdata
before core probe so removal while waiting for the first cable is valid. Reject device requests
on a fixed-host controller before tearing it down: its T6040 PHY only supports
host mode. Log role callback results and initialization outcomes.

Local candidate against Linux e9d2237cd064e6d086d938cd9c85e0c963cf7291 plus
Wallace 55f116dd0e0f28d1412c6be728a101f7d861c473's force-host patch.
No register sequence is added. Native enumeration remains unverified.

--- a/drivers/usb/dwc3/dwc3-apple.c
+++ b/drivers/usb/dwc3/dwc3-apple.c
@@ -13,6 +13,7 @@
 #include <linux/mutex.h>
 #include <linux/platform_device.h>
 #include <linux/reset.h>
+#include <linux/usb/otg.h>
 
 #include "glue.h"
 
@@ -240,13 +241,14 @@
 		break;
 	default:
 		/* Unreachable unless there's a bug in this driver */
-		return -EINVAL;
+		ret = -EINVAL;
+		goto report_init;
 	}
 
 	ret = reset_control_deassert(appledwc->reset);
 	if (ret) {
 		dev_err(appledwc->dev, "Failed to deassert reset, err=%d\n", ret);
-		return ret;
+		goto report_init;
 	}
 
 	ret = dwc3_apple_core_init(appledwc);
@@ -301,7 +303,8 @@
 	}
 
 	appledwc->state = state;
-	return 0;
+	ret = 0;
+	goto report_init;
 
 core_exit:
 	dwc3_core_exit(&appledwc->dwc);
@@ -310,6 +313,8 @@
 	if (ret_reset)
 		dev_warn(appledwc->dev, "Failed to assert reset, err=%d\n", ret_reset);
 
+report_init:
+	dev_info(appledwc->dev, "DWC3 init state=%d result=%d\n", state, ret);
 	return ret;
 }
 
@@ -353,9 +358,19 @@
 static int dwc3_usb_role_switch_set(struct usb_role_switch *sw, enum usb_role role)
 {
 	struct dwc3_apple *appledwc = usb_role_switch_get_drvdata(sw);
-	int ret;
+	const char *role_name = role == USB_ROLE_HOST ? "host" :
+		role == USB_ROLE_DEVICE ? "device" :
+		role == USB_ROLE_NONE ? "none" : "invalid";
+	int ret = 0;
 
 	guard(mutex)(&appledwc->lock);
+
+	/* The T6040 USB2 slice cannot initialize device mode. */
+	if (role == USB_ROLE_DEVICE &&
+	    usb_get_dr_mode(appledwc->dev) == USB_DR_MODE_HOST) {
+		ret = -EOPNOTSUPP;
+		goto report_role;
+	}
 
 	/*
 	 * Skip role switches if appledwc is already in the desired state. The
@@ -369,9 +384,9 @@
 	 * DWC3_APPLE_PROBE_PENDING since that is no-op anyway.
 	 */
 	if (appledwc->state == DWC3_APPLE_HOST && role == USB_ROLE_HOST)
-		return 0;
+		goto report_role;
 	if (appledwc->state == DWC3_APPLE_DEVICE && role == USB_ROLE_DEVICE)
-		return 0;
+		goto report_role;
 
 	/*
 	 * We need to tear all of dwc3 down and re-initialize it every time a cable is
@@ -380,20 +395,28 @@
 	 */
 	ret = dwc3_apple_exit(appledwc);
 	if (ret)
-		return ret;
+		goto report_role;
 
 	switch (role) {
 	case USB_ROLE_NONE:
 		/* Nothing to do if no cable is connected */
-		return 0;
+		goto report_role;
 	case USB_ROLE_HOST:
-		return dwc3_apple_init(appledwc, DWC3_APPLE_HOST);
+		ret = dwc3_apple_init(appledwc, DWC3_APPLE_HOST);
+		break;
 	case USB_ROLE_DEVICE:
-		return dwc3_apple_init(appledwc, DWC3_APPLE_DEVICE);
+		ret = dwc3_apple_init(appledwc, DWC3_APPLE_DEVICE);
+		break;
 	default:
 		dev_err(appledwc->dev, "Invalid target role: %d\n", role);
-		return -EINVAL;
-	}
+		ret = -EINVAL;
+		break;
+	}
+
+report_role:
+	dev_info(appledwc->dev, "Type-C cable role=%s result=%d state=%d\n",
+		 role_name, ret, appledwc->state);
+	return ret;
 }
 
 static enum usb_role dwc3_usb_role_switch_get(struct usb_role_switch *sw)
@@ -443,6 +466,7 @@
 		return -ENOMEM;
 
 	appledwc->dev = &pdev->dev;
+	platform_set_drvdata(pdev, &appledwc->dwc);
 	mutex_init(&appledwc->lock);
 
 	appledwc->reset = devm_reset_control_get_optional_exclusive(dev, NULL);
@@ -500,13 +524,16 @@
 	 * hub carrying the Linux root), bring the core up in host mode
 	 * immediately so the controller starts with no cable event.
 	 */
-	if (device_property_read_bool(dev, "apple,force-host-mode")) {
+	if (device_property_read_bool(dev, "apple,force-host-mode") &&
+	    !device_property_read_bool(dev, "arch-m4,usb-wait-for-cable")) {
 		mutex_lock(&appledwc->lock);
 		ret = dwc3_apple_init(appledwc, DWC3_APPLE_HOST);
 		mutex_unlock(&appledwc->lock);
 		if (ret)
 			return dev_err_probe(&pdev->dev, ret,
 					     "Failed forced host-mode init\n");
+	} else if (device_property_read_bool(dev, "arch-m4,usb-wait-for-cable")) {
+		dev_info(dev, "waiting for Type-C cable event\n");
 	}
 
 	return 0;
