diff --git a/arch/arm/mach-apple/archsd.c b/arch/arm/mach-apple/archsd.c
new file mode 100644
index 00000000..c701c8dd
--- /dev/null
+++ b/arch/arm/mach-apple/archsd.c
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Fixed J614s UEFI firmware bridge. The SD's EFI application owns OS boot.
+ * Start from a copy of m1n1's live DT: never discard its memory, CPU release
+ * addresses, firmware reservations, framebuffer or calibration fixups.
+ */
+#include <command.h>
+#include <efi_loader.h>
+#include <env.h>
+#include <fs.h>
+#include <init.h>
+#include <nvme.h>
+#include <blk.h>
+#include <part.h>
+#include <asm/global_data.h>
+#include <linux/libfdt.h>
+#include <linux/sizes.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define EFI_LIMIT SZ_64M
+#define DT_LIMIT SZ_2M
+#define EFI_PATH "/EFI/BOOT/BOOTAA64.EFI"
+static char esp_device[32];
+#define OVERLAY_PATH "/dtbs/board.dtbo"
+
+/* fs_size/read close their filesystem. Select the same ESP for each call. */
+static int read_esp(const char *path, void *buffer, size_t limit, size_t *size)
+{
+	loff_t length, actual;
+
+	if (fs_set_blk_dev("nvme", esp_device, FS_TYPE_FAT) ||
+	    fs_size(path, &length) || length <= 0 || length > limit ||
+	    fs_set_blk_dev("nvme", esp_device, FS_TYPE_FAT) ||
+	    fs_read(path, (ulong)buffer, 0, length, &actual) || actual != length)
+		return -1;
+	*size = length;
+	return 0;
+}
+
+static int do_archnvme(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	void *image = (void *)env_get_hex("loadaddr", 0);
+	void *dt = (void *)env_get_hex("fdt_addr_r", 0);
+	void *overlay = (void *)env_get_hex("scriptaddr", 0);
+	void *recorded_image;
+	size_t image_size, overlay_size, recorded_size;
+	char command[96];
+
+	puts("ARCHM4 UEFI bridge: framebuffer console ready\n");
+	if (!image || !dt || !overlay ||
+	    fdt_node_check_compatible(gd->fdt_blob, 0, "apple,j614s")) {
+		puts("ARCHM4: missing boot buffers or unexpected board\n");
+		return CMD_RET_FAILURE;
+	}
+	puts("M4RCH UEFI bridge: probing internal Apple NVMe (no SD fallback)\n");
+	if (nvme_scan_namespace()) {
+		puts("M4RCH: NVMe scan failed\n");
+		return CMD_RET_FAILURE;
+	}
+	/* Choose an EFI partition by its unique GPT UUID, never by slot alone. */
+	struct blk_desc *desc;
+	struct disk_partition part;
+	int found = 0;
+	for (int disk = 0; disk < 8; disk++) {
+		if (blk_get_desc(UCLASS_NVME, disk, &desc))
+			continue;
+		for (int slot = 1; slot <= 16; slot++) {
+			if (part_get_info(desc, slot, &part) ||
+			    strcasecmp(part.uuid, "5fdb35c6-3a66-416d-8358-6555fd99fcc5"))
+				continue;
+			if (strcasecmp(part.type_guid, "c12a7328-f81f-11d2-ba4b-00a0c93ec93b") ||
+			    (u64)part.start * desc->blksz != 362525229056ULL ||
+			    (u64)part.size * desc->blksz != 1073741824ULL || found++) {
+				puts("M4RCH: ambiguous or unexpected internal ESP\n");
+				return CMD_RET_FAILURE;
+			}
+			snprintf(esp_device, sizeof(esp_device), "%d:%d", disk, slot);
+		}
+	}
+	if (found != 1) {
+		puts("M4RCH: internal ESP not found\n");
+		return CMD_RET_FAILURE;
+	}
+	if (read_esp(OVERLAY_PATH, overlay, DT_LIMIT, &overlay_size) ||
+	    fdt_check_full(overlay, overlay_size) ||
+	    fdt_totalsize(overlay) != overlay_size ||
+	    fdt_open_into(gd->fdt_blob, dt, DT_LIMIT) ||
+	    fdt_overlay_apply(dt, overlay) ||
+	    fdt_node_check_compatible(dt, 0, "apple,j614s")) {
+		puts("ARCHM4: missing or invalid /dtbs/board.dtbo\n");
+		return CMD_RET_FAILURE;
+	}
+	/* The overlay modifies only this handoff copy, not the control DT used
+	 * by active firmware drivers. GRUB must inherit it, not load a raw DTB. */
+	if (read_esp(EFI_PATH, image, EFI_LIMIT, &image_size) ||
+	    efi_check_pe(image, image_size, NULL) != EFI_SUCCESS) {
+		puts("ARCHM4: missing or invalid /EFI/BOOT/BOOTAA64.EFI\n");
+		return CMD_RET_FAILURE;
+	}
+	/* fs_read alone does not record an EFI device path. This must be set
+	 * explicitly so GRUB can locate the ESP from its loaded-image handle.
+	 * bootefi addr:size would clear that path and create a memory device. */
+	efi_set_bootdev("nvme", esp_device, EFI_PATH, image, image_size);
+	efi_get_image_parameters(&recorded_image, &recorded_size);
+	if (recorded_image != image || recorded_size != image_size) {
+		puts("ARCHM4: could not establish the NVMe EFI device path\n");
+		return CMD_RET_FAILURE;
+	}
+	if (env_set("bootargs", NULL))
+		return CMD_RET_FAILURE;
+	printf("ARCHM4 UEFI bridge: starting %s (%zu bytes)\n", EFI_PATH, image_size);
+	snprintf(command, sizeof(command), "bootefi %lx %lx", (ulong)image, (ulong)dt);
+	return run_command(command, 0) ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(archnvme, 1, 0, do_archnvme, "boot the internal NVMe's ARM64 EFI application", "");
diff --git a/arch/arm/mach-apple/board.c b/arch/arm/mach-apple/board.c
index 44a5ef25..49b1b846 100644
--- a/arch/arm/mach-apple/board.c
+++ b/arch/arm/mach-apple/board.c
@@ -1115,6 +1115,139 @@ static struct mm_region t6032_mem_map[] = {
 	}
 };
 
+/* Map only the J614s resources used by the internal NVMe bridge. */
+static struct mm_region sd_map[32];
+static int sd_slots;
+static void sd_map_add(u64 base, u64 size)
+{
+    if (!size || base == FDT_ADDR_T_NONE || sd_slots >= 29)
+        panic("Invalid SD loader MMIO map\n");
+    size += base & (SZ_4K - 1);
+    base = ALIGN_DOWN(base, SZ_4K);
+    sd_map[sd_slots++] = (struct mm_region) {
+        .virt = base, .phys = base, .size = ALIGN(size, SZ_4K),
+        .attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+                 PTE_BLOCK_NON_SHARE | PTE_BLOCK_PXN | PTE_BLOCK_UXN,
+    };
+}
+/* Visible before the normal console: each completed step adds one green
+ * block at the top-left of the m1n1-supplied framebuffer. No device MMIO,
+ * allocation, UART or disk access is needed. */
+static void nvme_early_mark(unsigned stage)
+{
+    ofnode fb = ofnode_path("/chosen/framebuffer");
+    fdt_size_t size;
+    fdt_addr_t addr;
+    u32 width, height, stride;
+    if (!ofnode_valid(fb) || stage < 1 || stage > 8 ||
+        ofnode_read_u32(fb, "width", &width) ||
+        ofnode_read_u32(fb, "height", &height) ||
+        ofnode_read_u32(fb, "stride", &stride) ||
+        height < 48 || width < 416 || width > 16384 ||
+        stride < width * 4 || stride > 131072)
+        return;
+    const char *format = ofnode_read_string(fb, "format");
+    if (!format)
+        return;
+    u32 green;
+    if (!strcmp(format, "x8r8g8b8"))
+        green = 0x0030ff60;
+    else if (!strcmp(format, "x2r10g10b10"))
+        green = 0x000ffc00;
+    else
+        return;
+    addr = ofnode_get_addr_size(fb, "reg", &size);
+    if (addr == FDT_ADDR_T_NONE || size < (u64)stride * 48)
+        return;
+    for (unsigned y = 8; y < 40; y++) {
+        volatile u32 *row = (volatile u32 *)(ulong)(addr + (u64)y * stride);
+        for (unsigned x = 16 + (stage - 1) * 48; x < 48 + (stage - 1) * 48; x++)
+            row[x] = green;
+    }
+    asm volatile("dsb sy" ::: "memory");
+}
+static void nvme_map_power(ofnode node, int depth)
+{
+    struct ofnode_phandle_args spec;
+    ofnode parent;
+    fdt_size_t size;
+    fdt_addr_t addr;
+    if (depth > 12)
+        panic("NVMe power-domain cycle\n");
+    if (ofnode_device_is_compatible(node, "apple,t8103-pmgr-pwrstate")) {
+        parent = ofnode_get_parent(node);
+        addr = ofnode_get_addr_size_index(parent, 0, &size);
+        if ((addr != 0x502280000ULL && addr != 0x502800000ULL) || size > SZ_128K)
+            panic("Unexpected NVMe PMGR aperture\n");
+        /* One mapping per parent. Repeated phandles share the same window. */
+        bool exists = false;
+        for (int i = 0; i < sd_slots; i++)
+            if (sd_map[i].phys == addr)
+                exists = true;
+        if (!exists)
+            sd_map_add(addr, size);
+    }
+    for (int i = 0; !ofnode_parse_phandle_with_args(node, "power-domains",
+                  "#power-domain-cells", 0, i, &spec); i++)
+        nvme_map_power(spec.node, depth + 1);
+}
+static void nvme_map_expected(ofnode node, u64 expected, u64 minimum)
+{
+    fdt_size_t size;
+    fdt_addr_t addr = ofnode_get_addr_size_index(node, 0, &size);
+    if (!ofnode_valid(node) || addr != expected || size < minimum || size > SZ_1M)
+        panic("Unexpected J614s NVMe resource\n");
+    sd_map_add(addr, size);
+}
+static void sd_build_map(void)
+{
+    ofnode node = ofnode_by_compatible(ofnode_null(), "apple,t8132-nvme-ans2");
+    struct ofnode_phandle_args spec;
+    fdt_size_t size;
+    fdt_addr_t addr;
+    u32 phandle;
+    memset(sd_map, 0, sizeof(sd_map));
+    sd_slots = 0;
+    if (!of_machine_is_compatible("apple,j614s"))
+        panic("Internal NVMe loader requires J614s\n");
+    /* Retain all three reg tuples and the property's original length.
+     * Shrinking a flat-DT property here invalidates offsets in nodes which
+     * U-Boot may already have bound. Preserve the separate NVMMU tuple and
+     * the matching reg-names, even though this driver uses the first window. */
+    fdt32_t reg[] = { cpu_to_fdt32(4), cpu_to_fdt32(0x4dcc0000), 0,
+                     cpu_to_fdt32(0x60000), cpu_to_fdt32(4),
+                     cpu_to_fdt32(0x09600000), 0, cpu_to_fdt32(0x4000),
+                     cpu_to_fdt32(4), cpu_to_fdt32(0x0dcc0000), 0,
+                     cpu_to_fdt32(0x60000) };
+    if (!ofnode_valid(node) || ofnode_write_prop(node, "reg", reg, sizeof(reg), true))
+        panic("Cannot widen NVMe control DT\n");
+    nvme_early_mark(2);
+    nvme_map_expected(node, 0x44dcc0000ULL, 0x60000);
+    addr = ofnode_get_addr_size_index(node, 2, &size);
+    if (addr != 0x40dcc0000ULL || size != 0x60000)
+        panic("Unexpected NVMMU aperture\n");
+    sd_map_add(addr, size);
+    addr = ofnode_get_addr_size_index(node, 1, &size);
+    if (addr != 0x409600000ULL || size != SZ_16K)
+        panic("Unexpected NVMe ASC aperture\n");
+    sd_map_add(addr, size);
+    if (ofnode_parse_phandle_with_args(node, "mboxes", "#mbox-cells", 0, 0, &spec))
+        panic("Missing NVMe mailbox\n");
+    nvme_map_expected(spec.node, 0x409608000ULL, SZ_16K);
+    if (ofnode_read_u32(node, "apple,sart", &phandle))
+        panic("Missing NVMe SART\n");
+    nvme_map_expected(ofnode_get_by_phandle(phandle), 0x40dc50000ULL, 0xc000);
+    nvme_early_mark(3);
+    nvme_map_power(node, 0);
+    nvme_early_mark(4);
+    node = ofnode_by_compatible(ofnode_null(), "apple,wdt");
+    nvme_map_expected(node, 0x50836c000ULL, SZ_16K);
+    nvme_early_mark(5);
+    sd_map[sd_slots++].attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_INNER_SHARE;
+    sd_map[sd_slots++].attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL_NC) |
+        PTE_BLOCK_INNER_SHARE | PTE_BLOCK_PXN | PTE_BLOCK_UXN;
+}
+
 struct mm_region *mem_map;
 
 int board_init(void)
@@ -1172,6 +1305,10 @@ void build_mem_map(void)
 		mem_map = t6030_mem_map;
 	else if (of_machine_is_compatible("apple,t6032"))
 		mem_map = t6032_mem_map;
+	else if (of_machine_is_compatible("apple,t6040")) {
+		sd_build_map();
+		mem_map = sd_map;
+	}
 	else
 		panic("Unsupported SoC\n");
 
@@ -1212,10 +1349,13 @@ void build_mem_map(void)
 
 void enable_caches(void)
 {
+	nvme_early_mark(1);
 	build_mem_map();
-
+	nvme_early_mark(6);
 	icache_enable();
+	nvme_early_mark(7);
 	dcache_enable();
+	nvme_early_mark(8);
 }
 
 u64 get_page_table_size(void)
@@ -1225,6 +1365,7 @@ u64 get_page_table_size(void)
 
 static char *gravity_esp_devpart(void)
 {
+#if CONFIG_IS_ENABLED(NVME)
 	struct disk_partition info;
 	struct blk_desc *nvme_blk;
 	const char *uuid = NULL;
@@ -1281,11 +1422,18 @@ static char *gravity_esp_devpart(void)
 	}
 
 	return devpart;
+#else
+	return "";
+#endif
 }
 
 const char *env_fat_get_intf(void)
 {
+#if CONFIG_IS_ENABLED(NVME)
 	return blk_get_uclass_name(UCLASS_NVME);
+#else
+	return "";
+#endif
 }
 
 char *env_fat_get_dev_part(void)
@@ -1302,27 +1450,16 @@ int board_late_init(void)
 	u32 status = 0;
 	phys_addr_t addr;
 
-	env_set("storage_interface", blk_get_uclass_name(UCLASS_NVME));
-	env_set("fw_dev_part", gravity_esp_devpart());
+/* Probe ANS only from archnvme, after boot buffers and console exist. */
 
 	/* somewhat based on the Linux Kernel boot requirements:
 	 * align by 2M and maximal FDT size 2M
 	 */
-	status |= !lmb_alloc(SZ_1G, &addr) ? env_set_hex("loadaddr", addr) : 1;
+	status |= !lmb_alloc(SZ_64M, &addr) ? env_set_hex("loadaddr", addr) : 1;
 	status |= !lmb_alloc(SZ_2M, &addr) ?
 		env_set_hex("fdt_addr_r", addr) : 1;
-	status |= !lmb_alloc(SZ_128M, &addr) ?
-		env_set_hex("kernel_addr_r", addr) : 1;
-	status |= !lmb_alloc(SZ_1G, &addr) ?
-		env_set_hex("ramdisk_addr_r", addr) : 1;
-	status |= !lmb_alloc(KERNEL_COMP_SIZE, &addr) ?
-		env_set_hex("kernel_comp_addr_r", addr) : 1;
-	status |= !lmb_alloc(KERNEL_COMP_SIZE, &addr) ?
-		env_set_hex("kernel_comp_size", addr) : 1;
 	status |= !lmb_alloc(SZ_4M, &addr) ?
 		env_set_hex("scriptaddr", addr) : 1;
-	status |= !lmb_alloc(SZ_4M, &addr) ?
-		env_set_hex("pxefile_addr_r", addr) : 1;
 
 	if (status)
 		log_warning("late_init: Failed to set run time variables\n");
