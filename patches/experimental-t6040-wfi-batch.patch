 static bool t6040_trial;
 static bool trace_attempted;
 static unsigned long trace_seen;
+
+/* Absolute per-CPU budgets: at most 64 attempts each, no reset interface. */
+static DEFINE_RAW_SPINLOCK(saved_control_lock);
+static unsigned int saved_target = 4;
+static unsigned int saved_budget = 1;
+static unsigned int saved_attempts[2];
+static unsigned int saved_completed[2];
+
+static int saved_budget_set(const char *value, const struct kernel_param *kp)
+{
+	unsigned int next;
+	unsigned long flags;
+	int ret = kstrtouint(value, 0, &next);
+
+	if (ret)
+		return ret;
+	if (next > 64)
+		return -ERANGE;
+	raw_spin_lock_irqsave(&saved_control_lock, flags);
+	saved_budget = next;
+	raw_spin_unlock_irqrestore(&saved_control_lock, flags);
+	return 0;
+}
+
+static int saved_target_set(const char *value, const struct kernel_param *kp)
+{
+	unsigned int next;
+	unsigned long flags;
+	int ret = kstrtouint(value, 0, &next);
+
+	if (ret)
+		return ret;
+	if (next != 4 && next != 5)
+		return -EINVAL;
+	raw_spin_lock_irqsave(&saved_control_lock, flags);
+	if (saved_budget || saved_attempts[0] != saved_completed[0] ||
+	    saved_attempts[1] != saved_completed[1])
+		ret = -EBUSY;
+	else
+		saved_target = next;
+	raw_spin_unlock_irqrestore(&saved_control_lock, flags);
+	return ret;
+}
+
+static int saved_progress_get(char *buffer, const struct kernel_param *kp)
+{
+	unsigned long flags;
+	int ret;
+
+	raw_spin_lock_irqsave(&saved_control_lock, flags);
+	ret = scnprintf(buffer, PAGE_SIZE,
+		"cpu4 attempts=%u completed=%u cpu5 attempts=%u completed=%u budget=%u target=%u\n",
+		saved_attempts[0], saved_completed[0], saved_attempts[1],
+		saved_completed[1], saved_budget, saved_target);
+	raw_spin_unlock_irqrestore(&saved_control_lock, flags);
+	return ret;
+}
+
+static const struct kernel_param_ops saved_budget_ops = {
+	.set = saved_budget_set, .get = param_get_uint,
+};
+static const struct kernel_param_ops saved_target_ops = {
+	.set = saved_target_set, .get = param_get_uint,
+};
+static const struct kernel_param_ops saved_progress_ops = {
+	.get = saved_progress_get,
+};
+module_param_cb(experimental_t6040_idle_wfi_budget, &saved_budget_ops,
+		&saved_budget, 0600);
+module_param_cb(experimental_t6040_idle_wfi_cpu, &saved_target_ops,
+		&saved_target, 0600);
+module_param_cb(experimental_t6040_idle_wfi_progress, &saved_progress_ops,
+		NULL, 0400);
+MODULE_PARM_DESC(experimental_t6040_idle_wfi_budget,
+		"Absolute attempt budget 0..64 for selected CPU; zero disables");
+MODULE_PARM_DESC(experimental_t6040_idle_wfi_cpu,
+		"CPU4 or CPU5; change only while disabled with no attempt in flight");
+
+static bool saved_take_attempt(unsigned int cpu)
+{
+	unsigned long flags;
+	bool allowed = false;
+
+	raw_spin_lock_irqsave(&saved_control_lock, flags);
+	if ((cpu == 4 || cpu == 5) && cpu == saved_target &&
+	    saved_attempts[cpu - 4] < saved_budget) {
+		saved_attempts[cpu - 4]++;
+		allowed = true;
+	}
+	raw_spin_unlock_irqrestore(&saved_control_lock, flags);
+	return allowed;
+}
+
+static void saved_finish_attempt(unsigned int cpu)
+{
+	unsigned long flags;
+	unsigned int count;
+
+	raw_spin_lock_irqsave(&saved_control_lock, flags);
+	count = ++saved_completed[cpu - 4];
+	raw_spin_unlock_irqrestore(&saved_control_lock, flags);
+	pr_emerg("M4RCH_SAVED_WFI cpu=%u completed=%u after CPU_PM_EXIT\n", cpu, count);
+}
 
 void m4rch_idle_checkpoint(unsigned int stage, u64 value);
 
