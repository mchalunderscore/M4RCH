+/* Native-tested shallow saved WFI, limited to this board. No deep idle. */
+static bool t6040_saved_wfi;
+static bool saved_wfi = true;
+module_param(saved_wfi, bool, 0600);
+MODULE_PARM_DESC(saved_wfi, "J614s/T6040 software-saved shallow WFI (default on)");
+static DEFINE_PER_CPU(u64, saved_attempts);
+static DEFINE_PER_CPU(u64, saved_completed);
+static int saved_wfi_progress_get(char *buffer, const struct kernel_param *kp)
+{
+ unsigned int cpu;
+ int ret = 0;
+ for_each_online_cpu(cpu)
+  ret += scnprintf(buffer + ret, PAGE_SIZE - ret,
+                   "cpu%u attempts=%llu completed=%llu\n", cpu,
+                   READ_ONCE(per_cpu(saved_attempts, cpu)),
+                   READ_ONCE(per_cpu(saved_completed, cpu)));
+ return ret;
+}
+static const struct kernel_param_ops saved_wfi_progress_ops = {
+ .get = saved_wfi_progress_get,
+};
+module_param_cb(saved_wfi_progress, &saved_wfi_progress_ops, NULL, 0400);
 
