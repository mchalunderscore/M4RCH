 static __cpuidle int apple_enter_idle(struct cpuidle_device *dev, struct cpuidle_driver *drv, int index)
 {
+ if (t6040_saved_wfi) {
+  if (!READ_ONCE(saved_wfi)) {
+   asm volatile("nop");
+   return index;
+  }
+  if (cpu_pm_enter())
+   return -1;
+  this_cpu_inc(saved_attempts);
+  ct_cpuidle_enter();
+  apple_cpu_saved_wfi();
+  ct_cpuidle_exit();
+  cpu_pm_exit();
+  this_cpu_inc(saved_completed);
+  return index;
+ }
