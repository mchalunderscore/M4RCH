diff --git a/arch/arm/mach-apple/archsd.c b/arch/arm/mach-apple/archsd.c
--- a/arch/arm/mach-apple/archsd.c
+++ b/arch/arm/mach-apple/archsd.c
@@ -34,6 +34,27 @@
 	    fs_read(path, (ulong)buffer, 0, length, &actual) || actual != length)
 		return -1;
 	*size = length;
+	return 0;
+}
+
+/* These nodes exist only in the firmware control DT. Keep the Linux MTP
+ * binding unchanged in the separate handoff copy. */
+static int m4rch_remove_boot_keyboard(void *dt)
+{
+	const char *paths[] = {
+		"/soc/m4rch-boot-keyboard@514b34000",
+		"/soc/m4rch-boot-mtp-helper@514600000",
+	};
+	int i, node, ret;
+
+	for (i = 0; i < ARRAY_SIZE(paths); i++) {
+		node = fdt_path_offset(dt, paths[i]);
+		if (node < 0)
+			return node;
+		ret = fdt_del_node(dt, node);
+		if (ret)
+			return ret;
+	}
 	return 0;
 }
 
@@ -85,6 +106,7 @@
 	    fdt_check_full(overlay, overlay_size) ||
 	    fdt_totalsize(overlay) != overlay_size ||
 	    fdt_open_into(gd->fdt_blob, dt, DT_LIMIT) ||
+	    m4rch_remove_boot_keyboard(dt) ||
 	    fdt_overlay_apply(dt, overlay) ||
 	    fdt_node_check_compatible(dt, 0, "apple,j614s")) {
 		puts("ARCHM4: missing or invalid /dtbs/board.dtbo\n");
diff --git a/arch/arm/mach-apple/board.c b/arch/arm/mach-apple/board.c
--- a/arch/arm/mach-apple/board.c
+++ b/arch/arm/mach-apple/board.c
@@ -1243,6 +1243,24 @@
     node = ofnode_by_compatible(ofnode_null(), "apple,wdt");
     nvme_map_expected(node, 0x50836c000ULL, SZ_16K);
     nvme_early_mark(5);
+    /* Only the MTP keyboard's verified J614s windows; no broad SoC map. */
+    if (IS_ENABLED(CONFIG_APPLE_MTP_KEYB)) {
+        node = ofnode_path("/soc/m4rch-boot-mtp-helper@514600000");
+        nvme_map_expected(node, 0x514600000ULL, SZ_16K);
+        addr = ofnode_get_addr_size_index(node, 1, &size);
+        if (addr != 0x514c00000ULL || size != 0xac000)
+            panic("Unexpected J614s MTP SRAM aperture\n");
+        sd_map_add(addr, size);
+        if (ofnode_parse_phandle_with_args(node, "mboxes", "#mbox-cells", 0, 0, &spec))
+            panic("Missing MTP mailbox\n");
+        nvme_map_expected(spec.node, 0x514608000ULL, SZ_16K);
+        node = ofnode_path("/soc/m4rch-boot-keyboard@514b34000");
+        nvme_map_expected(node, 0x514b34000ULL, SZ_4K);
+        addr = ofnode_get_addr_size_index(node, 1, &size);
+        if (addr != 0x514b2c000ULL || size != SZ_4K)
+            panic("Unexpected J614s remote MTP FIFO aperture\n");
+        sd_map_add(addr, size);
+    }
     sd_map[sd_slots++].attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_INNER_SHARE;
     sd_map[sd_slots++].attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL_NC) |
         PTE_BLOCK_INNER_SHARE | PTE_BLOCK_PXN | PTE_BLOCK_UXN;
