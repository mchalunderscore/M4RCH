/*
 * J614s experimental driver testing, appended to the working SD-root board.
 * The matching drivers are packaged as modules for explicit userspace trials.
 * These are enabled hardware descriptions, not a claim of native stability.
 *
 * USB2/PD wiring derives from Wallace 55f116dd, usb2-native-right[-pd].
 * Only the right USB-C port has a T6040 host PHY implementation in that stack.
 * Its two DARTs probe at boot because the SD path needs APPLE_DART built in.
 */
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/spmi/spmi.h>

&ans_mbox { status = "okay"; };
&ans_sart { status = "okay"; };
&ans_nvme { status = "okay"; };

/* Power domains are required even with pd_ignore_unused: a cold controller
 * may start powered off. Do not reproduce Wallace's early SPMI boot hangs. */
&nub_spmi0 {
	power-domains = <&ps_nub_spmi0>;
	status = "okay";
};
&smc_rtc { status = "okay"; };
&smc_reboot { status = "okay"; };

/* Asahi common/laptop telemetry keys. Missing keys are skipped by hwmon.
 * Omit fan target/mode properties so no manual fan controls are exposed. */
&smc {
	smc_hwmon: hwmon {
		compatible = "apple,smc-hwmon";
		power-PSTR { apple,key-id = "PSTR"; label = "Total System Power"; };
		power-PDTR { apple,key-id = "PDTR"; label = "AC Input Power"; };
		power-PHPC { apple,key-id = "PHPC"; label = "Heatpipe Power"; };
		temperature-TH0x { apple,key-id = "TH0x"; label = "NAND Flash Temperature"; };
		temperature-TB0T { apple,key-id = "TB0T"; label = "Battery Hotspot"; };
		temperature-TCHP { apple,key-id = "TCHP"; label = "Charge Regulator Temp"; };
		temperature-TW0P { apple,key-id = "TW0P"; label = "WiFi/BT Module Temp"; };
		voltage-SBAV { apple,key-id = "SBAV"; label = "Battery Voltage"; };
		voltage-VD0R { apple,key-id = "VD0R"; label = "AC Input Voltage"; };
		current-ID0R { apple,key-id = "ID0R"; label = "AC Input Current"; };
		fan-F0Ac { apple,key-id = "F0Ac"; label = "Fan 1"; };
		fan-F1Ac { apple,key-id = "F1Ac"; label = "Fan 2"; };
	};
};

&soc {
	atcphy2_t6040_usb2: phy@392a90000 {
		compatible = "apple,t6040-atcphy";
		reg = <0x3 0x92a90000 0x0 0x4000>,
		      <0x3 0x92800000 0x0 0x4000>;
		reg-names = "bank0", "bank1";
		#phy-cells = <1>;
		power-domains = <&ps_atc2_usb>;
		status = "okay";
	};

	/* CPU physical address, not the raw ADT 0x309198000 bus address. */
	nub_spmi_a1: spmi@509198000 {
		compatible = "apple,t6040-spmi", "apple,spmi";
		reg = <0x5 0x09198000 0x0 0x4000>;
		power-domains = <&ps_nub_spmi_a1>;
		#address-cells = <2>;
		#size-cells = <0>;
		status = "okay";

		/* hpm2 / RID 2 / port-number 3: right port only. No role swaps. */
		hpm2: usb-pd@c {
			compatible = "usbc,sn201202x,spmi";
			reg = <0xc SPMI_USID>;
			typec_right: connector {
				compatible = "usb-c-connector";
				power-role = "source";
				data-role = "host";
			};
		};
	};
};

&usb2_dart0 { status = "okay"; };
&usb2_dart1 { status = "okay"; };
&usb_drd2 {
	/delete-property/ apple,force-device-mode;
	dr_mode = "host";
	apple,force-host-mode;
	phys = <&atcphy2_t6040_usb2 PHY_TYPE_USB2>;
	phy-names = "usb2-phy";
	status = "okay";
};
