+static int apple_connector_hdr_check(struct drm_connector *connector,
+				     struct drm_atomic_commit *commit)
+{
+	struct apple_connector *ac = to_apple_connector(connector);
+	struct platform_device *pdev = READ_ONCE(ac->dcp);
+	struct drm_connector_state *old, *new;
+	struct drm_crtc_state *crtc;
+	struct drm_plane_state *primary;
+	const struct hdr_output_metadata *metadata;
+	int ret;
+
+	if (!apple_j614s_hdr_test(pdev))
+		return 0;
+	old = drm_atomic_get_old_connector_state(commit, connector);
+	new = drm_atomic_get_new_connector_state(commit, connector);
+	if (!new || !old)
+		return -EINVAL;
+	if (new->hdr_output_metadata) {
+		if (new->hdr_output_metadata->length != sizeof(*metadata) ||
+		    (new->colorspace != DRM_MODE_COLORIMETRY_BT2020_RGB &&
+		     new->colorspace != DRM_MODE_COLORIMETRY_DEFAULT))
+			return -EINVAL;
+		metadata = new->hdr_output_metadata->data;
+		if (metadata->metadata_type != HDMI_STATIC_METADATA_TYPE1 ||
+		    metadata->hdmi_metadata_type1.metadata_type != HDMI_STATIC_METADATA_TYPE1 ||
+		    metadata->hdmi_metadata_type1.eotf != HDMI_EOTF_SMPTE_ST2084)
+			return -EINVAL;
+		if (new->crtc) {
+			crtc = drm_atomic_get_crtc_state(commit, new->crtc);
+			if (IS_ERR(crtc))
+				return PTR_ERR(crtc);
+			if (crtc->active) {
+				primary = drm_atomic_get_plane_state(commit, new->crtc->primary);
+				if (IS_ERR(primary))
+					return PTR_ERR(primary);
+				if (!primary->fb ||
+				    (primary->fb->format->format != DRM_FORMAT_XRGB2101010 &&
+				     primary->fb->format->format != DRM_FORMAT_ARGB2101010))
+					return -EINVAL;
+			}
+		}
+	}
+	if (!new->crtc || (old->colorspace == new->colorspace &&
+	    drm_connector_atomic_hdr_metadata_equal(old, new)))
+		return 0;
+	crtc = drm_atomic_get_crtc_state(commit, new->crtc);
+	if (IS_ERR(crtc))
+		return PTR_ERR(crtc);
+	/* A property-only transition still needs a new surface swap. */
+	ret = drm_atomic_add_affected_planes(commit, new->crtc);
+	return ret;
+}
