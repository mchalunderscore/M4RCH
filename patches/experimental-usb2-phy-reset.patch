From: arch-m4 project
Subject: [PATCH] phy: apple: reset and restore T6040 USB2 before DWC3 reset

Use the paired T6040 shutdown/isolation and existing host-release sequences.
The native 4522 candidate left clocks gated in phy_init: DWC3's subsequent
soft reset timed out before phy_power_on could restore them. Init must perform
both sequences before returning. Track current readiness under the PHY lock
so power_on does not retune after DWC3 reset; power_off clears it, allowing
normal replay. Exit shares the guarded shutdown to unwind failed core init
before generic power_count becomes nonzero, without double-stopping after a
successful teardown. This is not a one-shot initialization cache.

Static AppleT6040TypeCPhy evidence: kext SHA256
d0a766201c15bb01b8eeaf6617c91707562ae0c50511ebfccbd9d918acd499f3,
shutdown VA 0xfffffe0009dbe77c, size 0x92c. PORT_RESET's conditional delay is
5 ms; the final IOPause(500) is 500 ns. Preserve separate RMW order, SIG and
event-bank contents during shutdown, and APB_RESET_N. No new bank, role-swap
or repeater command is introduced. No writes occur at provider probe.

Native source-order regression: diagnostics-20261005T131004Z-38Bl1b.
This corrected callback lifecycle still needs native enumeration testing.

--- a/drivers/phy/apple/t6040-usb2.c
+++ b/drivers/phy/apple/t6040-usb2.c
@@ -4,14 +4,14 @@
  *
  * This deliberately does not share the T8103/T8122 ATC PHY compatible. T6040
  * has CIO4/TB5-era resources and a different event-bank layout. The only
- * implemented operation is the exact USB2 host sequence decoded from the
- * paired AppleT6040TypeCPhy driver.
+ * implemented operations are the USB2 host and reset/isolation sequences
+ * decoded from the paired AppleT6040TypeCPhy driver.
  *
- * The driver performs no ATC-register writes during probe. There is no paired
- * power-off/inverse sequence, so this driver intentionally provides no
- * power_off callback. The state is volatile and this driver must remain behind
- * a disabled DT node until its MMIO writes have received platform-specific
- * review.
+ * No register writes occur during probe. PHY init resets inherited state and
+ * restores host clocks before DWC3 soft reset. Power-off and exit isolate
+ * the PHY; neither operation restores arbitrary prior register contents.
+ * This remains an experimental host-only provider with no repeater, USB3,
+ * Type-C mux or firmware commands.
  */
 
 #include <dt-bindings/phy/phy.h>
@@ -28,6 +28,7 @@
 #define T6040_USB2_USBCTL		0x00
 #define T6040_USB2_USBCTL_MODE		GENMASK(2, 0)
 #define T6040_USB2_USBCTL_MODE_HOST	2
+#define T6040_USB2_USBCTL_MODE_ISOLATION	4
 
 #define T6040_USB2_CTL			0x04
 #define T6040_USB2_CTL_RESET		BIT(0)
@@ -58,6 +59,7 @@
 	struct phy *phy;
 	struct mutex lock;
 	enum phy_mode mode;
+	bool hw_active;
 };
 
 static inline void t6040_usb2_mask32(void __iomem *reg, u32 mask, u32 set)
@@ -91,22 +93,40 @@
 	return 0;
 }
 
-static int t6040_usb2_power_on(struct phy *phy)
-{
-	struct t6040_usb2_phy *tphy = phy_get_drvdata(phy);
+static void t6040_usb2_stop_locked(struct t6040_usb2_phy *tphy)
+{
+	lockdep_assert_held(&tphy->lock);
+
+	/* AppleT6040TypeCPhy::eusb2phy_shutdown(), bank 0 only.
+	 * Keep conditional PORT_RESET and every following RMW separate.
+	 * T6040 does not clear APB_RESET_N here, unlike the older ATC driver.
+	 */
+	if (!(readl(tphy->usb2 + T6040_USB2_CTL) & T6040_USB2_CTL_PORT_RESET)) {
+		t6040_usb2_set32(tphy->usb2 + T6040_USB2_CTL,
+				 T6040_USB2_CTL_PORT_RESET);
+		msleep(5);
+	}
+
+	t6040_usb2_mask32(tphy->usb2 + T6040_USB2_USBCTL,
+			  T6040_USB2_USBCTL_MODE,
+			  T6040_USB2_USBCTL_MODE_ISOLATION);
+	t6040_usb2_set32(tphy->usb2 + T6040_USB2_CTL, T6040_USB2_CTL_SIDDQ);
+	t6040_usb2_set32(tphy->usb2 + T6040_USB2_CTL, T6040_USB2_CTL_RESET);
+	t6040_usb2_set32(tphy->usb2 + T6040_USB2_MISCTUNE,
+			 T6040_USB2_MISCTUNE_APBCLK_GATE_OFF);
+	t6040_usb2_set32(tphy->usb2 + T6040_USB2_MISCTUNE,
+			 T6040_USB2_MISCTUNE_REFCLK_GATE_OFF);
+	ndelay(500);
+
+	tphy->hw_active = false;
+	dev_info(tphy->dev, "USB2 reset/isolation sequence complete\n");
+}
+
+static void t6040_usb2_start_locked(struct t6040_usb2_phy *tphy)
+{
 	u32 status;
 
-	guard(mutex)(&tphy->lock);
-
-	if (tphy->mode != PHY_MODE_USB_HOST)
-		return -EINVAL;
-
-	/*
-	 * Generic PHY power_count suppresses duplicate live power_on calls.
-	 * Replay this known sequence after a balanced off/on so a Type-C PD
-	 * repeater reset cannot leave the previous initialization cached.
-	 * There is still no inferred hardware power-off sequence.
-	 */
+	lockdep_assert_held(&tphy->lock);
 
 	/*
 	 * AppleT6040TypeCPhy::eusb2phy_init(false, false), in exact order.
@@ -154,14 +174,65 @@
 			  T6040_USB2_USBCTL_MODE,
 			  T6040_USB2_USBCTL_MODE_HOST);
 
+	tphy->hw_active = true;
 	dev_info(tphy->dev, "USB2 host sequence complete\n");
+}
+
+static int t6040_usb2_init(struct phy *phy)
+{
+	struct t6040_usb2_phy *tphy = phy_get_drvdata(phy);
+
+	guard(mutex)(&tphy->lock);
+	if (tphy->mode != PHY_MODE_USB_HOST)
+		return -EINVAL;
+
+	/* DWC3 performs its soft reset between phy_init and phy_power_on.
+	 * Restore the clocks here, before that reset waits for synchronization.
+	 */
+	t6040_usb2_stop_locked(tphy);
+	t6040_usb2_start_locked(tphy);
+	return 0;
+}
+
+static int t6040_usb2_power_on(struct phy *phy)
+{
+	struct t6040_usb2_phy *tphy = phy_get_drvdata(phy);
+
+	guard(mutex)(&tphy->lock);
+	if (tphy->mode != PHY_MODE_USB_HOST)
+		return -EINVAL;
+
+	/* init already prepared the PHY; do not retune after DWC3 soft reset.
+	 * This tracks current readiness, not a one-shot initialization flag.
+	 */
+	if (!tphy->hw_active)
+		t6040_usb2_start_locked(tphy);
+	return 0;
+}
+
+static int t6040_usb2_power_off(struct phy *phy)
+{
+	struct t6040_usb2_phy *tphy = phy_get_drvdata(phy);
+
+	guard(mutex)(&tphy->lock);
+	if (tphy->mode != PHY_MODE_USB_HOST)
+		return -EINVAL;
+
+	/* phy_exit also calls this after failed core init, before power_on.
+	 * Successful core teardown calls power_off then exit: stop only once.
+	 */
+	if (tphy->hw_active)
+		t6040_usb2_stop_locked(tphy);
 	return 0;
 }
 
 static const struct phy_ops t6040_usb2_phy_ops = {
 	.owner = THIS_MODULE,
+	.init = t6040_usb2_init,
+	.exit = t6040_usb2_power_off,
 	.set_mode = t6040_usb2_set_mode,
 	.power_on = t6040_usb2_power_on,
+	.power_off = t6040_usb2_power_off,
 };
 
 static struct phy *t6040_usb2_xlate(struct device *dev,
