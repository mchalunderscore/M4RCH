+/* Only the existing command/status apertures are sampled. No control writes. */
+static unsigned int apple_cpufreq_snapshot_khz(struct cpufreq_policy *policy,
+					      unsigned int state)
+{
+	struct cpufreq_frequency_table *p;
+
+	cpufreq_for_each_valid_entry(p, policy->freq_table)
+		if (p->driver_data == state)
+			return p->frequency;
+	return 0;
+}
+
+static int apple_cpufreq_snapshot_show(struct seq_file *s, void *unused)
+{
+	struct apple_cpu_priv *priv = s->private;
+	struct cpufreq_policy *policy = priv->policy;
+	const struct apple_soc_cpufreq_info *info = priv->info;
+	struct cpufreq_frequency_table *p;
+	u64 cmd, cmd_begin, cmd_end, status_begin = 0, status_end = 0;
+	u64 policy_begin, policy_end;
+	u32 status = 0;
+	unsigned int cmd_state, get_state, policy_cur;
+	bool first = true;
+
+	/*
+	 * debugfs_create_file's protected fops pin active open/read/llseek calls.
+	 * exit removes the directory and drains them BEFORE freeing policy data
+	 * or MMIO. Do not take policy/hotplug locks here: exit may own those locks.
+	 * single_release only frees seq_file state, even for an fd held past exit.
+	 * Reads are ordered but successive; timestamps are not an atomic snapshot.
+	 */
+	cmd_begin = ktime_get_boottime_ns();
+	cmd = readq(priv->reg_base + APPLE_DVFS_CMD);
+	cmd_end = ktime_get_boottime_ns();
+	cmd_state = (cmd & info->ps1_mask) >> info->ps1_shift;
+	if (info->cur_pstate_mask) {
+		status_begin = ktime_get_boottime_ns();
+		status = readl(priv->reg_base + APPLE_DVFS_STATUS);
+		status_end = ktime_get_boottime_ns();
+		get_state = (status & info->cur_pstate_mask) >> info->cur_pstate_shift;
+	} else {
+		/* Match get_rate's fallback, without touching an unknown status layout. */
+		get_state = FIELD_GET(APPLE_DVFS_CMD_PS1, cmd);
+	}
+	policy_begin = ktime_get_boottime_ns();
+	policy_cur = READ_ONCE(policy->cur);
+	policy_end = ktime_get_boottime_ns();
+
+	seq_printf(s, "{\"schema\":1,\"atomic\":false,\"policy_cpu\":%u,"
+		   "\"init_cpus\":\"%*pbl\",\"compatible\":\"%s\","
+		   "\"max_pstate\":%llu,\"has_ps2\":%s,",
+		   policy->cpu, cpumask_pr_args(&priv->init_cpus), priv->compatible,
+		   info->max_pstate, info->has_ps2 ? "true" : "false");
+	seq_printf(s, "\"command\":{\"offset\":32,\"width\":64,\"raw\":\"0x%016llx\","
+		   "\"begin_ns\":%llu,\"end_ns\":%llu,\"mask\":\"0x%llx\","
+		   "\"shift\":%llu,\"state\":%u,\"frequency_khz\":%u,"
+		   "\"busy\":%s,\"set\":%s},",
+		   cmd, cmd_begin, cmd_end, info->ps1_mask, info->ps1_shift,
+		   cmd_state, apple_cpufreq_snapshot_khz(policy, cmd_state),
+		   cmd & APPLE_DVFS_CMD_BUSY ? "true" : "false",
+		   cmd & APPLE_DVFS_CMD_SET ? "true" : "false");
+	seq_printf(s, "\"status\":{\"available\":%s,\"offset\":80,\"width\":32,"
+		   "\"raw\":\"0x%08x\",\"begin_ns\":%llu,\"end_ns\":%llu,"
+		   "\"mask\":\"0x%llx\",\"shift\":%llu},"
+		   "\"get_rate_state\":%u,\"get_rate_khz\":%u,"
+		   "\"policy_cur_khz\":%u,\"policy_begin_ns\":%llu,"
+		   "\"policy_end_ns\":%llu,\"opps\":[",
+		   info->cur_pstate_mask ? "true" : "false", status,
+		   status_begin, status_end, info->cur_pstate_mask, info->cur_pstate_shift,
+		   get_state, apple_cpufreq_snapshot_khz(policy, get_state),
+		   policy_cur, policy_begin, policy_end);
+	cpufreq_for_each_valid_entry(p, policy->freq_table) {
+		seq_printf(s, "%s{\"state\":%u,\"frequency_khz\":%u,\"flags\":%u}",
+			   first ? "" : ",", p->driver_data, p->frequency, p->flags);
+		first = false;
+	}
+	seq_puts(s, "]}\n");
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(apple_cpufreq_snapshot);
+
+static void apple_cpufreq_debug_init(struct apple_cpu_priv *priv)
+{
+	char name[32];
+
+	if (IS_ERR_OR_NULL(apple_cpufreq_debug_root))
+		return;
+	snprintf(name, sizeof(name), "policy%u", priv->policy->cpu);
+	priv->debug_dir = debugfs_create_dir(name, apple_cpufreq_debug_root);
+	if (IS_ERR_OR_NULL(priv->debug_dir))
+		return;
+	debugfs_create_file("snapshot", 0400, priv->debug_dir, priv,
+			    &apple_cpufreq_snapshot_fops);
+}
