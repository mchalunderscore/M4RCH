From: arch-m4 project
Subject: [PATCH] nvme: check the J614s ANS handoff before advertising it to Linux

Apply after the five pinned Asahi NVMe changes through 53f8ee9b54ba.
Full initialization adopts iBoot's live ANS before a checked shutdown.
Constrain all MMIO to the captured J614s board and aperture addresses.
The optional UEFI hook publishes a runtime marker only on success;
initialization, queue deletion, controller shutdown/disable and RTKit
sleep failures all refuse the next-stage handoff. Keep allocations alive
on failure rather than freeing memory a coprocessor might still use.
No namespace read, write, flush or format commands are added.

--- a/src/nvme.c
+++ b/src/nvme.c
@@ -7,6 +7,7 @@
 #include "pmgr.h"
 #include "rtkit.h"
 #include "sart.h"
+#include "soc.h"
 #include "string.h"
 #include "utils.h"
 
@@ -308,11 +309,24 @@
         return true;
     }
 
+    /* This optional handoff has only been reviewed for the J614s board. */
+    if (chip_id != T6040 || board_id != 4) {
+        printf("nvme: experimental handoff requires J614s/T6040 board 4\n");
+        return false;
+    }
+
     int adt_path[8];
     int node = adt_path_offset_trace(adt, "/arm-io/ans", adt_path);
     if (node < 0) {
         printf("nvme: Error getting NVMe node /arm-io/ans\n");
         return NULL;
+    }
+
+    u32 reg_len = 0;
+    if (!adt_getprop(adt, node, "reg", &reg_len) || reg_len != 10 * 16 ||
+        !adt_get_property(adt, node, "nvme-secure-bar")) {
+        printf("nvme: unexpected J614s ANS register layout\n");
+        return false;
     }
 
     if (adt_get_property(adt, node, "nvme-secure-bar"))
@@ -335,6 +349,11 @@
         }
     } else {
         nvme_base = nvmmu_base;
+    }
+
+    if (nvmmu_base != 0x40dcc0000 || nvme_base != 0x44dcc0000) {
+        printf("nvme: unexpected J614s ANS address translation\n");
+        return false;
     }
 
     u32 cg;
@@ -510,44 +529,75 @@
     pmgr_reset(nvme_die, "ANS2");
 }
 
-void nvme_shutdown(void)
-{
-    if (!nvme_initialized) {
-        // nvme_ensure_shutdown();
-        return;
-    }
-
+/* Only mark the handoff after every observable shutdown step completed. */
+static bool nvme_shutdown_checked(void)
+{
     struct nvme_command cmd;
 
     memset(&cmd, 0, sizeof(cmd));
     cmd.opcode = NVME_ADMIN_CMD_DELETE_SQ;
-    cmd.cdw10 = 1; // sq id
-    if (!nvme_exec_command(&adminq, &cmd, NULL))
+    cmd.cdw10 = 1;
+    if (!nvme_exec_command(&adminq, &cmd, NULL)) {
         printf("nvme: delete sq command failed\n");
+        return false;
+    }
 
     memset(&cmd, 0, sizeof(cmd));
     cmd.opcode = NVME_ADMIN_CMD_DELETE_CQ;
-    cmd.cdw10 = 1; // cq id
-    if (!nvme_exec_command(&adminq, &cmd, NULL))
+    cmd.cdw10 = 1;
+    if (!nvme_exec_command(&adminq, &cmd, NULL)) {
         printf("nvme: delete cq command failed\n");
-
-    if (!nvme_ctrl_shutdown())
+        return false;
+    }
+    if (!nvme_ctrl_shutdown()) {
         printf("nvme: timeout while waiting for controller shutdown\n");
-    if (!nvme_ctrl_disable())
+        return false;
+    }
+    if (!nvme_ctrl_disable()) {
         printf("nvme: timeout while waiting for CSTS.RDY to clear\n");
-
-    rtkit_sleep(nvme_rtkit);
-    // Some machines call this ANS, some ANS2...
-    pmgr_reset(nvme_die, "ANS");
-    pmgr_reset(nvme_die, "ANS2");
+        return false;
+    }
+    /* This pinned rtkit_sleep returns zero on success despite its bool type. */
+    if (rtkit_sleep(nvme_rtkit) || asc_cpu_running(nvme_asc)) {
+        printf("nvme: ANS did not enter the stopped state\n");
+        return false;
+    }
+    /* ANS and ANS2 are alternative PMGR names, so one lookup may fail. */
+    int ans_reset = pmgr_reset(nvme_die, "ANS");
+    int ans2_reset = pmgr_reset(nvme_die, "ANS2");
+    if (ans_reset && ans2_reset) {
+        printf("nvme: cannot reset either ANS power domain\n");
+        return false;
+    }
     rtkit_free(nvme_rtkit);
     sart_free(nvme_sart);
     asc_free(nvme_asc);
     free_queue(&ioq);
     free_queue(&adminq);
     nvme_initialized = false;
-
     printf("nvme: shutdown done\n");
+    return true;
+}
+
+static bool nvme_handoff_done;
+
+bool nvme_prepare_handoff(void)
+{
+    if (nvme_handoff_done)
+        return true;
+    printf("arch-m4 NVMe handoff v2: initializing ANS before UEFI\n");
+    if (!nvme_init() || !nvme_shutdown_checked())
+        return false;
+    nvme_handoff_done = true;
+    return true;
+}
+
+void nvme_shutdown(void)
+{
+    /* Also preserve the legacy experimental-nvme profile's main() handoff.
+     * The UEFI hook already completed this; never initialize ANS twice. */
+    if (!nvme_prepare_handoff())
+        panic("arch-m4 NVMe handoff failed; refusing next-stage handoff\n");
 }
 
 bool nvme_flush(u32 nsid)
--- a/src/nvme.h
+++ b/src/nvme.h
@@ -7,6 +7,7 @@
 
 bool nvme_init(void);
 void nvme_shutdown(void);
+bool nvme_prepare_handoff(void);
 
 bool nvme_flush(u32 nsid);
 bool nvme_read(u32 nsid, u64 lba, void *buffer);
