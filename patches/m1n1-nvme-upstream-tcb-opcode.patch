From 0e77db5bf051274362bdf18540caa0f258aaac66 Mon Sep 17 00:00:00 2001
From: Sven Peter <sven@svenpeter.dev>
Date: Thu, 6 Aug 2026 17:10:05 +0200
Subject: [PATCH] nvme: Never set the opcode in the NVMMU TCB

macOS always writes zero there so let's mirror that.

Signed-off-by: Sven Peter <sven@svenpeter.dev>
---
 src/nvme.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/nvme.c b/src/nvme.c
index 1bb3e8be0..f90b7799c 100644
--- a/src/nvme.c
+++ b/src/nvme.c
@@ -223,7 +223,7 @@ static bool nvme_exec_command(struct nvme_queue *q, struct nvme_command *cmd, u6
     queue_cmd->tag = tag;
 
     memset(tcb, 0, sizeof(*tcb));
-    tcb->opcode = queue_cmd->opcode;
+    tcb->opcode = 0;
     if (!queue_cmd->prp1)
         tcb->dma_flags = 0;
     else if (queue_cmd->opcode & 1)
