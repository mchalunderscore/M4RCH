CONFIG_ARM=y
CONFIG_ARCH_APPLE=y
CONFIG_APPLE_NOIO=y
CONFIG_MISC=y
CONFIG_DEFAULT_DEVICE_TREE="t8103-j274"
CONFIG_SYS_BOOTM_LEN=0x8000000
CONFIG_SYS_LOAD_ADDR=0x0
CONFIG_BOOTDELAY=0
CONFIG_BOOTCOMMAND="archsd; echo SD boot stopped - photograph the screen and return to macOS"
CONFIG_USE_BOOTCOMMAND=y
CONFIG_SYS_CBSIZE=512
CONFIG_SYS_PBSIZE=532
# CONFIG_DISPLAY_CPUINFO is not set
CONFIG_DISPLAY_BOARDINFO_LATE=y
CONFIG_BOARD_LATE_INIT=y
CONFIG_NO_NET=y
CONFIG_SYS_64BIT_LBA=y
# CONFIG_ENV_IS_IN_FAT is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_CMD_SAVEENV is not set
# CONFIG_CMD_GPT is not set
CONFIG_PCI=y
CONFIG_PCIE_APPLE=y
CONFIG_PCI_PNP=y
# Probe the SD reader from archsd, after framebuffer output is available.
# CONFIG_PCI_INIT_R is not set
CONFIG_DM_GPIO=y
CONFIG_MMC=y
CONFIG_DM_MMC=y
CONFIG_DM_DEVICE_REMOVE=y
# Keep MMC shutdown limited to unregistering the card poll; UHS mode changes
# would issue additional card commands during the final firmware handoff.
# CONFIG_MMC_UHS_SUPPORT is not set
# CONFIG_MMC_HS200_SUPPORT is not set
# CONFIG_MMC_HS400_SUPPORT is not set
# CONFIG_MMC_HS400_ES_SUPPORT is not set
CONFIG_MMC_PCI=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_IO_ACCESSORS=y
# CONFIG_MMC_SDHCI_SDMA is not set
# CONFIG_MMC_SDHCI_ADMA is not set
# CONFIG_MMC_WRITE is not set
# CONFIG_MMC_HW_PARTITIONING is not set
CONFIG_SYS_MMC_MAX_BLK_COUNT=128
# CONFIG_CMD_MMC is not set
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
# CONFIG_FAT_WRITE is not set
CONFIG_EFI_PARTITION=y
# CONFIG_FIT is not set
# CONFIG_CMD_BOOTI is not set
CONFIG_OF_LIBFDT_OVERLAY=y
CONFIG_CLK=y
CONFIG_WDT=y
CONFIG_WDT_APPLE=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=20000
# A framebuffer-only loader has no UART driver. The U-Boot default otherwise
# panics during serial_init(), before the framebuffer console is available.
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set
# CONFIG_S5P_SERIAL is not set
CONFIG_VIDEO_FONT_16X32=y
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_NO_FB_CLEAR=y
CONFIG_VIDEO_SIMPLE=y
CONFIG_EFI_LOADER=y
CONFIG_EFI_BINARY_EXEC=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BINARY=y
# Boot the removable-media path directly, without BootOrder or NVRAM writes.
CONFIG_EFI_VARIABLE_NO_STORE=y
# CONFIG_EFI_VARIABLE_FILE_STORE is not set
# CONFIG_EFI_BOOTMGR is not set
# CONFIG_CMD_BOOTEFI_BOOTMGR is not set
# CONFIG_EFI_CAPSULE_ON_DISK is not set
# CONFIG_EFI_RUNTIME_UPDATE_CAPSULE is not set
# CONFIG_EFI_SECURE_BOOT is not set
CONFIG_EFI_DT_FIXUP=y
CONFIG_EFI_LOAD_FILE2_INITRD=y
CONFIG_VIDEO_ANSI=y
# CONFIG_FAT_RENAME is not set
# CONFIG_SMBIOS is not set
# CONFIG_USB is not set
# CONFIG_NVME is not set
# CONFIG_IOMMU is not set
# CONFIG_BOOTSTD is not set
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
