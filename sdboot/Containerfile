FROM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git python3 python3-pil build-essential bc bison flex \
    libssl-dev libelf-dev device-tree-compiler cpio kmod rsync xz-utils \
    imagemagick rustc cargo rust-src busybox-static e2fsprogs exfatprogs \
    libarchive-tools file kbd gnupg qemu-system-arm qemu-efi-aarch64 zstd \
    mtools dosfstools gdisk fdisk swig python3-dev python3-setuptools libgnutls28-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
