#!/usr/bin/bash
build() {
    local applet tool
    for applet in $(/usr/lib/initcpio/busybox --list); do
        add_symlink "/usr/bin/$applet" busybox
    done
    add_binary /usr/lib/initcpio/busybox /bin/busybox
    for tool in blkid e2fsck seq switch_root mount setsid tr; do add_binary "$tool" "/sbin/$tool"; done
    for applet in dev proc sys run newroot tmp; do add_dir "/$applet"; done
    add_file /etc/m4rch-nvme/init /init 755
    add_file /etc/m4rch-nvme/root.conf /etc/nvme-root.conf
    printf "KERNEL_RELEASE='%s'\n" "$KERNELVERSION" >>"$BUILDROOT/etc/nvme-root.conf"
}
help() { echo 'Explicit NVMe ext4 root; no disk-growth operations.'; }
