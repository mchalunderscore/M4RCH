+            ("bank0", &self.operand, 0, 0x1e000),
+            ("between", &self.operand, 0x1e000, 0x1e400),
+            ("bank1", &self.operand, 0x1e400, 0x3c400),
+            ("tails", &self.operand, 0x3c400, 0x3d800),
+            ("remaining", &self.operand, 0x3d800, 0x44000),
+        ] {
+            match m4_buffer_summary(obj, start, end) {
+                Ok((nonzero, digest)) => pr_info!(
+                    "m4gpu: phase={} pid={} ctx={} qid={} seq={} region={} words={} nonzero={} digest={:016x}\n",
+                    phase, target, context.id(), qid, seq, name, (end-start)/4, nonzero, digest),
+                Err(_) => pr_warn!("m4gpu: buffer observation failed\n"),
+            }
+        }
+    }
