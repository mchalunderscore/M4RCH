+// Observation only: never print buffer contents or addresses. The caller must
+// have proved the queue idle; a fingerprint does not identify a context save.
+fn m4_buffer_summary(obj: &KernelObject, start: usize, end: usize) -> Result<(u32, u64)> {
+    if start > end || end > obj.size() || start % 4 != 0 || end % 4 != 0 {
+        return Err(EINVAL);
+    }
+    let mut nonzero = 0u32;
+    let mut digest = 0xcbf29ce484222325u64;
+    for offset in (start..end).step_by(4) {
+        let [word] = obj.read_words::<1>(offset)?;
+        nonzero += u32::from(word != 0);
+        digest = (digest ^ u64::from(word)).wrapping_mul(0x100000001b3);
+    }
+    Ok((nonzero, digest))
+}
