+    fn m4_context_observe(&self, phase: &str, qid: u8, context: &Context, seq: u64) {
+        // SAFETY: C getter reads an integer module parameter using READ_ONCE.
+        let target = unsafe { asahi_g17_m4_context_pid() };
+        if target == 0 || target != context.owner_pid() { return; }
