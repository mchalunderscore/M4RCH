diff --git a/Documentation/devicetree/bindings/power/apple,t8140-pmp-report.yaml b/Documentation/devicetree/bindings/power/apple,t8140-pmp-report.yaml
--- a/Documentation/devicetree/bindings/power/apple,t8140-pmp-report.yaml
+++ b/Documentation/devicetree/bindings/power/apple,t8140-pmp-report.yaml
@@ -93,6 +93,13 @@ patternProperties:
           holds this entry's device ID, instead of by reg. Only valid on a
           report whose PMP the host starts.
 
+      apple,irq-safe:
+        type: boolean
+        description:
+          The entry is the parent of IRQ-safe PMGR power states and is
+          switched with interrupts disabled. Setting the state takes a
+          spinlock and polls the acknowledgment atomically.
+
     required:
       - compatible
       - reg
diff --git a/drivers/pmdomain/apple/pmp-report.c b/drivers/pmdomain/apple/pmp-report.c
--- a/drivers/pmdomain/apple/pmp-report.c
+++ b/drivers/pmdomain/apple/pmp-report.c
@@ -1473,6 +1473,13 @@ static int apple_pmp_report_entry_probe(struct platform_device *pdev)
 
 	ent->genpd.power_on = apple_pmp_report_entry_power_on;
 	ent->genpd.power_off = apple_pmp_report_entry_power_off;
+	/*
+	 * An entry that is the parent of PMGR power states (which are IRQ safe)
+	 * must be IRQ safe too. Setting the state takes a spinlock and polls
+	 * the acknowledgment atomically, so it may be called with IRQs off.
+	 */
+	if (of_property_read_bool(node, "apple,irq-safe"))
+		ent->genpd.flags |= GENPD_FLAG_IRQ_SAFE;
 
 	ret = pm_genpd_init(&ent->genpd, NULL, true);
 	if (ret) {
