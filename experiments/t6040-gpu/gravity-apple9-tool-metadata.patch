+/* Authored minimal EOT candidate, following the pinned Gallium tile-store path. */
+static nir_shader *
+tile_store_shader(void)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_FRAGMENT, &agx_nir_options, "m4rch_tile_store_candidate");
+   b.shader->info.num_images = 1;
+   nir_def *group = nir_load_workgroup_id(&b);
+   nir_def *xy = nir_vec2(&b, nir_imul_imm(&b, nir_channel(&b, group, 0), 32),
+                             nir_imul_imm(&b, nir_channel(&b, group, 1), 32));
+   nir_image_store_block_agx(&b, nir_imm_int(&b, 0), nir_imm_int(&b, 0),
+                            nir_pad_vec4(&b, xy),
+                            .format = PIPE_FORMAT_R8G8B8A8_UNORM,
+                            .image_dim = GLSL_SAMPLER_DIM_2D);
+   return b.shader;
+}
