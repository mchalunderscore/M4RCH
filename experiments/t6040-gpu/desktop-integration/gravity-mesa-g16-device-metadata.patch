+/* Decode the kernel's complete identity before creating a VM. Logical slots
+ * are not the popcount of enabled cores. Do not fill absent masks from a
+ * captured board or accept nonzero masks outside the advertised topology. */
+static inline bool
+agx_g16_decode_device(unsigned chip, unsigned variant, unsigned dies,
+                      unsigned clusters, unsigned slots_per_cluster,
+                      const uint64_t *masks, unsigned mask_count,
+                      struct agx_g16_device_info *out)
+{
+   if (!masks || !out || dies != 1 || slots_per_cluster != 10 ||
+       mask_count < clusters)
+      return false;
+
+   enum agx_g16_model model = AGX_G16_UNKNOWN;
+   if (chip == 0x8132 && variant == 'G' && clusters == 1)
+      model = AGX_G16_G;
+   else if (chip == 0x6040 && variant == 'S' && clusters == 2)
+      model = AGX_G16_S;
+   else
+      return false;
+
+   struct agx_g16_device_info info = {
+      .model = model, .chip = chip, .variant = variant, .dies = dies,
+      .clusters = clusters, .slots_per_cluster = slots_per_cluster,
+   };
+   for (unsigned i = 0; i < mask_count; ++i) {
+      if (i >= clusters) {
+         if (masks[i])
+            return false;
+         continue;
+      }
+      if (!masks[i] || (masks[i] & ~UINT64_C(0x3ff)))
+         return false;
+      info.core_masks[i] = masks[i];
+      for (uint64_t bits = masks[i]; bits; bits &= bits - 1)
+         ++info.enabled_cores;
+   }
+   *out = info;
+   return true;
+}
