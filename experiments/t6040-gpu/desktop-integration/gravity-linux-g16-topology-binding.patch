 impl Profile {
+    pub(crate) fn initialization(&self) -> Option<Initialization> {
+        if self.normal_startup_implemented && self.chip == 0x8132
+            && self.variant == Variant::G && self.slots_per_cluster == 10
+            && self.masks.len() == 1 && self.register_bytes == 0x4000000 {
+            Some(Initialization::T8132)
+        } else {
+            None
+        }
+    }
+
+    /// Do not substitute the captured board masks when device input is absent.
+    /// Captured masks remain probe metadata; normal DRM identity uses the
+    /// masks explicitly bound by its initialization implementation.
+    pub(crate) fn topology(&self, masks: &[u32]) -> Option<Topology> {
+        let clusters = match (self.chip, self.variant) {
+            (0x8132, Variant::G) => 1,
+            (0x6040, Variant::S) => 2,
+            _ => return None,
+        };
+        if self.slots_per_cluster != 10 || self.masks.len() != clusters
+            || masks.len() != clusters {
+            return None;
+        }
+        let valid = (1u32 << self.slots_per_cluster) - 1;
+        let mut core_masks = [0u64; 2];
+        for (i, mask) in masks.iter().enumerate() {
+            if *mask == 0 || *mask & !valid != 0 {
+                return None;
+            }
+            core_masks[i] = u64::from(*mask);
+        }
+        Some(Topology {
+            chip: self.chip, generation: 16,
+            variant: match self.variant { Variant::G => b'G', Variant::S => b'S' } as u32,
+            dies: 1, clusters: clusters as u32,
+            slots_per_cluster: self.slots_per_cluster.into(), core_masks,
+        })
+    }
+
     pub(crate) fn enabled_cores(&self) -> Option<u32> {
         let valid = (1u32.checked_shl(self.slots_per_cluster.into())?).checked_sub(1)?;
         if self.masks.is_empty() || self.masks.iter().any(|m| *m == 0 || *m & !valid != 0) { return None; }
