+// SPDX-License-Identifier: GPL-2.0-only
+/* J614s warm SEP: reserve the SEPFW descriptor around existing no-map ASC
+ * ranges. The iBoot descriptor overlaps live DCP OS logs. The warm SEP path
+ * does not consume the SEPFW memory-region; retain every byte as reserved,
+ * preserving existing no-map nodes and their phandles for their consumers.
+ */
+struct sep_interval { u64 start, end; };
+
+static int j614s_sep_reservations(void *dt)
+{
+	struct sep_interval spans[64], tmp;
+	u64 start, end, cursor;
+	const fdt64_t *reg;
+	const fdt32_t *ref;
+	const char *name;
+	u32 phandle;
+	int parent, sep, fw, node, len, count = 0, i, j, ret;
+
+	sep = fdt_path_offset(dt, "/sep@406600000");
+	fw = fdt_path_offset(dt, "/reserved-memory/sep-firmware");
+	if (fw == -FDT_ERR_NOTFOUND)
+		return 0;
+	if (sep < 0 || fw < 0 || fdt_node_check_compatible(dt, sep, "apple,sep") ||
+	    fdt_node_check_compatible(dt, fw, "apple,asc-mem") ||
+	    fdt_getprop(dt, fw, "no-map", NULL))
+		return BAD;
+	reg = fdt_getprop(dt, fw, "reg", &len);
+	if (!reg || len != 16)
+		return BAD;
+	start = fdt64_ld(reg); end = start + fdt64_ld(reg + 1);
+	if (!start || end <= start || (start & 0x3fff) || (end & 0x3fff))
+		return BAD;
+	phandle = fdt_get_phandle(dt, fw);
+	ref = fdt_getprop(dt, sep, "memory-region", &len);
+	if (!phandle || !ref || len != 4 || fdt32_ld(ref) != phandle)
+		return BAD;
+	name = fdt_getprop(dt, sep, "memory-region-names", &len);
+	if (!name || len != 6 || memcmp(name, "sepfw", 6))
+		return BAD;
+	parent = fdt_path_offset(dt, "/reserved-memory");
+	if (parent < 0)
+		return BAD;
+	fdt_for_each_subnode(node, dt, parent) {
+		u64 a, b;
+		if (node == fw)
+			continue;
+		reg = fdt_getprop(dt, node, "reg", &len);
+		if (!reg)
+			continue;
+		if (len != 16)
+			return BAD;
+		a = fdt64_ld(reg); b = a + fdt64_ld(reg + 1);
+		if (b <= a)
+			return BAD;
+		if (a >= end || b <= start)
+			continue;
+		if (!fdt_getprop(dt, node, "no-map", NULL) ||
+		    (fdt_node_check_compatible(dt, node, "apple,asc-mem") &&
+		     !fdt_getprop(dt, node, "apple,dcp-os-log", NULL)) || count == 64)
+			return BAD;
+		spans[count++] = (struct sep_interval){a < start ? start : a, b > end ? end : b};
+	}
+	if (!count)
+		return 0;
+	for (i = 1; i < count; i++)
+		for (j = i; j > 0 && spans[j].start < spans[j-1].start; j--) {
+			tmp = spans[j]; spans[j] = spans[j-1]; spans[j-1] = tmp;
+		}
+	/* Existing reservations must themselves be disjoint. */
+	for (i = 1; i < count; i++)
+		if (spans[i].start < spans[i-1].end)
+			return BAD;
+	CHECK(fdt_delprop(dt, sep, "memory-region"));
+	sep = fdt_path_offset(dt, "/sep@406600000");
+	CHECK(fdt_delprop(dt, sep, "memory-region-names"));
+	fw = fdt_path_offset(dt, "/reserved-memory/sep-firmware");
+	CHECK(fdt_del_node(dt, fw));
+	cursor = start;
+	for (i = 0; i <= count; i++) {
+		u64 limit = i == count ? end : spans[i].start;
+		if (cursor < limit) {
+			char path[64];
+			fdt64_t cells[2] = { cpu_to_fdt64(cursor), cpu_to_fdt64(limit - cursor) };
+			parent = fdt_path_offset(dt, "/reserved-memory");
+			snprintf(path, sizeof(path), "sep-retained@%llx", (unsigned long long)cursor);
+			ret = fdt_add_subnode(dt, parent, path);
+			if (ret < 0) return ret;
+			CHECK(fdt_setprop(dt, ret, "reg", cells, sizeof(cells)));
+		}
+		if (i < count) cursor = spans[i].end;
+	}
+	printf("J614s: retained warm SEP range around %d existing no-map regions\n", count);
+	return 0;
+}
