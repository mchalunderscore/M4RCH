#!/bin/sh
prefix=/opt/m4rch-aurora-test2
lib=$prefix/lib/aarch64-linux-gnu
unset LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER MESA_LOADER_DRIVER_OVERRIDE KWIN_COMPOSE
export LD_LIBRARY_PATH="$lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LIBGL_DRIVERS_PATH="$lib/dri"
export GBM_BACKENDS_PATH="$lib/gbm"
export __EGL_VENDOR_LIBRARY_FILENAMES="$prefix/share/glvnd/egl_vendor.d/50_mesa.json"
export VK_DRIVER_FILES="$prefix/share/vulkan/icd.d/asahi_icd.aarch64.json"
export VK_ICD_FILENAMES="$VK_DRIVER_FILES"
exec "$@"
