index 000000000..621362101
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6040-cpufreq.dtsi
@@ -0,0 +1,253 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * T6040 cluster cpufreq + OPP tables (tickets 035/006) — include after a
+ * J614s base DTS. Cluster DVFS bases are m1n1-proven; OPP freqs/levels decoded
+ * from the live J614s ADT /arm-io/pmgr/voltage-states{1,5,13}-sram (word0 =
+ * kHz): E 7 pstates 1020-2592 MHz, P 19 pstates 1260-4512 MHz. Verified live
+ * 2026-07-30: E and P0 policies register and transition both directions
+ * (needs the freq-mult-overflow brcmfmac^Wcpufreq patch for any table with
+ * entries above 4294967 kHz).
+ */
+
+&soc {
+	cpufreq_e: cpufreq@210e20000 {
+		compatible = "apple,t8112-cluster-cpufreq";
+		reg = <0x2 0x10e20000 0 0x1000>;
+		#performance-domain-cells = <0>;
+	};
+	cpufreq_p0: cpufreq@211e20000 {
+		compatible = "apple,t8112-cluster-cpufreq";
+		reg = <0x2 0x11e20000 0 0x1000>;
+		#performance-domain-cells = <0>;
+	};
+	cpufreq_p1: cpufreq@212e20000 {
+		compatible = "apple,t8112-cluster-cpufreq";
+		reg = <0x2 0x12e20000 0 0x1000>;
+		#performance-domain-cells = <0>;
+	};
+};
+
+/ {
+
+	sawtooth_opp: opp-table-0 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp01 {
+			opp-hz = /bits/ 64 <1020000000>;
+			opp-level = <1>;
+		};
+		opp02 {
+			opp-hz = /bits/ 64 <1404000000>;
+			opp-level = <2>;
+		};
+		opp03 {
+			opp-hz = /bits/ 64 <1788000000>;
+			opp-level = <3>;
+		};
+		opp04 {
+			opp-hz = /bits/ 64 <2112000000>;
+			opp-level = <4>;
+		};
+		opp05 {
+			opp-hz = /bits/ 64 <2352000000>;
+			opp-level = <5>;
+		};
+		opp06 {
+			opp-hz = /bits/ 64 <2532000000>;
+			opp-level = <6>;
+		};
+		opp07 {
+			opp-hz = /bits/ 64 <2592000000>;
+			opp-level = <7>;
+		};
+	};
+
+	everest_opp: opp-table-1 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp01 {
+			opp-hz = /bits/ 64 <1260000000>;
+			opp-level = <1>;
+		};
+		opp02 {
+			opp-hz = /bits/ 64 <1512000000>;
+			opp-level = <2>;
+		};
+		opp03 {
+			opp-hz = /bits/ 64 <1800000000>;
+			opp-level = <3>;
+		};
+		opp04 {
+			opp-hz = /bits/ 64 <2088000000>;
+			opp-level = <4>;
+		};
+		opp05 {
+			opp-hz = /bits/ 64 <2352000000>;
+			opp-level = <5>;
+		};
+		opp06 {
+			opp-hz = /bits/ 64 <2616000000>;
+			opp-level = <6>;
+		};
+		opp07 {
+			opp-hz = /bits/ 64 <2868000000>;
+			opp-level = <7>;
+		};
+		opp08 {
+			opp-hz = /bits/ 64 <3096000000>;
+			opp-level = <8>;
+		};
+		opp09 {
+			opp-hz = /bits/ 64 <3300000000>;
+			opp-level = <9>;
+		};
+		opp10 {
+			opp-hz = /bits/ 64 <3468000000>;
+			opp-level = <10>;
+		};
+		opp11 {
+			opp-hz = /bits/ 64 <3624000000>;
+			opp-level = <11>;
+		};
+		opp12 {
+			opp-hz = /bits/ 64 <3756000000>;
+			opp-level = <12>;
+		};
+		opp13 {
+			opp-hz = /bits/ 64 <3852000000>;
+			opp-level = <13>;
+		};
+		opp14 {
+			opp-hz = /bits/ 64 <3924000000>;
+			opp-level = <14>;
+		};
+		opp15 {
+			opp-hz = /bits/ 64 <3996000000>;
+			opp-level = <15>;
+		};
+		opp16 {
+			opp-hz = /bits/ 64 <4044000000>;
+			opp-level = <16>;
+		};
+		opp17 {
+			opp-hz = /bits/ 64 <4104000000>;
+			opp-level = <17>;
+		};
+		opp18 {
+			opp-hz = /bits/ 64 <4416000000>;
+			opp-level = <18>;
+		};
+		opp19 {
+			opp-hz = /bits/ 64 <4512000000>;
+			opp-level = <19>;
+		};
+	};
+	/*
+	 * P1 gets its OWN operating-points-v2 node even though its frequencies are
+	 * identical to P0's: `opp-shared` declares one clock/voltage domain per
+	 * table, and the two P clusters have separate performance-domains. Kept on
+	 * DT-semantics grounds only. NOTE the missing-P-policy failure this split
+	 * was once believed to fix was actually the 32-bit `frequency * 1000`
+	 * overflow in apple-soc-cpufreq (patches/
+	 * t6040-apple-cpufreq-freq-mult-overflow.patch, found 2026-07-30); the
+	 * split alone measurably changed nothing.
+	 */
+	everest_opp2: opp-table-2 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp01 {
+			opp-hz = /bits/ 64 <1260000000>;
+			opp-level = <1>;
+		};
+		opp02 {
+			opp-hz = /bits/ 64 <1512000000>;
+			opp-level = <2>;
+		};
+		opp03 {
+			opp-hz = /bits/ 64 <1800000000>;
+			opp-level = <3>;
+		};
+		opp04 {
+			opp-hz = /bits/ 64 <2088000000>;
+			opp-level = <4>;
+		};
+		opp05 {
+			opp-hz = /bits/ 64 <2352000000>;
+			opp-level = <5>;
+		};
+		opp06 {
+			opp-hz = /bits/ 64 <2616000000>;
+			opp-level = <6>;
+		};
+		opp07 {
+			opp-hz = /bits/ 64 <2868000000>;
+			opp-level = <7>;
+		};
+		opp08 {
+			opp-hz = /bits/ 64 <3096000000>;
+			opp-level = <8>;
+		};
+		opp09 {
+			opp-hz = /bits/ 64 <3300000000>;
+			opp-level = <9>;
+		};
+		opp10 {
+			opp-hz = /bits/ 64 <3468000000>;
+			opp-level = <10>;
+		};
+		opp11 {
+			opp-hz = /bits/ 64 <3624000000>;
+			opp-level = <11>;
+		};
+		opp12 {
+			opp-hz = /bits/ 64 <3756000000>;
+			opp-level = <12>;
+		};
+		opp13 {
+			opp-hz = /bits/ 64 <3852000000>;
+			opp-level = <13>;
+		};
+		opp14 {
+			opp-hz = /bits/ 64 <3924000000>;
+			opp-level = <14>;
+		};
+		opp15 {
+			opp-hz = /bits/ 64 <3996000000>;
+			opp-level = <15>;
+		};
+		opp16 {
+			opp-hz = /bits/ 64 <4044000000>;
+			opp-level = <16>;
+		};
+		opp17 {
+			opp-hz = /bits/ 64 <4104000000>;
+			opp-level = <17>;
+		};
+		opp18 {
+			opp-hz = /bits/ 64 <4416000000>;
+			opp-level = <18>;
+		};
+		opp19 {
+			opp-hz = /bits/ 64 <4512000000>;
+			opp-level = <19>;
+		};
+	};
+};
+
+&cpu_e0 { operating-points-v2 = <&sawtooth_opp>; performance-domains = <&cpufreq_e>; };
+&cpu_e1 { operating-points-v2 = <&sawtooth_opp>; performance-domains = <&cpufreq_e>; };
+&cpu_e2 { operating-points-v2 = <&sawtooth_opp>; performance-domains = <&cpufreq_e>; };
+&cpu_e3 { operating-points-v2 = <&sawtooth_opp>; performance-domains = <&cpufreq_e>; };
+&cpu_p00 { operating-points-v2 = <&everest_opp>; performance-domains = <&cpufreq_p0>; };
+&cpu_p01 { operating-points-v2 = <&everest_opp>; performance-domains = <&cpufreq_p0>; };
+&cpu_p02 { operating-points-v2 = <&everest_opp>; performance-domains = <&cpufreq_p0>; };
+&cpu_p03 { operating-points-v2 = <&everest_opp>; performance-domains = <&cpufreq_p0>; };
+&cpu_p04 { operating-points-v2 = <&everest_opp>; performance-domains = <&cpufreq_p0>; };
+&cpu_p10 { operating-points-v2 = <&everest_opp2>; performance-domains = <&cpufreq_p1>; };
+&cpu_p11 { operating-points-v2 = <&everest_opp2>; performance-domains = <&cpufreq_p1>; };
+&cpu_p12 { operating-points-v2 = <&everest_opp2>; performance-domains = <&cpufreq_p1>; };
+&cpu_p13 { operating-points-v2 = <&everest_opp2>; performance-domains = <&cpufreq_p1>; };
+&cpu_p14 { operating-points-v2 = <&everest_opp2>; performance-domains = <&cpufreq_p1>; };
diff --git a/arch/arm64/boot/dts/apple/t6040-j614s-dcuart-wifi-cpufreq-sdroot.dts b/arch/arm64/boot/dts/apple/t6040-j614s-dcuart-wifi-cpufreq-sdroot.dts
new file mode 100644
index 000000000..2be804d99
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6040-j614s-dcuart-wifi-cpufreq-sdroot.dts
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * J614s one-core Alpine SD-root daily-driver DT.
+ *
+ * Keep the proven graphical/WiFi/BT/SD/cpufreq description, but leave ANS and
+ * the system-PMU SPMI bus disabled. The current ANS path asserts during
+ * ordinary partition scanning at the first I/O-CQ wrap. The project SPMI
+ * policy also excludes nub-spmi0/abbey PMU traffic, including the RTC and
+ * reboot nvmem cells. NVMe and macsmc-reboot experiments therefore use their
+ * own hash-pinned DTBs and tickets.
+ */
+
+#include "t6040-j614s-dcuart-wifi-cpufreq.dts"
+
+/ {
+	model = "Apple MacBook Pro (M4 Pro) J614s [Alpine SD root, NVMe and PMU SPMI disabled]";
+};
+
+&nub_spmi0 {
+	status = "disabled";
+};
+
+&smc_rtc {
+	status = "disabled";
+};
+
+&smc_reboot {
+	status = "disabled";
+};
+
+&ans_mbox {
+	status = "disabled";
+};
+
+&ans_sart {
+	status = "disabled";
+};
+
+&ans_nvme {
+	status = "disabled";
+};
+
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * J614s's PowerMethod=2 needs host AFE reset work between Will/Has.
+ * Its ADT function-afe-reset resolves to SMC key gp1c. Use Asahi's
+ * existing lowercase-gp GPIO provider, as on M3 Pro/Max, with pin 0x1c.
+ * Matched J514s/J614s ADTs use the same pKW4 base 0x10000 action.
+ * Follow J514s's ACTIVE_LOW binding: assert off=1, deassert on=0;
+ * the GPIO provider drives physical low/high respectively.
+ */
+&smc {
+	smc_gpio_low: gpio@67700000 {
+		compatible = "apple,smc-low-gpio";
+		gpio-controller;
+		#gpio-cells = <2>;
+	};
+};
+
+&mtp_hid {
+	multi-touch {
+		reset-gpios = <&smc_gpio_low 0x1c GPIO_ACTIVE_LOW>;
+	};
+};
+
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * J614s experimental driver testing, appended to the working SD-root board.
+ * The matching drivers are packaged as modules for explicit userspace trials.
+ * These are enabled hardware descriptions, not a claim of native stability.
+ *
+ * USB2/PD wiring derives from Wallace 55f116dd, usb2-native-right[-pd].
+ * Only the right USB-C port has a T6040 host PHY implementation in that stack.
+ * Its two DARTs probe at boot because the SD path needs APPLE_DART built in.
+ */
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/spmi/spmi.h>
+
+/ {
+	model = "Apple MacBook Pro (M4 Pro) J614s [Arch experimental drivers]";
+};
+
+&ans_mbox { status = "okay"; };
+&ans_sart { status = "okay"; };
+&ans_nvme { status = "okay"; };
+
+/* Power domains are required even with pd_ignore_unused: a cold controller
+ * may start powered off. Do not reproduce Wallace's early SPMI boot hangs. */
+&nub_spmi0 {
+	power-domains = <&ps_nub_spmi0>;
+	status = "okay";
+};
+&smc_rtc { status = "okay"; };
+&smc_reboot { status = "okay"; };
+
+/* Asahi common/laptop telemetry keys. Missing keys are skipped by hwmon.
+ * Omit fan target/mode properties so no manual fan controls are exposed. */
+&smc {
+	smc_hwmon: hwmon {
+		compatible = "apple,smc-hwmon";
+		power-PSTR { apple,key-id = "PSTR"; label = "Total System Power"; };
+		power-PDTR { apple,key-id = "PDTR"; label = "AC Input Power"; };
+		power-PHPC { apple,key-id = "PHPC"; label = "Heatpipe Power"; };
+		temperature-TH0x { apple,key-id = "TH0x"; label = "NAND Flash Temperature"; };
+		temperature-TB0T { apple,key-id = "TB0T"; label = "Battery Hotspot"; };
+		temperature-TCHP { apple,key-id = "TCHP"; label = "Charge Regulator Temp"; };
+		temperature-TW0P { apple,key-id = "TW0P"; label = "WiFi/BT Module Temp"; };
+		voltage-SBAV { apple,key-id = "SBAV"; label = "Battery Voltage"; };
+		voltage-VD0R { apple,key-id = "VD0R"; label = "AC Input Voltage"; };
+		current-ID0R { apple,key-id = "ID0R"; label = "AC Input Current"; };
+		fan-F0Ac { apple,key-id = "F0Ac"; label = "Fan 1"; };
+		fan-F1Ac { apple,key-id = "F1Ac"; label = "Fan 2"; };
+	};
+};
+
+&soc {
+	atcphy2_t6040_usb2: phy@392a90000 {
+		compatible = "apple,t6040-atcphy";
+		reg = <0x3 0x92a90000 0x0 0x4000>,
+		      <0x3 0x92800000 0x0 0x4000>;
+		reg-names = "bank0", "bank1";
+		#phy-cells = <1>;
+		power-domains = <&ps_atc2_usb>;
+		status = "okay";
+	};
+
+	/* CPU physical address, not the raw ADT 0x309198000 bus address. */
+	nub_spmi_a1: spmi@509198000 {
+		compatible = "apple,t6040-spmi", "apple,spmi";
+		reg = <0x5 0x09198000 0x0 0x4000>;
+		power-domains = <&ps_nub_spmi_a1>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+		status = "okay";
+
+		/* hpm2 / RID 2 / port-number 3: right port only. No role swaps. */
+		hpm2: usb-pd@c {
+			compatible = "usbc,sn201202x,spmi";
+			reg = <0xc SPMI_USID>;
+			typec_right: connector {
+				compatible = "usb-c-connector";
+				power-role = "source";
+				data-role = "host";
+			};
+		};
+	};
+};
+
+&usb2_dart0 { status = "okay"; };
+&usb2_dart1 { status = "okay"; };
+&usb_drd2 {
+	/delete-property/ apple,force-device-mode;
+	dr_mode = "host";
+	apple,force-host-mode;
+	phys = <&atcphy2_t6040_usb2 PHY_TYPE_USB2>;
+	phy-names = "usb2-phy";
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t6040.dtsi b/arch/arm64/boot/dts/apple/t6040.dtsi
new file mode 100644
index 000000000..badaea0d3
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6040.dtsi
@@ -0,0 +1,791 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Apple T6040 "M4 Pro" SoC
+ *
+ * The M4-generation Pro die: fills the gap between t8132 (M4) and t6050
+ * (M5 Pro/Max). M4-generation IP (apple,sawtooth E / apple,everest P cores,
+ * t8122-aic3) in a Pro-die multi-cluster layout (4E + 5P + 5P).
+ *
+ * All reg/irq values verified against the live j614s ADT (2026-07-10); see
+ * m1n1 .plans/2026-07-10-t6040-kboot-fdt-plan.md and dts/README.md.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+#include <dt-bindings/interrupt-controller/apple-aic.h>
+#include <dt-bindings/spmi/spmi.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	compatible = "apple,t6040", "apple,arm-platform";
+
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	cpus {
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		cpu-map {
+			cluster0 {
+				core0 {
+					cpu = <&cpu_e0>;
+				};
+				core1 {
+					cpu = <&cpu_e1>;
+				};
+				core2 {
+					cpu = <&cpu_e2>;
+				};
+				core3 {
+					cpu = <&cpu_e3>;
+				};
+			};
+
+			cluster1 {
+				core0 {
+					cpu = <&cpu_p00>;
+				};
+				core1 {
+					cpu = <&cpu_p01>;
+				};
+				core2 {
+					cpu = <&cpu_p02>;
+				};
+				core3 {
+					cpu = <&cpu_p03>;
+				};
+				core4 {
+					cpu = <&cpu_p04>;
+				};
+			};
+
+			cluster2 {
+				core0 {
+					cpu = <&cpu_p10>;
+				};
+				core1 {
+					cpu = <&cpu_p11>;
+				};
+				core2 {
+					cpu = <&cpu_p12>;
+				};
+				core3 {
+					cpu = <&cpu_p13>;
+				};
+				core4 {
+					cpu = <&cpu_p14>;
+				};
+			};
+		};
+
+		cpu_e0: cpu@0 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x0>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_0>;
+		};
+
+		cpu_e1: cpu@1 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x1>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_0>;
+		};
+
+		cpu_e2: cpu@2 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x2>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_0>;
+		};
+
+		cpu_e3: cpu@3 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x3>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_0>;
+		};
+
+		cpu_p00: cpu@10100 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10100>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_1>;
+		};
+
+		cpu_p01: cpu@10101 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10101>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_1>;
+		};
+
+		cpu_p02: cpu@10102 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10102>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_1>;
+		};
+
+		cpu_p03: cpu@10103 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10103>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_1>;
+		};
+
+		cpu_p04: cpu@10104 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10104>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_1>;
+		};
+
+		/*
+		 * t6040 is a chopped t6041 (M4 Max): the full P-cluster0 has 6 cores
+		 * (MPIDR 0x10100..0x10105) but the 6th is fused off here. m1n1 still
+		 * enumerates it as smp_id 9 (Apple's non-contiguous ADT numbering) and
+		 * expects a DT cpu node at that positional slot to prune — dt_set_cpus
+		 * uses a positional counter, so without this the P-cl1 nodes shift by one
+		 * and fail MPIDR matching. NOT in cpu-map (m1n1 nops the node but does not
+		 * clean cpu-map references), so it never reaches Linux.
+		 */
+		cpu_p05_disabled: cpu@10105 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10105>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_1>;
+			status = "disabled";
+		};
+
+		cpu_p10: cpu@10200 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10200>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_2>;
+		};
+
+		cpu_p11: cpu@10201 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10201>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_2>;
+		};
+
+		cpu_p12: cpu@10202 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10202>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_2>;
+		};
+
+		cpu_p13: cpu@10203 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10203>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_2>;
+		};
+
+		cpu_p14: cpu@10204 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10204>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_2>;
+		};
+
+		l2_cache_0: l2-cache-0 {
+			compatible = "cache";
+			cache-level = <2>;
+			cache-unified;
+			cache-size = <0x400000>;
+		};
+
+		l2_cache_1: l2-cache-1 {
+			compatible = "cache";
+			cache-level = <2>;
+			cache-unified;
+			cache-size = <0x1000000>;
+		};
+
+		l2_cache_2: l2-cache-2 {
+			compatible = "cache";
+			cache-level = <2>;
+			cache-unified;
+			cache-size = <0x1000000>;
+		};
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupt-parent = <&aic>;
+		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
+		interrupts = <AIC_FIQ AIC_TMR_GUEST_PHYS IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_FIQ AIC_TMR_GUEST_VIRT IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_FIQ AIC_TMR_HV_PHYS IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_FIQ AIC_TMR_HV_VIRT IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	clkref: clock-ref {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+		clock-output-names = "clkref";
+	};
+
+	soc: soc {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+
+		ranges;
+		nonposted-mmio;
+
+		/* pmgr nodes; child power-controllers added in t6040-pmgr.dtsi */
+		pmgr0: power-management@288e80000 {
+			compatible = "apple,t6041-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			reg = <0x2 0x88e80000 0 0x4000>;
+		};
+
+		pmgr1: power-management@502280000 {
+			compatible = "apple,t6041-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			reg = <0x5 0x02280000 0 0x14000>;
+		};
+
+		pmgr2: power-management@502800000 {
+			compatible = "apple,t6041-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			reg = <0x5 0x02800000 0 0xc000>;
+		};
+
+		pmgr3: power-management@508300000 {
+			compatible = "apple,t6041-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			reg = <0x5 0x08300000 0 0x4000>;
+		};
+
+		aic: interrupt-controller@502400000 {
+			compatible = "apple,t6040-aic3", "apple,t8122-aic3";
+			#interrupt-cells = <3>;
+			interrupt-controller;
+
+			/*
+			 * reg[0]: Main MMIO range
+			 * reg[1]: CPU Event/IACK register page (Base + aic-iack-offset 0x40000)
+			 */
+			reg = <0x5 0x02400000 0x0 0x1cc000>,
+			      <0x5 0x02440000 0x0 0x4000>;
+
+			config-offset = <0x10000>;
+			cap0-offset = <0x4>;
+			maxnumirq-offset = <0xc>;
+			power-domains = <&ps_aic>;
+		};
+
+		wdt: watchdog@50836c000 {
+			compatible = "apple,t6040-wdt", "apple,wdt";
+			reg = <0x5 0x0836c000 0x0 0x4000>;
+			clocks = <&clkref>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 827 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		/*
+		 * ANS2/NVMe layout from the live J614s ADT. T6040 uses the same
+		 * ASC, SARTv3 and 0x60000-byte NVMe/NVMMU layout as T8140, but at
+		 * Pro-die addresses. Keep the complete path disabled until its
+		 * first controlled probe.
+		 */
+		ans_mbox: mailbox@409608000 {
+			compatible = "apple,t8140-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x4 0x09608000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			/* ADT order is [1531 1530 1533 1532], not-empty first. */
+			interrupts = <AIC_IRQ 1530 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1531 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1532 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1533 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+					  "recv-empty", "recv-not-empty";
+			power-domains = <&ps_ans>;
+			#mbox-cells = <0>;
+			status = "disabled";
+		};
+
+		/*
+		 * SART + NVMe, TWO-BASE M4 layout (ticket 174, PROVEN via raw
+		 * m1n1 on 2026-07-30: EFI PART read from LBA 1). ADT reg[9]
+		 * (0x44dcc0000) is the NVMe controller aperture; reg[3]
+		 * (0x40dcc0000) is the NVMMU window. The previous node here
+		 * pointed "nvme" at reg[3] with the t8103 single-base layout —
+		 * that is the exact shape whose LINEAR_SQ_CTRL write raised
+		 * the 07-25 L2C SError. Shape mirrors yuka's t6041 node
+		 * (1b87d7b8, feature/m4-m5-nvme); every address and IRQ
+		 * re-verified against OUR J614s ADT (ans interrupts
+		 * [1531 1530 1533 1532 2583], identical to t6041; sart-ans
+		 * reg[0] size 0xc000). Driver: apple,t8132-nvme-ans2
+		 * (ad890806 cherry-picked) + the two 26.x gates (no
+		 * LINEAR_SQ/UNKNOWN_CTRL; no Set Features/Number-of-Queues —
+		 * the latter CRASHES ANS on fw 26.5 per yuka 9a6a6bd1).
+		 */
+		ans_sart: iommu@40dc50000 {
+			compatible = "apple,t6040-sart", "apple,t6000-sart";
+			reg = <0x4 0x0dc50000 0x0 0xc000>;
+			power-domains = <&ps_ans>;
+			status = "disabled";
+		};
+
+		ans_nvme: nvme@44dcc0000 {
+			compatible = "apple,t6040-nvme-ans2",
+				     "apple,t8132-nvme-ans2";
+			/*
+			 * NOTE (E8, 2026-07-30): the linear-SQ block answers at
+			 * reg[9]+0x249xx (measured: LINEAR_SQ_CTRL reads 1 there;
+			 * m1n1 rings +0x2490c/0x24910 and works) which is OUTSIDE
+			 * this declared 0x10000 window — widening it to 0x60000 so
+			 * Linux could ioremap it HUNG the machine outright. Left at
+			 * the ADT-declared size until that is understood.
+			 */
+			reg = <0x4 0x4dcc0000 0x0 0x10000>,
+			      <0x4 0x09600000 0x0 0x4000>,
+			      <0x4 0x0dcc0000 0x0 0x60000>;
+			reg-names = "nvme", "ans", "nvmmu";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 2583 IRQ_TYPE_LEVEL_HIGH>;
+			mboxes = <&ans_mbox>;
+			apple,sart = <&ans_sart>;
+			power-domains = <&ps_ans>, <&ps_apcie_sys_st0>,
+					<&ps_apcie_sys_st1>;
+			power-domain-names = "ans", "apcie0", "apcie1";
+			resets = <&ps_ans>;
+			status = "disabled";
+		};
+
+		/*
+		 * MTP carries the internal keyboard and trackpad over DockChannel.
+		 * All addresses and IRQs below are from the J614s ADT. Keep the
+		 * complete path disabled in the SoC description; the board-level
+		 * bring-up DT enables it as one deliberately gated unit.
+		 */
+		mtp_mbox: mailbox@514608000 {
+			compatible = "apple,t8140-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x5 0x14608000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			/*
+			 * The ADT lists these as [793 792 795 794]: Apple's ADT
+			 * convention is not-empty first in each pair. The
+			 * binding (and the actual lines, ascending) are
+			 * empty/not-empty — verified against every other ASC
+			 * node in the J614s ADT (all follow [n+1 n n+3 n+2]).
+			 */
+			interrupts = <AIC_IRQ 792 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 793 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 794 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 795 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+					  "recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			status = "disabled";
+		};
+
+		mtp_dart: iommu@514800000 {
+			compatible = "apple,t8110-dart";
+			reg = <0x5 0x14800000 0x0 0xc000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 775 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			status = "disabled";
+		};
+
+		mtp_dockchannel: mailbox@514b14000 {
+			compatible = "apple,t8122-dockchannel",
+				     "apple,t8112-dockchannel";
+			reg = <0x5 0x14b14000 0x0 0x1000>,
+			      <0x5 0x14b30000 0x0 0x1000>,
+			      <0x5 0x14b34000 0x0 0x1000>;
+			reg-names = "irq", "config", "data";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 776 IRQ_TYPE_LEVEL_HIGH>;
+			#mbox-cells = <0>;
+			status = "disabled";
+		};
+
+		mtp_hid: hid@514600000 {
+			compatible = "apple,t8122-dockchannel-hid";
+			reg = <0x5 0x14600000 0x0 0x4000>,
+			      <0x5 0x14c00000 0x0 0xac000>;
+			reg-names = "coproc-asc", "coproc-sram";
+			mboxes = <&mtp_mbox>, <&mtp_dockchannel>;
+			mbox-names = "asc", "dockchannel";
+			iommus = <&mtp_dart 0>;
+			status = "disabled";
+
+			mtp_keyboard: keyboard {
+			};
+		};
+
+		/*
+		 * SMC (System Management Controller): battery, charge state,
+		 * temperatures, RTC. RTKit coprocessor on an ASC mailbox.
+		 * Addresses from the live J614s ADT (j614s-full-20260728.adt):
+		 * ADT /arm-io/smc iop,ascwrap-v6 bus 0x30c600000 -> CPU-physical
+		 * 0x50c600000 (arm-io ranges +0x200000000). Mailbox IRQs
+		 * ADT [997 996 999 998] -> ascending [996 997 998 999] per the
+		 * Apple ASC convention (not-empty first in each pair) documented
+		 * on ans_mbox/mtp_mbox above.
+		 *
+		 * The "sram" region (reg[1]) is NOT in the ADT and the memory-map
+		 * was zeroed at capture. GROUND TRUTH from the failing probe
+		 * (2026-07-28): the SMC RTKit reported its shared-memory buffers at
+		 * 0x50de70000+ ("buffer request outside SRAM region: [0x50de70000,
+		 * 0x50de73fff]"), so the SRAM base is 0x50de70000 (the first buffer
+		 * sits at offset 0), NOT smc_base + 0x1a00000. An earlier
+		 * cross-SoC-pattern guess of 0x50e000000 was wrong and macsmc
+		 * failed with "Failed to initialize shared memory (-14)".
+		 */
+		smc_mbox: mailbox@50c608000 {
+			compatible = "apple,t8140-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x5 0x0c608000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 996 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 997 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 998 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 999 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+					  "recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			status = "disabled";
+		};
+
+		smc: smc@50c600000 {
+			compatible = "apple,t8140-smc", "apple,t8103-smc",
+				     "apple,smc";
+			/*
+			 * sram size 0x100000 is taken from t8103/t600x/t602x, where it
+			 * is ADT-verified; on T6040 the region is NOT in the ADT and
+			 * only the base (0x50de70000) is evidenced, from an observed
+			 * RTKit buffer request. TICKET 221 TESTED SHRINKING IT and the
+			 * hypothesis that an over-large window mis-maps SMC shmem onto
+			 * adjacent MMIO is REFUTED: the failing buffer offset simply
+			 * TRACKS whatever size we declare (16 KiB -> fails at 0x6000;
+			 * 32 KiB -> fails at 0x8000), because RTKit keeps requesting
+			 * further buffers as earlier ones succeed. So the real region is
+			 * larger than either, shrinking only makes SMC fail to boot
+			 * ("Failed to initialize shared memory (-14)"), and 1 MiB stays
+			 * the best available value. What ticket 221 DID establish is
+			 * that SMC being functional is what breaks high-core-count SMP.
+			 */
+			reg = <0x5 0x0c600000 0x0 0x4000>,
+			      <0x5 0x0de70000 0x0 0x100000>;
+			reg-names = "smc", "sram";
+			mboxes = <&smc_mbox>;
+			status = "disabled";
+
+			/*
+			 * SMC GPIOs. Needed for PCIe endpoint power: the WiFi/BT
+			 * module's WL_REG_ON and the SD reader's power enable are
+			 * SMC key writes, not AP GPIOs. The ADT proves it --
+			 * /amfm function-reg_on = pKW4('gP13', 0x800000) and
+			 * apcie0/pci-bridge1/pcie-sdreader function-sd_pwr_en =
+			 * pKW4('gP19', 0x0) -- and gpio-macsmc maps a line number
+			 * to key "gP%02x" by hex, so 'gP13' is line 0x13 = 19 and
+			 * 'gP19' is line 0x19 = 25. Shape copied from
+			 * t600x-die0.dtsi / t8103.dtsi.
+			 */
+			smc_gpio: gpio {
+				compatible = "apple,smc-gpio";
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			/*
+			 * Wall-clock time: SMC key CLKM is the running counter;
+			 * the boot-persistent offset lives in the abbey PMU's
+			 * RTC scratchpad, reached over SPMI (rtc_offset cell
+			 * below). Reading time is SMC+SPMI reads only; SETTING
+			 * the clock writes 6 bytes to that scratchpad — the
+			 * same "clock" write class as the permitted smc_rtc
+			 * nvram key.
+			 */
+			smc_rtc: rtc {
+				compatible = "apple,smc-rtc";
+				nvmem-cells = <&rtc_offset>;
