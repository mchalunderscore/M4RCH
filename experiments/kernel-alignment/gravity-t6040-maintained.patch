diff --git a/Documentation/devicetree/bindings/serial/apple,dockchannel-serial.yaml b/Documentation/devicetree/bindings/serial/apple,dockchannel-serial.yaml
new file mode 100644
index 000000000..a1c201361
--- /dev/null
+++ b/Documentation/devicetree/bindings/serial/apple,dockchannel-serial.yaml
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/serial/apple,dockchannel-serial.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple DockChannel Serial Transport
+
+maintainers:
+  - Michael Reeves <michael.reeves077@gmail.com>
+
+description:
+  Byte-stream serial transport carried over an Apple DockChannel FIFO mailbox.
+  This is used by debug and m1n1 proxy transports where the line speed and
+  modem control signals are not meaningful, but the endpoint behaves like a
+  raw serial byte stream.
+
+properties:
+  compatible:
+    const: apple,dockchannel-serial
+
+  mboxes:
+    maxItems: 1
+
+  mbox-names:
+    items:
+      - const: dockchannel
+
+required:
+  - compatible
+  - mboxes
+  - mbox-names
+
+additionalProperties: false
+
+examples:
+  - |
+    serial {
+        compatible = "apple,dockchannel-serial";
+        mboxes = <&dockchannel_uart>;
+        mbox-names = "dockchannel";
+    };
