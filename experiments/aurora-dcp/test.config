# Merge over the native-working Aurora config; resolve with olddefconfig.
CONFIG_DRM_APPLE=m
CONFIG_DRM_APPLE_DCP_T8132=y
CONFIG_DRM_APPLE_DCP_J614S=y
CONFIG_APPLE_J614S_DCP_BOOT=y
CONFIG_APPLE_DART_J713_DCP=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_APPLE_PMP_REPORT=y
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# MACAUDIO may select these as modules. Packaging removes both amplifier
# modules and regenerates depmod; the speaker DT nodes remain disabled.
# CONFIG_SND_SOC_TAS2764 is not set
# CONFIG_SND_SOC_TAS2770 is not set
