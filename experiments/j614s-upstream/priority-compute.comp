#version 450
layout(local_size_x = 64) in;
layout(push_constant) uniform Parameters { uint iterations; uint seed; } p;
layout(set = 0, binding = 0, std430) buffer Output { uint value[]; } outbuf;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint x = i ^ p.seed;
    for (uint j = 0; j < p.iterations; ++j)
        x = (x ^ (x >> 13)) * 1664525u + 1013904223u + j;
    outbuf.value[i] = x;
}
