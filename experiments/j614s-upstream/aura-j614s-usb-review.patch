+static const char *const j614s_phys[] = {"/phy@382a90000", "/phy@38aa90000", "/phy@392a90000"};
+static const char *const j614s_controllers[] = {"/usb@382280000", "/usb@38a280000",
+                                                "/usb@392280000"};
