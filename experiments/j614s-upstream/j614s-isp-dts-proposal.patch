--- a/arch/arm64/boot/dts/apple/t6040-j614s.dts
+++ b/arch/arm64/boot/dts/apple/t6040-j614s.dts
@@ -15,3 +15,27 @@
 	compatible = "apple,j614s", "apple,t6040", "apple,arm-platform";
 	model = "Apple MacBook Pro (14-inch, M4 Pro, Nov 2024)";
 };
+
+/* The loader reserves this boot's ISP firmware before enabling the camera. */
+&isp {
+	memory-region = <&isp_j614_text>, <&isp_j614_data>, <&isp_j614_heap>;
+	status = "disabled";
+};
+
+/delete-node/ &isp_fw_text;
+/delete-node/ &isp_fw_data;
+/delete-node/ &isp_heap;
+
+/ {
+	reserved-memory {
+		isp_j614_text: isp-firmware-text { };
+		isp_j614_data: isp-firmware-data { };
+		isp_j614_heap: isp-heap {
+			iommu-addresses = <&isp 0x100 0x0 0x0 0x2000000>;
+		};
+	};
+};
+
+&isp_dart0 { status = "disabled"; };
+&isp_dart1 { status = "disabled"; };
+&isp_dart2 { status = "disabled"; };
